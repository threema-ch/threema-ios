    "include_media_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модерно ZIP приложение за разархивиране с AES поддръжка е нужно, за да се разархивира този файл. Например: 7-Zip или The Unarchiver (Mac)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K rozbalení souboru je zapotřebí moderní komprimační nástroj ZIP s podporou AES, např. 7-Zip nebo The Unarchiver (Mac)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein modernes ZIP Tool mit AES Unterstützung wird benötigt, um die Datei zu öffnen, z.B. 7-Zip oder The Unarchiver (Mac)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modern ZIP tool with AES support is needed in order to unzip the file, e.g. 7-Zip or The Unarchiver (Mac)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para descomprimir el archivo se requiere una herramienta de compresión con sistema de cifrado AES, como por ejemplo 7-Zip o The Unarchiver (Mac)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un outil de ZIP récent avec compatibilité AES est nécessaire pour dézipper le fichier, par exemple 7-Zip ou The Unarchiver (Mac)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es moderns ZIP-Tool mit AES-Unterstützig wird benötigt, zum die Datei ufzmache, z.B 7-Zip (Windows) oder The Unarchiver (Mac)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la decompressione del file è necessario utilizzare uno strumento moderno di ZIP con supporto AES, ad esempio 7-Zip o The Unarchiver (Mac)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルを開くには、7-ZipやThe Unarchiver（Mac）など、AESをサポートする最新のZIP解凍ソフトが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일을 열려면 7-Zip 또는 The Unarchiver (Mac)와 같은 AES를 지원하는 최신 ZIP 압축 해제 소프트웨어가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een modern ZIP-programma met AES-ondersteuning is vereist om het bestand uit te pakken, bijv. 7-Zip of The Unarchiver (Mac)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do rozpakowania pliku potrzebne jest narzędzie ZIP z obsługą AES, np. 7-Zip lub The Unarchiver (Mac)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário uma ferramenta de compactação moderna com suporte a AES para descompactar o arquivo, como 7-Zip ou The Unarchiver (Mac)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы распаковать файл, нужно современное ZIP приложение с поддержкой AES, напр., 7-Zip или The Unarchiver (Mac)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre rozbalenie súboru je potrebný moderný ZIP nástroj s podporou AES, napr. 7-zip alebo The Unarchiver (Mac)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyayı açmak için AES destekli modern bir sıkıştırma yazılımı (ZIP) gereklidir, örn. 7-Zip veya The Unarchiver (Mac)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сучасний ZIP застосунок з підтримкою AES необхідний для розархівування файлу, як-от 7-Zip або The Unarchiver (Mac)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您需要具有 AES 支持的现代 ZIP 工具才能解压缩文件，例如 7-Zip 或 The Unarchiver (Mac)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您需要配備 AES 支援的現代 ZIP 工具才能解壓縮檔案，例如 7-Zip 或 The Unarchiver (Mac)。"
          }
        }
      }
    },
