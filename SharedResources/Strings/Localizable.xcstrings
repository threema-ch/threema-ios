    "webClientSession_add_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтеглете настолното приложение (%@) за Компютър/Мак или отворете уеб клиента (%@). После натиснете иконката с камера в горния десен ъгъл на екрана и сканирайте QR кода на компютъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhněte si na svém PC/Macu desktopovou aplikaci (%@) nebo otevřete webového klienta (%@). Poté klepněte v pravém horním rohu této obrazovky na ikonu fotoaparátu a naskenujte na počítači QR kód."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie auf Ihrem Mac/PC die Desktop-App herunter (%@), oder öffnen Sie den Web-Client (%@). Tippen Sie anschliessend auf das Kamera-Icon oben rechts auf diesem Bildschirm, und scannen Sie den QR-Code auf Ihrem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your PC/Mac, download the desktop app (%@) or open the web client (%@). Then, tap the camera icon in the upper right corner of this screen, and scan the QR code on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En su PC/Mac, descargue la aplicación de escritorio (%@) o abra el cliente web (%@). Después, toque el icono de la cámara situado en la esquina superior derecha de esta pantalla y escanee el código QR que aparece en la pantalla de su ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre PC/Mac, téléchargez l’application Desktop (%@) ou ouvrez le client Web (%@). Ensuite, touchez l’icône d’appareil photo en haut à droite de cette page et scannez le code QR affiché sur votre ordinateur."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladet Sie uf Ihrem Mac/PC d’Desktop-App abe (%@), oder mached Sie de Web-Client (%@) uf. Tipped Sie nachher uf s’Kamera-Icon obe rechts uf dem Bildschirm, und scanned Sie de QR-Code uf Ihrem Compi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul tuo PC/Mac, scarica l’app desktop (%@) o apri il client web (%@). Quindi tocca l’icona della fotocamera nell’angolo in alto a destra di questa schermata e scansiona il codice QR sul tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パソコン（PCまたはMac）でデスクトップアプリをダウンロード（%@）するか、ウェブクライアント（%@）を開きます。そしてこの画面の右上にあるカメラのアイコンをタップして、パソコンでQRコードを読み取ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC/Mac에서 데스크톱 앱 (%@)을 다운로드하거나 웹 클라이언트 (%@)를 열세요. 그런 다음 이 화면의 오른쪽 상단에 있는 카메라 아이콘을 탭하고 컴퓨터에서 QR 코드를 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download de desktop-app (%@) op uw pc/Mac of open de webclient (%@). Tik daarna op het camerapictogram rechtsboven in dit scherm en scan de QR-code op uw computer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz aplikację komputerową na swój komputer PC/Mac (%@) lub otwórz klienta sieciowego  (%@). Następnie dotknij ikony aparatu w prawym górnym roku tego ekranu i zeskanuj kod QR na swoim komputerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu PC/Mac, baixe o aplicativo para desktop (%@) ou abra o cliente web (%@). Depois, toque no ícone de câmera no canto superior direito desta tela e escaneie o código QR no seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На компьютере PC/Mac загрузите приложение для компьютера (%@) или откройте веб-клиент (%@). Затем коснитесь значка камеры в правом верхнем углу этого экрана и сканируйте QR-код на компьютере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vašom PC/Mac si najskôr stiahnite desktopovú aplikáciu (%@), alebo otvorte webového klienta (%@). Potom kliknite na ikonu kamery v pravom hornom rohu tejto obrazovky a zoskenujte QR kód z vášho počítača."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC / Mac'inizde masaüstü uygulamasını (%@) indirin veya web istemcisini (%@) açın. Ardından, bu ekranın sağ üst köşesindeki kamera simgesine dokunun ve kare kodunu bilgisayarınızda tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На своєму ПК/Mac завантажте настільний застосунок (%@) або відкрийте вебклієнт (%@). Потім торкніться значка камери у верхньому правому куті екрана та проскануйте QR-код на комп’ютері."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先，在您的 PC / Mac 上，下载桌面版应用程序 (%@) ，或打开网页版客户端 (%@)。然后，点击手机屏幕右上角的相机图标，扫描电脑上的二维码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先，在您的 PC / Mac 上，下載桌面版應用程式 (%@) ，或開啟網路用戶端 (%@)。然後點擊電話螢幕右上角的相機圖示，掃描電腦上的QR碼。"
          }
        }
      }
    },
    "webClientSession_add_wrong_qr_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това не е QR код за настолното приложение / уеб клиента. Изтеглете настолното приложение (%@) или отворете уеб клиента (%@) и сканирайте QR кода, който се показва."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto není QR kód pro desktopovou aplikaci / webového klienta. Stáhněte si desktopovou aplikaci (%@) nebo otevřete webového klienta (%@) a naskenujte QR kód, který je tam zobrazen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist kein QR-Code für die Desktop-App oder den Web-Client. Laden Sie die Desktop-App herunter (%@), oder öffnen Sie den Web-Client (%@), und scannen Sie den abgebildeten QR-Code."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a QR code for the desktop app / the web client. Download the desktop app (%@) or open the web client (%@), and scan the QR code displayed there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este no es un código QR de la aplicación de escritorio o cliente web. Descargue la aplicación de escritorio (%@) o abra el cliente web (%@) y escanee el código QR que aparece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci n’est pas un code QR pour l’application Desktop/le client Web. Téléchargez l’application Desktop (%@) ou ouvrez le client Web (%@) et scannez le code QR qui y est affiché."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das isch kein QR-Code für d’Desktop-App oder de Web-Client. Laded Sie d’Desktop-App abe (%@) oder öffned Sie de Web-Client (%@), und scanned Sie de abbildet QR-Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non è un codice QR per l’app desktop/il client web. Scarica l’app desktop (%@) o apri il client web (%@) e scansiona il codice QR visualizzato lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップアプリ／ウェブクライアントのQRコードではありません。デスクトップアプリをダウンロード（%@）するか、ウェブクライアント（%@） を開いて、そこに表示されているQRコードを読み取ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 QR 코드는 데스크톱 앱 또는 웹 클라이언트용이 아닙니다. 데스크톱 앱 (%@)을 다운로드하거나 웹 클라이언트 (%@)를 열고, 해당 장치에서 표시된 QR 코드를 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is geen QR-code voor de desktop-app/de webclient. Download de desktop-app (%@) of open de webclient (%@) en scan de QR-code die daar wordt weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie jest kod QR aplikacji komputerowej/klienta sieciowego. Pobierz aplikację komputerową (%@) lub otwórz klienta sieciowego (%@) i zeskanuj wyświetlony tam kod QR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse não é um código QR do aplicativo para desktop/cliente web. Baixe o aplicativo para desktop (%@) ou abra o cliente web (%@) e escaneie o código QR exibido lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не QR-код ПК/веб-клиента. Загрузите приложение для ПК (%@) или откройте веб-клиент (%@) и сканируйте изображенный здесь QR-код."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nie je QR kód pre desktopovú aplikáciu / webového klienta. Stiahnite si desktopovú aplikáciu (%@), alebo otvorte webového klienta (%@) a zoskenujte zobrazený QR kód."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, masaüstü uygulaması / web istemcisi için bir kare kodu değildir. Masaüstü uygulamasını (%@) indirin veya web istemcisini (%@) açın ve orada görüntülenen kare kodunu tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це не QR-код для настільного застосунку / вебклієнта. Завантажте настільний застосунок (%@) або відкрийте вебклієнт (%@) і зіскануйте показаний QR-код."
          }
        },
        "zh-Hans" : {
