            "value" : "Из-за ограничений %@ не может получить доступ к контактам вашего телефона. Вам необходимо добавить контакты вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dôsledku obmedzení nemá %@ prístup ku kontaktom vo vašom telefóne. Kontakty je potrebné pridať ručne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısıtlamalar nedeniyle, %@ telefonunuzun kişilerine erişemez. Kişileri elle eklemeniz gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через встановлені обмеження, %@ не має доступу до контактів телефону. Необхідно додавати контакти власноруч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于受限制，%@ 无法访问您的通讯录内的联系人，您需要手动添加联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於受限制，%@ 無法存取您的通訊錄內的聯絡人，您需要手動新增聯絡人。"
          }
        }
      }
    },
    "contact_list_contacts_unavailable_description_sync_disabled" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизацията на Вашите контакти е деактивирано. Моля, влезте в \"%@> %@\", за да я активирате или добавете контактите Ви ръчно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace vašich kontaktů je zakázána. Chcete-li ji povolit, přejděte prosím do „%@ > %@“, nebo přidejte kontakty ručně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisation Ihrer Kontakte ist deaktiviert. Navigieren Sie zu «%@ > %@», um sie zu aktivieren, oder fügen Sie Kontakte manuell hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncing your contacts is disabled. Please navigate to %@ > %@ to enable it, or add contacts manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de sus contactos está deshabilitada. Vaya a \"%@ > %@\" para habilitarla o añada los contactos manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation de vos contacts est désactivée. Aller dans « %@ > %@ » pour l’activer ou ajouter des contacts manuellement."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Synchronisation vo Ihrne Kontäkt isch deaktiviert. Navigiered Sie zu «%@ > %@», zum si aktiviere, oder tüend Sie Kontäkt manuell dezue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione dei tuoi contatti non è abilitata. Vai in “%@ > %@” per abilitarla, oppure aggiungi i contatti manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先の同期が無効になっています。「%@ > %@」に移動して同期を有効にするか、手動で連絡先を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처 동기화가 비활성화되어 있습니다. '%@ > %@'(으)로 이동하여 활성화하거나 수동으로 연락처를 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie van je contactpersonen is uitgeschakeld. Blader naar '%@ > %@' om deze functie in te schakelen of voeg handmatig contactpersonen toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączono synchronizowanie kontaktów. Przejdź do „%@” > „%@”, aby włączyć tę opcję, lub dodaj kontakty ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização dos seus contatos está desativada. Navegue até “%@ > %@” para ativá-la, ou adicione contatos manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация ваших контактов отключена. Пожалуйста, перейдите в «%@ > %@», чтобы включить её, или добавьте контакты вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia kontaktov je vypnutá. Prejdite na „%@ > %@“, aby ste ju zapli, alebo pridajte kontakty ručne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişilerinizi senkronize etme devre dışı bırakıldı. Lütfen etkinleştirmek için “%@ > %@” öğesine gidin veya kişileri elle ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію контактів вимкнено. Будь ласка, перейдіть до «%@ > %@» для увімкнення, або додавайте контакти власноруч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步联系人功能已禁用。请前往 “%@ > %@” 启用，或手动添加联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步聯絡人功能已停用。請前往「%@ >%@」啟用，或手動新增聯絡人。"
          }
        }
      }
    },
