        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только пользователи из вашего списка контактов могут отправить вам сообщение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správu vám môžu poslať iba ľudia z vášho zoznamu kontaktov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
