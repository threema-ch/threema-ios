    "edit_profile_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдонимът е включен в push-известията на изпратените Ви съобщения. Препоръчваме Ви да използвате само първото си име или псевдонима."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přezdívka se zobrazuje v nabízených oznámeních ke zprávám, které odešlete. Doporučujeme používat jen křestní jméno nebo pseudonym."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nickname wird in Push-Benachrichtungen von Ihnen eingesetzt. Wir empfehlen, nur Ihren Vornamen oder ein Pseudonym zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The nickname is included in push notifications for messages that you send. We recommend using only your first name or a pseudonym."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alias público lo insertará usted en las notificaciones push. Le recomendamos que utilice únicamente su nombre de pila o un seudónimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le surnom public est inclus dans les notifications Push des messages que vous envoyez. Nous vous recommandons d’utiliser seulement votre prénom ou un pseudonyme."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Nickname wird in Push-Benachrichtigunge vo Ihne iigsetzt. Mir empfehled, nur Ihre Vorname oder es Pseudonym z’bruuche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nickname pubblico viene usato per le notifiche push. Si consiglia di utilizzare solo il nome o uno pseudonimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ニックネームは、自分が送信したメッセージのプッシュ通知に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닉네임은 당신이 보낸 메시지의 푸시 알림에 포함됩니다. 당신의 이름만 사용하거나 필명을 사용하는 것을 권장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nickname wordt opgenomen in de pushberichten voor berichten die je verstuurd. We raden aan alleen je voornaam of een pseudoniem te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pseudonim jest zawarty w powiadomieniach push dla wysyłanych wiadomości. Zalecamy używanie tylko imienia lub pseudonimu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O apelido público está incluído nas notificações push para as mensagens que você envia. Recomendamos a utilização apenas do seu primeiro nome ou um pseudônimo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя указывается в push-уведомлениях об отправленных вами сообщениях. Мы рекомендуем использовать только имя и псевдоним."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezývka sa zobrazuje v push hláseniach správ, ktoré odošlete. Doporučujeme používať len krstné meno, alebo pseudonym."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takma isim, gönderdiğiniz mesajlar için anlık bildirimlere dahil edilir. Yalnızca isminizi veya takma isminizi kullanmanızı öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прізвисько додається до push-сповіщень повідомлень, які ви надсилаєте. Ми рекомендуємо використовувати лише своє ім’я чи псевдонім."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昵称会包含在您已发送的消息推送通知中。我们建议只使用您的名字或化名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暱稱會包括在您已傳送的訊息推播通知中。我們建議只使用您的名字或化名。"
          }
        }
      }
    },
