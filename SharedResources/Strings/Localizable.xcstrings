          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar la transmisión de todas las llamadas a través de los servidores de %@, protegiendo su dirección IP. Puede afectar a la calidad de la llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmettre tous les appels via vos serveurs %@ pour masquer votre adresse IP à vos partenaires d’appel. Cela peut affecter la qualité de l’appel."
