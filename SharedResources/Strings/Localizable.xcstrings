      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще бъде изпратен имейл на следния адрес:\n\n%@\n\nТова правилната електронна поща ли е?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail bude odeslán na následující adresu:\n\n%@\n\nJe to správná adresa?"
          }
        },
        "de" : {
          "stringUnit" : {
