    "profileimage_setting_all_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички контакти ще видят Вашата профилна снимка, когато им изпратите съобщение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny kontakty obdrží váš profilový obrázek, když jim odešlete zprávu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ihre Kontakte erhalten Ihr Profilbild, wenn Sie ihnen schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All contacts will receive your profile picture when you send them a message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los contactos recibirán su perfil cuando les envíe un mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les contacts reçoivent votre image de profil quand vous leur envoyez un message."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Ihri Kontäkt chömed Ihres Profilbild über, wenn Sie ihne schribed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i contatti riceveranno la tua immagine del profilo all’invio di un messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての連絡先に、あなたのプロフィール写真が送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 보낼 때 모든 연락처가 프로필 사진을 받게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle contactpersonen ontvangen je profielafbeelding als je hen een bericht zendt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie kontakty otrzymają Twoje zdjęcie profilowe po wysłaniu im wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os contatos receberão sua foto de perfil quando enviar uma mensagem a eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все контакты будут видеть ваш аватар, когда вы отправляете им сообщение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky kontakty príjmu váš profilový obrázok po to, ako im pošlete správu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm kişiler, onlara bir mesaj gönderdiğinizde profil resminizi alacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі контакти побачать зображення вашого профілю, коли ви надішлете їм повідомлення."
