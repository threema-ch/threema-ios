    "settings_notification_type_preview_complete_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва пълното име на контакта и профилната му снимка. Информацията, която засяга взаимодействията, се споделя с операционната система. [Научете повече…](%@)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje celé jméno kontaktu a profilový obrázek. Některé informace související s interakcí jsou sdíleny s operačním systémem. [Zjistěte více…](%@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Namen und das Profilbild des Kontakts an. Einige Informationen zu Interaktionen werden ans Betriebssystem weitergegeben. [Weitere Infos …](%@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays the contact’s full name and profile picture. Some information concerning interactions is shared with the operating system. [Learn more…](%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el nombre completo y la foto de perfil del contacto. Se comparte alguna información relacionada con las interacciones con el sistema operativo. [Más información...](%@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le nom complet et la photo de profil du contact. Certaines informations concernant les interactions sont partagées avec le système d'exploitation. [En savoir plus…](%@)"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt de Name und s’Profilbild vom Kontakt ah. Es paar Informatione zu Interaktione werded as Betribssystem wiitergeh. [Wiiteri Infos…](%@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il nome e l'immagine del profilo del contatto. Alcune informazioni sulle interazioni vengono trasmesse al sistema operativo. [Ulteriori informazioni…](%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先のフルネームとプロフィール画像を表示します。インタラクションに関する一部の情報は、オペレーティングシステムと共有されます。［詳細…］（%@）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처의 전체 이름과 프로필 사진을 표시합니다. 상호 작용에 관한 일부 정보는 운영 체제와 공유됩니다.[더 알아보기...](%@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de volledige naam en de profielfoto van de contactpersoon. Enkele gegevens over de interacties worden met het besturingssysteem gedeeld. [Meer informatie...](%@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla imię i nazwisko oraz zdjęcie profilowe kontaktu. Niektóre informacje dotyczące interakcji są udostępniane w systemie operacyjnym. [Dowiedz się więcej...](%@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe o nome completo e a foto de perfil do contato. Algumas informações relacionadas a interações são compartilhadas com o sistema operacional. [Saiba mais...](%@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображается полное имя и аватар контакта. Определенная информация, связанная с взаимодействием, передается в операционную систему. [Подробнее…](%@)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí celé meno a profilovú fotku kontaktu. Niektoré informácie týkajúce sa interakcií sa zdieľajú s operačným systémom. [Viac informácií…](%@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişinin tam adını ve profil resmini görüntüler. Etkileşimlerle ilgili bazı bilgiler işletim sistemiyle paylaşılır. [Daha fazla bilgi edinin…](%@)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується повне ім’я і зображення профілю контакта. Операційній системі надається певна інформація, що стосується взаємодії. [Докладніше…](%@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示联系人的全名和头像。分享互动的信息会与iOS系统分享。[了解更多...](%@)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示聯絡人的全名和大頭貼。分享互動的資訊會與iOS系統分享。 [了解更多...](%@)"
          }
        }
      }
    },
