    "forward_security_contact_has_downgraded_to_an_incompatible_version" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy е деактивиран за този разговор, защото Вашият чат партньор има версия на приложението, която не го поддържа или се използва Threema 2,0 за настолен компютър (бета)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce Perfect Forward Secrecy byla v této konverzaci zakázána, protože verze aplikace, kterou používá váš konverzační partner, ji nepodporuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy wurde in diesem Chat deaktiviert, weil die App-Version des Chat-Partners dies nicht unterstützt oder Threema 2.0 für Desktop (Beta) genutzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy has been disabled in this chat because your chat partner’s app version doesn’t support it or Threema 2.0 for desktop (beta) is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha deshabilitado Perfect Forward Secrecy en este chat porque la versión de la aplicación de chat de su interlocutor no lo admite o se está usando Threema 2.0 para escritorio (beta)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Confidentialité de transmission parfaite a été désactivée dans cette conversation, car la version de l'application de votre partenaire de discussion ne la prend pas en charge."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy isch i dem Chat deaktiviert, wil d’App-Version vom Chat-Partner das nöd unterstützt oder Threema 2.0 für Desktop (Beta) bruucht wird."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy è stato disabilitato in questa conversazione perché il tuo partner della chat possiede una versione non supportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット相手のアプリのバージョンが対応していないかThreema 2.0 for desktop(beta)が使用されているため、この会話ではPerfect Forward Secrecyが無効になっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화에서 Perfect Forward Secrecy 은 채팅 상대방의 앱 버전이 지원하지 않기 때문에 비활성화되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy is uitgeschakeld voor dit gesprek omdat de appversie van de gesprekspartner deze functie niet ondersteunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcja Perfect Forward Secrecy została wyłączona dla tej rozmowy, ponieważ wersja aplikacji rozmówcy nie obsługuje tej funkcji albo używana jest aplikacja Threema 2.0 na komputer (wersja beta)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sigilo de Encaminhamento Perfeito foi desativado nesta conversa porque a versão do aplicativo do seu parceiro de bate-papo não é compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой беседы протокол Perfect Forward Secrecy отключен, поскольку собеседник использует версию приложения, которая не поддерживает этот протокол."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcia Perfect Forward Secrecy bola v tejto konverzácii vypnutá, pretože verzia aplikácie vášho partnera ju nepodporuje alebo sa používa Threema 2.0 pre desktop (beta)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet ortağınızın uygulama sürümü desteklemediği için Mükemmel İletme Gizliliği bu görüşmede devre dışı bırakıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функцію «Цілковита пряма секретність» вимкнено для цієї розмови, оскільки версія застосунку вашого співрозмовника не підтримує її або використовується Threema 2.0 для комп'ютера (бета)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为对方使用的应用程序版本不支持 “完全正向保密” 功能，所以在此会话中已禁用 “完全正向保密” 。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為對方使用的應用程式版本不支援「完全正向保密」功能，所以在此對話中已停用「完全正向保密」。"
          }
        }
      }
    },
