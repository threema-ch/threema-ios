    "automatic_delete_confirmation_message_immediate_deletion" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d съобщения ще бъдат изтрити веднага и всички съобщение по-стари от %@ ще бъдат автоматично изтрити отсега нататък. Бележка: Отворените анкети и бележките няма да бъдат изтрити."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d zpráv bude okamžitě odstraněno a všechny zprávy starší než %@ budou od této chvíle automaticky odstraňovány. Poznámka: Otevřených anket a skupin pro poznámky se to netýká."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Nachrichten jeglichen Typs werden jetzt gelöscht und alle Nachrichten älter als %@ werden ab sofort automatisch gelöscht. Hinweis: Offene Umfragen und Notizgruppen sind davon nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d messages will be deleted immediately and all messages older than %@ will be automatically deleted from now on. Note: Open polls and note groups are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d mensajes se eliminarán inmediatamente y todos los mensajes que tengan más de %@ se eliminarán automáticamente a partir de ahora. Nota: Quedan excluidos los sondeos abiertos y los grupos de notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d messages seront supprimés immédiatement et tous les messages antérieurs à %@ seront automatiquement supprimés à partir de maintenant. Remarque : les sondages ouverts et les groupes de notes sont exclus."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Nachrichte aller Art werded jetzt glöscht, und all Nachrichte älter als %@ werded ab sofort automatisch glöscht. Hiiwis: Offeni Umfrage und Notizgruppe sind devo nöd betroffe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d messaggi verranno cancellati immediatamente e tutti i messaggi più vecchi di %@ verranno cancellati automaticamente da questo momento. Nota: i sondaggi aperti e i gruppi di note sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d件のメッセージが即座に消され、今から%@より古いメッセージは自動的に削除されます。注意: 開かれている投票とノートグループは除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d개의 메시지가 즉시 삭제되며, 앞으로 %@보다 오래된 모든 메시지는 자동으로 삭제됩니다. 참고: 열려 있는 투표와 노트 그룹은 제외됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d berichten worden onmiddellijk verwijderd en alle berichten ouder dan %@ worden vanaf nu automatisch verwijderd. Let op: open opiniepeilingen en notitiegroepen zijn uitgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d wiadomości zostanie usuniętych natychmiast, a od tej chwili wszystkie wiadomości starsze niż %@ będą automatycznie usuwane. Uwaga: nie dotyczy to otwartych ankiet i grup notatek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d mensagens serão excluídas imediatamente e todas as mensagens com mais de %@ serão excluídas a partir de agora. Obs.: Enquetes abertas e grupos de anotações não fazem parte da exclusão automática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d сообщ. будут удалены сразу, а все сообщения, возраст которых превышает %@, с этого момента будут автоматически удаляться. Примечание: открытые опросы и группы заметок исключаются из автоматического удаления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d správ bude okamžite vymazaných a všetky správy staršie ako %@ budú odteraz automaticky vymazané. Poznámka: Otvorené ankety a skupiny poznámok sú vylúčené."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d mesaj hemen silinecek ve %@'dan daha eski tüm mesajlar bundan sonra otomatik olarak silinecektir. Not: Açık anketler ve not grupları hariç tutulmuştur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення з %d буде негайно видалено, а всі повідомлення, старші за %@, відтепер видалятимуться автоматично. Примітка: відкриті опитування та групи дописів не враховуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d条消息将被立即删除，所有早于%@的消息将从现在开始会自动删除。注意：公开投票和私人收藏在备忘录 “一人群组” 内的消息不会被自动删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d則訊息將立即刪除，所有早於%@的訊息將從現在開始會自動刪除。注意：公開投票和私人收藏在備忘錄「一人群組」內的訊息不會自動刪除。"
          }
        }
      }
    },
