    "poi_dropped_pin_info_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да сложите кабърче, натиснете и задръжте върху картата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li umístit špendlík, podržte stisknuté místo na mapě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen und halten Sie auf der Karte um eine Stecknadel zu platzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To drop a pin, press and hold on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para posicionar un pin, mantén pulsado el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour placer une épingle, appuyez et maintenez enfoncé sur la carte."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipped und hebed Sie uf de Charte, zum e Stecknadle z’platziere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuta la posizione sulla mappa per posizionare lo spillo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンを置くには、地図を長押ししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맵 위에서 핀을 놓으려면 누르고 놓기를 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk lang op de kaart om een markering te plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wbić szpilkę, naciśnij i przytrzymaj punkt na mapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para fixar um alfinete, pressione e segure no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы поставить шпильку, зажмите место на карте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete umiestniť špendlík, stlačte a podržte na mape."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir iğne bırakmak için harita üzerinde basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб поставити мітку торкніться та утримуйте палець на карті."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要放置图钉，请在地图上长按。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要放置圖釘，請在地圖上長按。"
