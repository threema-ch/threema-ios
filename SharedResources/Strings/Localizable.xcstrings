    "group_clone_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това действие ще създаде копие на групата с Вас като администратор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto vytvoříte klon dané skupiny a budete jejím správcem. Chcete pokračovat?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird eine Kopie der aktuellen Gruppe mit Ihnen als Administrator erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will create a clone of this group with you as the administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se creará un clon del grupo contigo como admiistrador. ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela créera un clone de ce groupe avec vous comme administrateur. Continuer?"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird e Kopie vode aktuelle Gruppe mit Ihne als Administrator erstellt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà creato un gruppo clone che ti vedrà come amministratore. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたを管理者とするこのグループのクローンが作成されます。続けますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 당신을 관리자로 하는 이 그룹의 복제본을 생성합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kloont deze groep met u als administrator. Doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to utworzenie klonu grupy z Tobą jako administrator. Kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá criar um clone deste grupo com você como administrador. Continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет создан клон группы с вами, в качестве администратора. Продолжить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto vytvoríte kópiu tejto skupiny s vami ako administrátorom."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, yönetici olarak sizinle birlikte bu grubun bir kopyasını oluşturacaktır. "
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це клонує цю групу з вами в ролі адміністратора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将创建一个由您作为管理员的群组克隆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將建立這個群組的克隆，並由您作為管理員。"
          }
        }
      }
    },
