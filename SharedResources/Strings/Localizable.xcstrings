    "this_device_decision_info" : {
      "comment" : "Subtitle text in the \"This device only\" decision view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При преминаването към нов iPhone, Вие може да прехвърлите Вашите Threema данни директно на новото iOS устройство чрез Quick Start."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přechodu na nový iPhone můžete svá data aplikace Threema převést přímo na nové zařízení s iOS pomocí funkce Rychlý start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel auf ein neues iPhone können die Threema-Daten via «Schnellstart» direkt auf das neue iOS-Gerät übertragen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When switching to a new iPhone, you can transfer your Threema data directly to the new iOS device using Quick Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar a un nuevo iPhone, puede transferir sus datos de Threema directamente al nuevo dispositivo iOS usando Quick Start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du passage à un nouvel iPhone, vous pouvez transférer directement vos données Threema vers le nouvel appareil iOS à l'aide du Démarrage rapide."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bim Wächsel uf es neus iPhone chönd d’Threema-Date via «Schnellstart» direkt ufs neue iOS-Grät übertreit werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando passi a un nuovo iPhone, puoi trasferire i tuoi dati Threema direttamente sul nuovo dispositivo iOS utilizzando Avvio rapido."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri prechode na nový iPhone môžete svoje údaje z aplikácie Threema preniesť priamo do nového zariadenia s iOS pomocou funkcie Rýchly štart."
          }
        },
        "tr" : {
          "stringUnit" : {
