    "doNotDisturb_notification_sound_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звукът от известието ще се възпроизведе само ако „Възпроизвеждането на звук за известие“ е активно, а „моля, не безпокойте“ е деактивирано."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk oznámení se přehraje pouze v případě, je-li povolena funkce „Přehrát zvuk oznámení“ a je deaktivována funkce „Nerušit“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Benachrichtigungston wird nur abgespielt, wenn «Ton abspielen» aktiviert und «Nicht stören» deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The notification sound is only played if Play Notification Sound is enabled and Do Not Disturb is deactivated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sonido de notificación solo se reproduce si Reproducir sonido de notificación está habilitado y No molestar está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le son de notification est uniquement joué si le paramètre «  Jouer un son de notification  » est activé et le paramètre «  Ne pas déranger  » est désactivé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Benachrichtigungston wird nur abgspilt, wenn «Ton abspile» aktiviert und «Nöd störe» deaktiviert isch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suono di notifica viene riprodotto solo se \"Riproduci suono\" è attivato e \"Non disturbare\" è disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知音は、\"通知音を鳴らす\"が有効で\"通知オフ\"が無効の場合のみ鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림 소리는 \"알림 소리 재생\"이 활성화되어 있고 \"방해 금지\"가 비활성화된 경우에만 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het meldingsgeluid wordt alleen afgespeeld wanneer \"Meldingsgeluid afspelen\" is ingeschakeld en \"Niet storen\" is uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk powiadomienia jest odtwarzany tylko wtedy, gdy opcja Odtwórz dźwięk powiadomienia jest włączona, a opcja Nie przeszkadzać jest wyłączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O som de notificação só tocará se ”Tocar som de notificação” estiver ativado e ”Não perturbe\" estiver desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук уведомления воспроизводится только тогда, когда параметр «Воспроизводить звук уведомления» включен, а «Не беспокоить» отключен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk upozornenia sa prehrá, iba ak je zapnuté nastavenie Prehrať zvuk upozornenia a nastavenie Nerušiť je deaktivované."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim sesi yalnızca ”Bildirim Sesi Çal” etkinleştirildiğinde ve “Rahatsız Etmeyin” devre dışı bırakıldığında çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук сповіщення вмикається лише тоді, коли ввімкнено опцію «Програти звук сповіщення», а опцію «Не турбувати» вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当 “播放通知声音” 已启用，并且 “请勿打扰” 已禁用时，才会播放通知声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當「播放通知音效」已啟用，並且「請勿打擾」已停用時，才會播放通知音效。"
          }
        }
      }
