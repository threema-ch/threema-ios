    "settings_advanced_contacts_cleanup_still_used_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почистването е недовършено (%i дублиращи се са премахнати, %i остават).\n\nНякои индивидуални чата трябва да бъдат изтрити ръчно.\n\n%@\n\nМоля, изтрийте чатовете и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promazání nebylo dokončeno (odebrané duplicity: %i, zbývá: %i).\n\nNěkteré osobní konverzace je zapotřebí odstranit ručně:\n\n%@\n\nOdstraňte prosím tyto konverzace a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang konnte nicht abgeschlossen werden (%i Duplikate entfernt, %i übrig).\n\nEinige Einzelchats müssen von Hand gelöscht werden:\n\n%@\n\nBitte löschen Sie diese und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up incomplete (%i duplicates removed, %i remaining).\n\nSome one-to-one chats must be deleted manually:\n\n%@\n\nPlease delete the chats and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpieza incompleta (%i duplicados eliminados, %i restantes).\n\nAlgunos chats uno-a-uno tienen que eliminarse manualmente:\n\n%@\n\nElimine los chats e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoyage inachevé (%i doublons supprimés, il en reste %i)\n\nCertaines discussions en tête à tête doivent être supprimées manuellement :\n\n%@\n\nVeuillez supprimer les discussions et réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Vorgang hät nöd chöne abschlosse werde (%i Duplikat entfernt, %i übrig).\n\nEs paar Einzelchats müend vo Hand glöscht werde:\n\n%@\n\nBitte lösched Sie die und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'operazione non è stata completata (%i duplicati cancellati, restano ancora %i).\n\nAlcune chat singole devono essere cancellate manualmente:\n\n%@\n\nCancellale e riprova.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整理が不完全です（重複する%i件を削除済み、残りの%i件）。\n\n一対一のいくつかのチャットは手動で削除する必要があります。\n\n%@\n\nチャットを削除して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미완료된 %i개의 중복이 정리되었습니다. %i개가 남았습니다.\n\n일대일 채팅 중 일부를 수동으로 삭제해야 합니다:\n\n%@\n\n채팅을 삭제하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het opschonen is onvolledig. (%i duplicaten zijn verwijderd, %i overgebleven).\n\nSommige één-op-één chats moeten handmatig worden verwijderd:\n\n%@\n\nVerwijder de chats en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wykonano pełnego czyszczenia. (usunięto %i duplikaty(ów), pozostało %i).\n\nNiektóre czaty indywidualne muszą zostać usunięte ręcznie:\n\n%@\n\nUsuń czaty i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpeza incompleta (%i duplicados removidos, %i restantes).\n\nAlgumas conversas precisam ser excluídas manualmente:\n\n%@\n\nExclua as conversas e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистка не завершена (%i дубликатов удалено, %i осталось).\n\nНекоторые личные чаты следует удалить вручную:\n\n%@\n\nУдалите эти чаты и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neúplné vyčistenie (%i duplikátov odstránených, %i zostáva).\n\n\nNiektoré konverzácie jeden na jedného sa musia odstrániť ručne:\n\n\n%@\n\n\nOdstráňte prosím tieto konverzácie a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temizleme tamamlanmadı (%i kopya kaldırıldı, %i kaldı).\n\nBazı bire bir sohbetler elle silinmelidir:\n\n%@\n\nLütfen sohbetleri silin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищення скасовано (%i дублікатів видалено, %i дублікатів залишилось).\nПевні діалоги мають бути видалені вручну:\n\n%@\n\nВидаліть бесіди та спробуйте знов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成清理重复的联系人（已删除 %i 个重复项，剩余 %i 个）。\n\n部份一对一聊天记录必须手动删除：\n\n%@\n\n请先删除聊天记录，之后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成清理重複的聯絡人（已刪除 %i 個重複項，剩餘 %i 個）。\n\n部份一對一對話記錄必須手動刪除：\n\n%@\n\n請先刪除聊天記錄，然後再試一次。"
          }
        }
      }
    },
    "settings_advanced_contacts_cleanup_submit_logs" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, върнете се назад към „Разширени настройки“ и споделете журнала с %@ поддръжката за последващ анализ.\n\nСлед това, Вие можете да изключите „Дебъг лога/журнала“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraťte se do nabídky „Pokročilá nastavení“ a poskytněte záznam podpoře %@ pro další analýzu.\n\nPoté můžete položku „Záznam ladění“ vypnout."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gehen Sie zurück zu «Erweitert», und teilen Sie das Debug Log mit dem %@ Support für weitere Analysen.\n\nDanach können Sie das «Debug Log» wieder deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please go back to Advanced Settings,”and share the log with %@ Support for further analysis.\n\nAfter that, you may turn off Debug Log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelva a Ajustes avanzados y comparta el registro con el equipo de asistencia de %@ para un análisis más detallado.\n\nA continuación, desactive Registro de depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez revenir aux « Paramètres avancés » et partager le journal avec l'assistance de %@ pour une analyse plus poussée.\n\nAprès cela, vous pouvez désactiver le « Journal de débogage »."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gönd Sie zrugg zu «Erwiiteret», und teiled Sie s’Debug-Log mitem %@-Support für wiiteri Analyse.\n\nNachher chönd Sie s’Debug-Log wieder deaktiviere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna alle Impostazioni avanzate e condividi il registro con l'assistenza %@ per ulteriori analisi.\n\nDopo, puoi disattivare il registro di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「詳細設定」に戻って、ログを%@サポートに共有してさらなる分析を行ってください。\n\nその後、「デバッグログ」を無効にすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"고급 설정\"으로 돌아가 로그를 %@ 지원팀과 공유하여 추가 분석을 받으십시오.\n\n그 후에 \"디버그 로그\"를 끄셔도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga terug naar 'Geavanceerde instellingen' en deel het log met %@ support voor nadere analyse.\n\nDaarna kun je 'Debug log' uitzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć do opcji Ustawienia zaawansowane i udostępnij dziennik pomocy technicznej %@ do dalszej analizy.\n\nPotem możesz wyłączyć funkcję Dziennik debugowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá até \"Configurações avançadas\" e compartilhe o log com o suporte do %@ para uma análise mais detalhada.\n\nDepois, você pode desativar a opção \"Log de depuração\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь в \"Расширенные настройки\" и передайте журнал службе поддержки %@ для дальнейшего анализа.\n\nПосле этого вы можете отключить \"Журнал отладки\"."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vráťte sa späť do \"Rozšírených nastavení\" a zdieľajte protokol s podporou spoločnosti %@ na ďalšiu analýzu.\n\nPotom môžete funkciu \"Debug Log\" vypnúť."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen \"Gelişmiş Ayarlar \"a geri dönün ve daha fazla analiz için günlüğü %@ Destek ile paylaşın.\n\nBundan sonra, \"Hata Ayıklama Günlüğü\"nü kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поверніться до розділу \"Додаткові налаштування\" та надішліть журнал до служби підтримки %@ для подальшого аналізу.\n\nПісля цього можна вимкнути \"Журнал налагодження\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请返回 “高级设置”，并将调试日志分享到 %@ 支持，以进行进一步分析。\n\n之后，您可以关闭 “调试日志”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請返回「進階設定」，並將偵錯記錄分享至 %@ 支援，以進行進一步分析。\n\n之後，您可以關閉「偵錯記錄」。"
          }
        }
      }
    },
