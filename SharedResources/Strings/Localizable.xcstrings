    "work_referral_share_text" : {
      "comment" : "Text that can be shared to invite someone to join the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравейте, мисля, че това може да Ви бъде полезно: Threema Work е идеална опция за сигурна бизнес комуникация. Това е Вашият тестови линк:"
