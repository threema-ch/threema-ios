    "rs_view_deactivate_box_text" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият администратор е деактивирал функцията DualLock. За да я деактивирате, нулирайте и преинсталирайте приложението.\nПреди нулирането, ние Ви препоръчваме да създадете Threema Safe резервно копие."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš administrátor zakázal DualLock. Chcete-li jej deaktivovat, resetujte a přeinstalujte prosím aplikaci.\n\nPřed resetováním aplikace doporučujeme vytvořit zálohu Threema Safe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Administrator hat DualLock deaktiviert. Um die Deaktivierung abzuschliessen, setzen Sie bitte die App zurück und installieren Sie sie neu.\n\nVor dem Zurücksetzen empfehlen wir Ihnen, ein Threema Safe-Backup zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your administrator has disabled DualLock. To deactivate it, please reset and reinstall the app.\n\nBefore resetting, we recommend creating a Threema Safe backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su administrador ha deshabilitado DualLock. Para desactivarla, restablezca la aplicación y luego instálela de nuevo.\n\nAntes de restablecerla, le recomendamos crear una copia de seguridad de Threema Safe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre administrateur a désactivé DualLock. Pour le réactiver, réinitialisez et réinstallez l'application.\n\nAvant de la réinitialiser, nous vous recommandons de créer une sauvegarde Threema Safe."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Administrator hät DualLock deaktiviert. Zum d’Deaktivierig abzüschlüsse, setzed Sie bitte d’App zrugg und installiered Sie sie neu.\n\nVorem Zruggsetze empfehled mir Ihne, es Threema Safe-Backup z’erstelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo amministratore ha disabilitato DualLock. Per disattivarlo, ripristina e reinstalla l'app.\n\nPrima di ripristinare, ti consigliamo di creare un backup Threema Safe."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자가 DualLock을 활성화했습니다. 비활성화하려면 앱을 재설정한 후 다시 설치하세요.\n\n재설정하기 전에 Threema Safe를 백업하실 것을 권장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw beheerder heeft DualLock uitgeschakeld. Reset en herinstalleer de app om het te deactiveren.\n\nWe raden aan om voor het resetten een Threema Safe-back-up uit te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator wyłączył funkcję DualLock. Aby ją dezaktywować, zresetuj i ponownie zainstaluj aplikację.\n\nPrzed zresetowaniem aplikacji zalecamy utworzenie kopii zapasowej Threema Safe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu administrador desativou o DualLock. Para desativá-lo, reinicie e reinstale o app.\n\nAntes de reiniciar, recomendamos criar uma cópia de segurança do Threema Safe."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš správca deaktivoval funkciu DualLock. Ak ju chcete deaktivovať, vyresetujte a znovu nainštalujte aplikáciu.\n\nPred resetovaním odporúčame vytvoriť zálohu Trezoru Threema."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöneticiniz DualLock'u devre dışı bıraktı. Devre dışı bırakmak için lütfen uygulamayı sıfırlayın ve yeniden yükleyin.\n\nSıfırlamadan önce, Threema Safe yedeklemesi oluşturmanızı öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш адміністратор вимкнув DualLock. Для вимкнення скиньте та встановіть застосунок наново.\n\nПеред скиданням ми рекомендуємо створити резервну копію у Threema Safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的管理员已禁用 DualLock 功能。如要禁用此功能，请先重置并重新安装本应用。\n\n在重置前，我们建议您先创建 Threema Safe 备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的管理員已停用 DualLock 功能。如要停動此功能，請先重設並重新安裝本應用程式。\n\n在重設前，我們建議您先建立 Threema Safe 備份。"
          }
        }
      }
    },
