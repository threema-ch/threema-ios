        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도해보세요. 다른 이미지로 시도해보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het opnieuw. Probeer eventueel een andere afbeelding."
