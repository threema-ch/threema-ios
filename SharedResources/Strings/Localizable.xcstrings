    "sentry_crash_send_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вие можете да изпратите анонимен доклад. Детайлите за взаимодействията, които сте направили преди да се случи проблема, ще ни помогнат да адресираме по-добре проблема."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete podat anonymní hlášení. Podrobnosti o interakcích, které proběhly předtím, než problém nastal, nám pomohou vyřešit základní problém."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können einen anonymen Bericht einreichen. Details zu Interaktionen, welche vor dem Problem stattgefunden haben, helfen uns, das zugrundeliegende Problem zu identifizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can submit an anonymous report. Details about interactions that took place before the problem occurred will help us to address the underlying problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes enviar un informe anónimo. Los detalles de las interacciones que se produjeron antes de que surgiera el problema nos ayudarán a identificar el problema subyacente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez soumettre un rapport anonyme. Les détails relatifs aux interactions ayant eu lieu avant la survenue du problème nous aideront à corriger le problème sous-jacent."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie chönd en anonyme Bricht iireiche. Details zu Interaktione, wo vorem Problem stattgfunde händ, hälfed üs, s’Problem drunder z’identifiziere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi inviare un rapporto di arresto in modo totalmente anonimo. Fornendo dettagli sulla dinamica dell’arresto puoi aiutare a individuare il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名でクラッシュレポートを提出することができます。原因を詳しく説明することで、根本的な問題を解決することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명으로 신고할 수 있습니다. 문제가 발생하기 전에 발생한 상호 작용에 대한 세부 정보는 근본적인 문제를 해결하는 데 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt een anoniem crashrapport verzenden. Voeg informatie toe over de interacties die vóór het probleem plaatsvonden om de onderliggende kwestie op te lossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przesłać anonimowe zgłoszenie. Szczegółowe informacje na temat interakcji, które miały miejsce przed wystąpieniem problemu, pomogą nam rozwiązać podstawowy problem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode enviar um relatório anônimo. Detalhes das interações que ocorreram antes do problema nos ajudarão a identificar a sua causa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете отправить анонимный отчет. Данные о взаимодействиях, имевших место перед тем, как возник сбой, помогут устранить проблему, которая стала его причиной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môžete odoslať anonymné hlásenie. Podrobnosti o interakciách, ktoré sa uskutočnili pred výskytom problému, nám pomôžu riešiť základný problém."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonim bir rapor gönderebilirsiniz. Sorun ortaya çıkmadan önce gerçekleşen etkileşimlerle ilgili ayrıntılar, altta yatan sorunu ele almamıza yardımcı olacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете надіслати анонімний звіт. Деталі щодо взаємодій перед виникненням помилки допоможуть розв'язати проблему, що призвела до цього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以提交匿名报告。请仔细描述崩溃问题发生前的详情，将有助我们的支持团队解决根本问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以提交匿名報告。請仔細描述崩潰問題發生前的詳情，將有助我們的支援團隊解決根本問題。"
          }
        }
      }
    },
