    "group_leave_sheet_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако просто напуснете групата, Вие няма повече да участвате в разговора, но все още ще можете да виждате историята на чата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud skupinu pouze opustíte, nemůžete se již konverzace účastnit, ale stále budete mít přístup k historii konverzace a můžete si ji prohlížet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Gruppe nur verlassen, können Sie nicht mehr an der Konversation teilnehmen. Der bisherige Nachrichtenverlauf bleibt jedoch erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you just leave, you can no longer participate in the conversation, but you can still access and see the chat history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si abandona el grupo, no podrá seguir participando en la conversación, pero podrá seguir viendo el historial de chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez le groupe, vous ne pourrez plus participer à la conversation, mais vous pourrez quand même accéder à l’historique de discussion."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie d’Gruppe nur verlönd, chönd Sie nüme ade Konversation teilneh. De bisherig Nachrichteverlauf bliibt aber erhalte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abbandoni il gruppo, non potrai più partecipare alla conversazione, ma potrai comunque accedere e consultare la cronologia della chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出しただけの場合、会話に参加できなくなりますが、トーク履歴にアクセスして閲覧することはできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나가기만 하면 더 이상 대화에 참여할 수 없지만 채팅 기록에는 여전히 접근하고 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u het gesprek verlaat, kunt u niet meer deelnemen. U hebt nog wel toegang tot de chatgeschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli tylko ją opuścisz, nie możesz już brać udziału w konwersacji, ale ciągle masz dostęp do historii czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se apenas sair, você não poderá mais participar da conversa, mas ainda poderá acessar e ver o histórico do bate-papo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если просто выйти, вы больше не сможете принимать участие в обсуждении, но у вас при этом будет доступ к истории чата для ее просмотра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak práve odídete, už sa nemôžete zúčastniť konverzácie, ale stále môžete pristupovať a zobraziť históriu rozhovorov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrılırsanız, artık sohbete katılamazsınız, ancak yine de sohbet geçmişine erişebilir ve sohbet geçmişini görebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви просто вийдете, то не зможете брати участь у подальшій розмові, проте матимете доступ до історії діалогу й зможете переглядати його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您只是离开群组，您将无法再参与会话，但您仍然可以查看以前的聊天记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您只是離開群組，您將無法再參與對話，但您仍然可以檢視歷史對話記錄。"
          }
        }
      }
    },
