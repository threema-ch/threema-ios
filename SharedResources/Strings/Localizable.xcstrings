    "work_referral_view_section_info_confirmation_text" : {
      "comment" : "Text under the title \"Confirmation\" in the \"How it works\" section of the \"Work referral\" view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да гарантираме, че Вашата препоръка е правилно асоциирана и потвърдена, ние ще се свържем с Вас преди да направим плащането. Ще Ви информираме веднага щом приключим проверката."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abychom zajistili správné přiřazení a ověření vašeho doporučení, budeme vás před provedením platby kontaktovat. Jakmile bude proces ověření dokončen, budeme vás informovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Ihre Empfehlung korrekt zugeordnet und überprüft werden kann, nehmen wir vor der Auszahlung Kontakt mit Ihnen auf. Sobald die Prüfung abgeschlossen ist, informieren wir Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure that your referral can be correctly assigned and verified, we will contact you before making the payment. We will inform you as soon as the verification process is complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantizar que su recomendación se asigne y verifique correctamente, nos pondremos en contacto con usted antes de realizar el pago. Le informaremos en cuanto se complete el proceso de verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afin de nous assurer que votre parrainage sera correctement attribué et vérifié, nous vous contacterons avant d’effectuer le paiement. Nous vous informerons dès que le processus de vérification sera terminé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Ihri Empfehlig cha richtig zuegordnet und überprüeft werde, mäldet mir üs vor de Uszahlig bi Ihne. Sobald d’Prüefig abgschlosse isch, tüend mir Sie informiere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per garantire che il soggetto presentato possa essere correttamente assegnato e verificato, ti contatteremo prima di effettuare il pagamento. Ti informeremo non appena il processo di verifica sarà completato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천이 정확하게 지정되고 확인될 수 있도록, 지급 전에 연락드릴 예정입니다. 검증 절차가 완료되는 즉시 안내해 드리겠습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om ervoor te zorgen dat uw doorverwijzing op de juiste manier kan worden toegewezen en gecontroleerd, nemen we voor het uitvoeren van de betaling contact met u op. We informeren u zodra het controleproces voltooid is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zadbać o prawidłowe przypisanie i zweryfikowanie skierowanego do nas podmiotu, skontaktujemy się z Tobą przed dokonaniem płatności. Jak tylko zakończy się proces weryfikacji, poinformujemy Cię o tym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantir que sua indicação seja corretamente atribuída e verificada, entraremos em contato com você antes da realização do pagamento. Informaremos assim que o processo de verificação for concluído."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby sme zaistili správne priradenie a overenie vášho odporúčania, skontaktujeme sa s vami ešte pred vykonaním platby. Hneď ako bude proces overenia ukončený, budeme vás o tom informovať."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referansınızın doğru bir şekilde atanıp doğrulanabilmesi için ödeme yapmadan önce sizinle iletişime geçeceğiz. Doğrulama işlemi tamamlanır tamamlanmaz sizi bilgilendireceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб правильно присвоїти та перевірити вашу рекомендацію, ми зв'яжемося з вами перед здійсненням оплати. Вас буде поінформовано, щойно ми завершимо перевірку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为确保您的推荐奖励能够正确分配和验证，我们将在付款前与您联系。一旦验证流程完成，我们将立即通知您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為確保您的推薦獎勵能夠正確分配和驗證，我們會在付款前與您聯絡。一旦驗證過程完成，我們會立即通知您。"
          }
        }
      }
    },
