        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please open Settings and allow Contacts access to see linked contact. Or unlink contact permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre los ajustes para permitir el acceso a los contactos y ver el contacto vinculado o desvincula el contacto permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez ouvrir les Réglages et accorder l’accès aux contacts pour voir le contact lié. Vous pouvez sinon dissocier le contact de façon permanente."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte mached Sie d’Iistellige uf, zum de Zuegriff uf d’Kontäkt z’erlaube und de verchnüpfti Kontakt ah z’zeige. Oder hebed Sie d’Verchnüpfig permanent uf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri le impostazioni per consentire l’accesso ai contatti e per visualizzare il contatto collegato, oppure rimuovi il collegamento in modo permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を開き、連絡先へのアクセスを許可すると、紐付けされた連絡先が表示されます。または、連絡先の紐付けを永久に解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 연락처를 표시하기 위해 설정을 열고 연락처 접근 권한을 허용하십시오. 또는 연락처 연결을 영구적으로 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de Instellingen en geef toegang tot contactpersonen om gekoppelde contactpersonen te bekijken. Of verbreek de koppeling met de contactpersoon permanent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Ustawienia i udziel dostępu do Kontaktów i pokaż powiązane kontakty lub trwale usuń powiązania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra as Configurações e autorize o acesso aos Contatos para ver o contato vinculado. Ou desvincule o contato permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте настройки и разрешите контактам доступ для просмотра привязанного контакта. Или отвяжите контакт окончательно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete vidiet prepojený kontakt, otvorte prosím nastavenia a povolte prístup ku kontaktom. Alebo kontakt natrvalo odpojte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen Ayarlar'ı açın ve bağlı kişiyi görmek için Kişiler'e erişim izni verin veya kişinin bağlantısını kalıcı olarak kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Налаштування та надайте Контактам дозвіл на перегляд прив'язаного контакту. Або відв'яжіть контакт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开 “设置” 并允许 “通讯录” 访问以查看已链接的联系人，或者永久解除链接联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟「設定」並允許「通訊錄」取用以檢視已連結的聯絡人，或者永久解除連結聯絡人。"
          }
        }
      }
    },
