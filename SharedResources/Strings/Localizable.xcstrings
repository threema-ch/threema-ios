    "settings_orphaned_files_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато в по-стари %@ версии се изтриват данни от „управление на хранилището“, в много редки случаи може мултимедийните файлове да не се изтрият правилно, но да са премахнати от %@. Създайте iTunes резервно копие, защото може да изгубите данните си!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při odstraňování dat ve správě úložiště v předchozích verzích %@ se ve výjimečných případech mohlo stát, že (mediální) soubory nebyly odstraněny zcela, ale byly odebrány v %@. Nejdříve vytvořte zálohu pomocí iTunes; může dojít ke ztrátě dat!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In früheren %@-Versionen konnte es in seltenen Fällen vorkommen, dass beim Löschen von Daten über die Speicherverwaltung Medien und/oder Dateien aus %@ entfernt, jedoch nicht vollständig gelöscht wurden. Erstellen Sie ein iTunes-Backup, bevor Sie fortfahren; Datenverlust kann entstehen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When deleting data in the Storage Management in previous %@ versions, it could happen in rare cases that (media) files were not deleted correctly but removed in %@. Create an iTunes backup first; data loss may occur!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar datos en la gestión de almacenamiento de versiones anteriores de %@, existe una pequeña posibilidad de que algunos archivos (multimedia) no se borraran correctamente pero se eliminaran en %@. Cree antes una copia de seguridad de iTunes. ¡Pueden perderse datos!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la suppression de données dans la gestion de stockage des versions précédentes de %@, il pouvait arriver dans de rares cas que des fichiers (médias) n’aient pas été supprimés correctement mais qu’ils aient été retirés dans %@. Créez d’abord une sauvegarde iTunes ; une perte de données peut se produire !"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I früehnere %@-Versione häts i sältene Fäll chöne vorcho, dass bim Lösche vo Date über d’Speicherverwaltig Medie und/oder Dateie us %@ entfernt, aber nöd vollständig glöscht worde sind. Mached Sie es iTunes-Backup, bevor Sie wiitermached; Dateverlust cha entstah!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle versioni precedenti di Threema poteva capitare che cancellando dati mediante gestione della memoria venissero eliminati file multimediali e/o dati da Threema, senza però essere cancellati completamente. Crea un backup iTunes prima di procedere. L’azione può comportare una perdita di dati!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンの%@では、ストレージ管理でデータを削除する際に、まれにメディアファイルが正しく削除されずに%@で削除されてしまうことがありました。 iTunesのバックアップを作成してから行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 %@ 버전에서 저장소 관리에서 데이터를 삭제할 때, (미디어) 파일이 제대로 삭제되지 않고 %@에서 제거되는 경우가 드물게 발생할 수 있었습니다. 먼저 iTunes 백업을 만드세요. 데이터 손실이 발생할 수 있습니다!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer in eerdere versies van %@ gegevens uit het Opslagbeheer werden verwijderd, kon het in zeldzame gevallen gebeuren dat de (media)bestanden niet correct werden verwijderd maar wel in %@ werden verwijderd. Maak eerst een iTunes-back-up; gegevensverlies kan optreden!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas usuwania danych przez Storage Management w poprzednich wersjach systemu %@, w rzadkich przypadkach mogło się zdarzyć, że pliki (multimedialne) nie zostały prawidłowo skasowane, ale zostały usunięte w %@. Utwórz najpierw kopię zapasową w iTunes; może dojść do utraty danych!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em raras ocasiões, ao excluir dados no Gerenciamento de Armazenamento em versões mais antigas do %@, pode ser que arquivos (de mídia) não sejam excluídos corretamente, mas tenham sido removidos no %@. Crie um backup no iTunes primeiro. Pode haver perda de dados!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении данных во время управления хранилищем данных в предыдущих версиях %@ иногда возникает ситуация, когда мультимедийные файлы удаляются не полностью, но исключаются из списков %@. Сначала создайте резервную копию данных в iTunes, поскольку возможна утрата данных!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri mazaní údajov v správe úložiska sa v predchádzajúcich verziách %@ mohlo vo výnimočných prípadoch stať, že súbory (média) neboli úplne odstránené. Najprv vytvorte zálohu pomocou iTunes; môže dôjsť k strate údajov!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki %@ sürümlerinde Depolama yönetimindeki verileri silerken, (medya) dosyalarının doğru şekilde silinmediği, ancak %@ sürümünde kaldırıldığı nadir durumlarda olabilir. Önce bir iTunes yedeklemesi oluşturun; veri kaybı meydana gelebilir!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час видалення даних через Керування сховищем у попередніх версіях %@, траплялись рідкі випадки того, що файли не видалялись, а переміщувались до %@. Спочатку створіть резервну копію iTunes; дані може бути втрачено!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在以前的 %@ 版本中，在存储管理中删除数据时，在极少数情况下，可能会发生以下情况：（媒体）文件未正确删除，而是在 %@ 中删除了。 请先建立 iTunes 备份，否则可能会出现数据丢失！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在以前的 %@ 版本中，在儲存管理中刪除資料時，在極少數情況下，可能會發生以下情況：（媒體）​​檔案未正確刪除，而是在 %@ 中刪除了。 請先建立 iTunes 備份，否則可能會出現資料丟失！"
          }
        }
      }
    },
    "settings_orphaned_files_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ от %@ файлове са непотребни. Преместете непотребните файлове в кошчето и се уверете, че няма липсващи (мултимедийни) файлове в %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ z %@ souborů je osiřelých. Přesuňte osiřelé soubory do koše a ujistěte se, že vám v %@ nechybí žádné (mediální) soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von %@ Dateien sind verwaist. Verschieben Sie die verwaisten Dateien in den Papierkorb, und überprüfen Sie, ob keine Medien und/oder Dateien in %@ fehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of %@ files are orphaned. Move the orphaned files to the trash bin, and ensure that no (media) files are missing in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@ archivos están huérfanos Mueva los archivos huérfanos a la papelera de reciclaje y procure que no falten archivos (multimedia) en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@ fichiers sont orphelins. Déplacez les fichiers orphelins vers la corbeille et assurez-vous qu’aucun fichier (média) ne manque dans %@."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vo %@ Dateie sind verwaist. Verschiebed Sie di verwaiste Dateie in Papierchorb, und überprüefed Sie, öb kei Medie und/oder Dateie in %@ fehled."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ file su %@ sono abbandonati. Sposta i file abbandonati nel cestino e controlla che non manchino dei media e/o file in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ファイル中%@ファイルが孤立しています。 孤立したファイルをゴミ箱に移動し、%@で（メディア）ファイルがなくなっていないことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 중 %@ 파일이 고아 파일입니다. 고아 파일을 휴지통으로 이동하고 %@에서 누락된 (미디어) 파일이 없도록 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van %@ bestanden zweven. Verplaats de zwevende bestanden naar de prullenbak en zorg ervoor dat er geen (media)bestanden in %@ ontbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ z %@ plików jest osieroconych. Przenieś osierocone pliki do kosza i sprawdź, czy w %@ nie brakuje żadnych plików (multimedialnych)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@ arquivos estão órfãos. Mova os arquivos órfãos para a lixeira e certifique-se de que nenhum arquivo (de mídia) esteja faltando no %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ из %@ являются потерянными. Переместите потерянные файлы в корзину, чтобы гарантировать отсутствие недостающих мультимедийных файлов в %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ z %@ súborov je nepotrebných. Presuňte osamotené súbory do koša a uistite sa, že vám v %@ nechýbajú žiadne (mediálne) súbory."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / %@ dosya artık kaldı. Artık dosyaları çöp kutusuna taşıyın ve %@ içinde hiçbir (medya) dosyasının eksik olmadığından emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ з %@ файлів загублені. Перемістіть загублені файли до смітника та упевніться, що жодних (медіа) файлів не залишилось у %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@个文件中的%@个是孤立文件。 将孤立文件移至垃圾桶，并确保 %@ 中没有丢失（媒体）文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@個檔案中的%@個是孤兒檔案。 將孤兒檔案移至垃圾桶，並確保 %@ 中沒有丟失（媒體）檔案。"
          }
        }
      }
    },
