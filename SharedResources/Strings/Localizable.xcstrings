    "abort_verification_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Броят на опити е ограничен. Моля, изчакайте поне 30 минути за да получите SMS или опитайте опцията звънене."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet pokusů je omezený. Počkejte na doručení SMS alespoň 30 minut nebo zkuste možnost hovoru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzahl Versuche ist begrenzt; bitte warten Sie mindestens 30 Minuten auf die SMS, oder versuchen Sie die Anruf-Option."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of attempts is limited; please wait at least 30 minutes for the SMS to arrive or try the call option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de intentos es limitado, espere un mínimo de 30 minutos a que llegue el SMS o pruebe con la opción de llamada de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre de tentatives est limité. Veuillez patienter au moins 30 minutes avant que le SMS arrive ou essayez l’option d’appel."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Azahl Versüech isch begränzt; bitte warted Sie mindestens 30 Minute uf d’SMS, oder versueched Sie’s mit de Aruef-Option."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di tentativi è limitato; attendere almeno 30 minuti l’arrivo del SMS o scegliere l’opzione richiesta chiamata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数には限りがありますので、SMSが届くまで30分以上お待ちいただくか、音声通話をご利用ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시도 횟수는 제한되어 있습니다. SMS가 도착할 때까지 최소 30분을 기다리거나 통화 옵션을 이용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aantal pogingen is beperkt. Wacht ten minste 30 minuten om te zien of de SMS aankomt of probeer de oproepoptie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba prób jest ograniczona; poczekaj co najmniej 30 minut na przybycie wiadomości SMS lub wypróbuj opcję połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O número de tentativas é limitado. Espere pelo menos 30 minutos para que o SMS chegue ou tente a opção de chamada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество попыток ограничено; подождите как минимум 30 минут, пока не придет SMS, или попробуйте опцию вызова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet pokusov je obmedzený; počkajte prosím aspoň 30 minút na príchod SMS, alebo skúste možnosť telefonátu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme sayısı sınırlaması mevcut; lütfen kısa mesajın gelmesi için en az 30 dakika bekleyin veya arama seçeneğini deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість спроб обмежена. Будь ласка, зачекайте щонайменше 30 хвилин для отримання СМС або спробуйте опцію виклику."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证次数已经达到上限，请至少等待30分钟短信到达，或尝试通话选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證次數已經達到上限，請至少等待30分鐘簡訊到達，或嘗試通話選項。"
          }
        }
      }
    },
