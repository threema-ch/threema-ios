    "rs_view_description_encrypted_data" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бяха намерени някои данни на това устройство. За да настроите приложението, Вие трябва да ги изтриете от Началния екран и да започнете отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vašem zařízení byla nalezena nějaká data. Abyste mohli nastavit aplikaci, musíte ji odstranit z domácí obrazovky a začít znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurden Daten auf dem Gerät entdeckt. Bitte löschen Sie die App auf dem Home-Bildschirm und starten Sie das Setup erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data was found on your device. To set up the app, you have to delete it from the Home Screen and start again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han encontrado algunos datos en su dispositivo. Para configurar la aplicación, debe eliminarlos de la pantalla de inicio y empezar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données ont été trouvées sur votre appareil. Pour configurer l'application, vous devez la supprimer sur l'écran d'accueil, puis recommencer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind Date uf dem Grät gfunde worde. Bitte lösched Sie d’App ufem Home-Bildschirm und started Sie s’Setup nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati rilevati alcuni dati sul tuo dispositivo. Per configurare l'app, devi eliminarla dalla schermata Home e ricominciare da capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末にデータが見つかりました。アプリをセットアップするには、ホーム画面からそれを削除して、もう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에서 일부 데이터가 발견되었습니다. 앱을 설정하려면 홈 화면에서 앱을 삭제한 후 다시 시작해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn gegevens op uw apparaat gevonden. U moet de app vanaf het startscherm verwijderen en opnieuw beginnen om hem in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaleziono pewne dane na Twoim urządzeniu. Aby skonfigurować aplikację, musisz usunąć ją z ekranu głównego i zacząć jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados foram encontrados no seu dispositivo. Para configurar o aplicativo, exclua-o da tela inicial e comece novamente."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vašom zariadení boli nájdené nejaké dáta. Ak chcete nastaviť aplikáciu, musíte ju odstrániť z domovskej obrazovky a začať znovu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızda bazı veriler bulundu. Uygulamayı yeniden kurmak için, ana ekrandan silmeniz ve baştan başlamanız gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Певні дані було знайдено на вашому телефоні. Для налаштування застосунку — видаліть його з Домашнього екрану та почніть спочатку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的设备上发现了以往的数据。如要设置本应用，请先从主屏幕删除本应用，然后重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的裝置上發現了以往的資料。如要設定本應用程式，請先從主畫面刪除本應用程式，然後重新開始。"
          }
        }
      }
    },
