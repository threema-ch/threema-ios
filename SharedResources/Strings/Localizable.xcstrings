    "work_referral_view_section_info_rec_text" : {
      "comment" : "Text in the \"How it works\" section of the \"Work referral\" view, describing the process of receiving a referral.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Препоръчаната фирма не бива да е вече наш клиент и трябва да поръча лицензи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Společnost, kterou doporučíte, nesmí být naším stávajícím zákazníkem a musí si u nás objednat licence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das angeworbene Unternehmen darf noch kein Kunde von uns sein und muss eine kostenpflichtigen Bestellung von Lizenzen tätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The referred company must not already be a customer of ours and must order licenses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La empresa recomendada no debe ser ya cliente suyo y debe realizar un pedido de licencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entreprise parrainée ne doit pas déjà figurer parmi nos clients et elle doit commander des licences."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di aagworbe Firma dörf no kein Chund vo üs sii und mues e choschtepflichtigi Bstellig vo Lizänze ufgeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'azienda presentata non deve essere già nostra cliente e deve ordinare delle licenze."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천하는 회사는 기존 고객이 아니어야 하며 반드시 라이선스를 주문해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het doorverwezen bedrijf mag niet al klant van ons zijn en moet licenties bestellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skierowana do nas firma nie może wcześniej być naszym klientem i musi zamówić licencje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A empresa indicada não pode ser cliente nossa e deve adquirir licenças."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvedená spoločnosť nesmie byť už našim zákazníkom a musí si objednať licencie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahsi geçen şirket halihazırda müşterimiz olmamalı ve lisans siparişi vermiş olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компанія, якій ви надсилаєте рекомендацію, не може вже бути нашим клієнтом та має замовити ліцензії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被推荐的公司不可以是我们已有的客户，并且必须订购许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被推薦的公司不可以是我們已有的客戶，並且必須訂購許可證。"
          }
        }
      }
    },
