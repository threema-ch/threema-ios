    "alert_biometrics_changed_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, въведете кода за достъп до %@, за да продължите да използвате биометрия за отключване на %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li dále odemykat aplikaci %@ pomocí biometrického ověření, zadejte jednorázově svůj přístupový kód %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie ihren %@-Code einmalig ein, um die biometrische Authentifizierung für %@ wieder zu erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter your %@ passcode once, to continue using biometric authentication to unlock %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca su código de acceso de %@ una vez para continuar utilizando la autenticación biométrica para desbloquear %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez saisir votre code %@ une fois afin de continuer à utiliser l'authentification biométrique pour déverrouiller %@."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebed Sie Ihre %@-Code einmalig ii, zum di biometrisch Authentifizierig für %@ wieder z’erlaube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci una volta il tuo codice di accesso %@ per continuare a utilizzare l'autenticazione biometrica per sbloccare %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証による%@のロック解除を継続するため、%@のパスコードを一度入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속해서 %@를 잠금 해제하기 위해 생체 인증을 사용하려면 %@ 패스코드를 한 번 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer uw %@-toegangscode eenmaal in om de biometrische authenticatie verder te gebruiken en %@ te ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz raz kod dostępu %@, aby dalej korzystać z uwierzytelniania biometrycznego, aby odblokować %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira a sua senha do %@ uma vez para continuar usando a autenticação biométrica para desbloquear o %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите свой пароль %@ один раз, чтобы продолжить использовать биометрическую аутентификацию для разблокировки %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte svoj prístupový kód %@ raz, aby ste mohli pokračovať v používaní biometrickej autentifikácie na odomknutie %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'yı biyometrik doğrulamayla kullanmaya devam etmek istiyorsanız, lütfen şifrenizi bir defalığına giriniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть свій код доступу %@ один раз, щоб і надалі використовувати біометричну автентифікацію для розблокування %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请再输入你的 %@ 密码，以继续使用生物认证来解锁 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請再輸入您的 %@ 密碼，以繼續使用生物辨識以解鎖 %@。"
          }
        }
      }
    },
