    "md_wizard_info_linking_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато свързвате компютъра, Вашите основни %@ данни (Вашият идентификатор, контактите и групите) ще бъдат криптирани и временно запазени на [%@ Safe сървъра, който използвате](https://threema.com/en/faq/threema_safe_webdav). (Текуща настройка: %@)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při propojení vašeho počítače budou vaše základní údaje v %@ (vaše ID, kontakty a skupiny) zašifrovány a dočasně uloženy na [server %@ Safe, který právě používáte](https://threema.com/en/faq/threema_safe_webdav). (Aktuální nastavení: %@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verknüpfen Ihres Computers werden Ihre wichtigsten %@-Daten (ID, Kontakte und Gruppen) verschlüsselt und vorübergehend auf dem [%@-Server, den Sie zur Zeit nutzen](https://threema.com/de/faq/threema_safe_webdav). (Aktuelle Einstellung: %@.), gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When linking your computer, your basic %@ data (your ID, contacts, and groups) will be encrypted and temporarily stored on the [%@ Safe server you currently use](https://threema.com/en/faq/threema_safe_webdav). (Current setting: %@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al vincular su ordenador, sus datos básicos de %@ (su ID, contactos y grupos) se cifrarán y almacenarán temporalmente en el [servidor seguro de %@ que utiliza actualmente](https://threema.com/en/faq/threema_safe_webdav). (Ajuste actual: %@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous reliez votre ordinateur, vos données %@ de base (votre identifiant, vos contacts et vos groupes) seront cryptées et temporairement stockées sur le [serveur %@ Safe que vous utilisez actuellement](https://threema.com/fr/faq/threema_safe_webdav). (Paramètres actuels : %@)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bim Verchnüpfe vo Ihrem Compi werded Ihri wichtigste %@-Date (ID, Kontäkt und Gruppe) verschlüsslet und vorübergehend ufem [%@-Server, wo Sie im Moment nutzed](https://threema.com/de/faq/threema_safe_webdav) (aktuelli Iistellig: %@), gspeicheret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando colleghi il tuo computer, i tuoi dati %@ di base (il tuo ID, i contatti e i gruppi) verranno cifrati e temporaneamente memorizzati sul [server sicuro %@ utilizzato al momento](https://threema.com/en/faq/threema_safe_webdav). (Impostazioni attuali: %@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パソコンとリンクすると、あなたの%@の基本データ（ID、連絡先、グループ）が暗号化され、［現在利用している%@ Safeサーバー](https://threema.com/en/faq/threema_safe_webdav)に一時的に保存されます。(現在の設定：%@）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터를 연결할 때 기본 %@ 데이터(당신의 ID, 연락처 및 그룹)는[현재 사용 중인 %@ Safe 서버](https://threema.com/en/faq/threema_safe_webdav)에 암호화되어 일시적으로 저장됩니다. (현재 설정: %@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het koppelen van uw computer, worden uw basisgegevens van %@ (uw ID, contactpersonen en groepen) versleuteld en tijdelijk opgeslagen op de [veilige server van %@ die u momenteel gebruikt](https://threema.com/en/faq/threema_safe_webdav). (Huidige instelling: %@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy łączeniu z komputerem Twoje podstawowe dane %@ (Twój identyfikator, kontakty oraz grupy) będą zaszyfrowane i tymczasowo przechowywane na [używanym serwerze bezpiecznym %@](https://threema.com/en/faq/threema_safe_webdav). (Bieżące ustawienie:\n%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao vincular o seu computador, seus dados básicos do %@ (sua ID, contatos e grupos) serão criptografados e armazenados temporariamente no [servidor do %@ Safe que você usa atualmente](https://threema.com/en/faq/threema_safe_webdav). (Configuração atual: %@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время привязки компьютера ваши основные данные %@ (ваш ID, контакты и группы) будут зашифрованы и временно сохранены на [сервере %@ Safe, который мы в настоящее время используем](https://threema.com/en/faq/threema_safe_webdav). (Текущая настройка: %@)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızı bağlarken, temel %@ verileriniz (kimliğiniz, kişileriniz ve gruplarınız) şifrelenir ve geçici olarak [şu anda kullandığınız %@ Safe sunucusunda](https://threema.com/en/faq/threema_safe_webdav) saklanır.\n(Şimdiki ayar: %@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızı bağlarken, temel %@ verileriniz (kimliğiniz, kişileriniz ve gruplarınız) şifrelenir ve geçici olarak [şu anda kullandığınız %@ Safe sunucusunda](https://threema.com/en/faq/threema_safe_webdav) saklanır.\n(Şimdiki ayar: %@)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви прив’яжете свій комп’ютер, ваші базові дані %@ (ваш ID, контакти й групи) буде зашифровано й вони тимчасового зберігатимуться на [сервері %@ Safe, який ви зараз використовуєте](https://threema.com/en/faq/threema_safe_webdav). (Поточне налаштування: %@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您的电脑连接时，您的基本 %@ 数据（例如您的ID、联系人和群组）将被加密并暂时存储在[你目前使用的 %@ Safe 服务器](https://threema.com/en/faq/threema_safe_webdav)。(当前设置：%@)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與您的電腦連結時，您的基本 %@ 資料 (例如 ID、聯絡人和群組) 將被加密並暫時儲存在[您目前使用的 %@ Safe 伺服器](https://threema.com/en/faq/threema_safe_webdav)。(目前設定: %@)。"
          }
        }
      }
    },
