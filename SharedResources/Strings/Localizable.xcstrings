        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare il server di %@ oppure specificare un server di backup di terze parti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のサーバーを使用するか、サードパーティのバックアップサーバーを指定することができます。"
