    "this_device_decision_additional_info" : {
      "comment" : "Information text in the \"This device only\" decision view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато използвате Finder за трансфера на резервното копие, то трябва да криптирано, за да включва Threema идентификатора. Apple няма да има достъп до частния ключ, който се съхранява в криптираното резервно копие във Finder."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při použití zálohy Finderu pro přenos dat musí být záloha zašifrována, aby zahrnovala Threema ID. Společnost Apple nebude mít přístup k soukromému klíči uloženému v zašifrované záloze Finderu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Daten via Finder-Backup übertragen, muss dieses verschlüsselt sein, damit die Threema-ID enthalten ist. Apple hat keinen Zugriff auf den privaten Schlüssel, der im verschlüsselten Finder-Backup gespeichert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When using a Finder backup for the data transfer, it must be encrypted in order to include the Threema ID. Apple will not have access to the private key stored in the encrypted Finder backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al utilizar una copia de seguridad de Finder para la transferencia de datos, debe estar cifrada para incluir el ID de Threema. Apple no tendrá acceso a la clave privada almacenada en la copia de seguridad cifrada de Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'une sauvegarde Finder est utilisée pour le transfert de données, elle doit être chiffrée pour inclure l'identifiant Threema. Apple n'aura pas accès à la clé privée stockée dans la sauvegarde Finder chiffrée."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie d’Date via Finder-Backup überträged, mues das verschlüsslet sii, damit d’Threema-ID enthalte isch. Apple hät kein Zuegriff uf de privat Schlüssel, wo im verschlüsslete Finder-Backup gspeicheret isch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si utilizza un backup del Finder per il trasferimento dei dati, questo deve essere crittografato per includere l'ID Threema. Apple non avrà accesso alla chiave privata memorizzata nel backup del Finder crittografato."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak na prenos údajov používate zálohu z programu Finder, táto záloha musí byť zašifrovaná, aby obsahovala Threema ID. Spoločnosť Apple nebude mať prístup k súkromnému kľúču uloženému v zašifrovanej zálohe z programu Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veri aktarımı için Finder yedeklemesi kullanıldığında, Threema ID'nin de dahil edilebilmesi için yedeklemenin şifrelenmesi gerekir. Apple, şifrelenmiş Finder yedeklemesinde saklanan özel anahtara erişemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час використання Finder для створення резервної копії для перенесення даних, вона повинна бути зашифрована, щоб містити ID Threema. Apple не матиме доступу до особистого ключа, збереженого в зашифрованій резервній копії Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 “访达” (Finder) 备份进行数据传输时，备份必须加密才能包括 Threema ID。苹果公司无法访问存储在已加密 “访达” 备份中的私钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Finder 備份進行資料傳輸時，備份必須加密才能包括 Threema ID。 Apple 將無法存取儲存在已加密 Finder 備份中的私鑰。"
          }
        }
      }
    },
    "this_device_decision_alert_message" : {
      "comment" : "Message in the alert displayed when an error occurs while determining the user's identity accessibility setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необходимата информация за активиране на тази функция не е налична. Ще Ви покажем този прозорец отново по-късно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezdařilo se shromáždit informace potřebné k aktivaci této funkce. Tuto obrazovku vám později ukážeme znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zur Aktivierung dieser Funktion erforderlichen Informationen konnten nicht erfasst werden. Wir zeigen Ihnen diesen Bildschirm später erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
