    "restore_option_data_delete_data_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възстановете %@ Safe резервното копие (съдържащо Вашия идентификатор, контактите и групите) или експортирания идентификатор (съдържащ само Вашия %@ идентификатор) след като се премахнат локалните данни"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovit zálohu z %@ Safe (obsahuje vaše ID, kontakty a skupiny) nebo exportu ID (obsahuje pouze %@ ID) po odstranění lokálních dat"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Löschen der lokalen Daten ein %@ Safe-Backup (beinhaltet Ihre ID, Kontakte und Gruppen) oder einen ID-Export (beinhaltet nur Ihre %@-ID) wiederherstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore a %@ Safe backup (containing your ID, contacts, and groups) or an ID export (containing only the %@ ID) after removing the local data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar una copia de seguridad %@ Safe (que incluye el ID, los contactos y los grupos) o un ID exportado (que solo incluye el ID de %@) después de eliminar los datos locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurer une sauvegarde %@ Safe (contenant votre ID, vos contacts et vos groupes) ou une exportation d’ID (contenant seulement l’ID %@) après avoir supprimé les données locales"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachem Lösche vode lokale Date es %@ Safe-Backup (beinhaltet Ihri ID, Kontäkt und Gruppe) oder en ID-Export (beinhaltet nur Ihri %@-ID) wiederherstelle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina un backup %@ Safe (contenente ID, contatti e gruppi) o un ID esportato (contenente solo il %@ ID) dopo aver rimosso i dati locali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルデータを削除した後、%@ Safeバックアップ（ID・連絡先・グループを含む）またはIDエクスポート（%@ IDのみを含む）を復元する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 데이터를 제거한 후 %@ Safe 백업(당신의 ID, 연락처 및 그룹을 포함) 또는 ID 익스포트(%@ ID만 포함)를 복원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een %@ Safe back-upbestand herstellen (bevat uw ID, contactpersonen en groepen) of een ID-exportbestand (bevat alleen uw %@-ID) na het verwijderen van de lokale gegevens"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć kopię zapasową %@ Safe (zawierającą Twój ID, kontakty i grupy) lub eksportowany ID (zawierający tylko ID %@) po usunięciu danych lokalnych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure um backup do %@ Safe (contendo sua ID, contatos e grupos) ou uma exportação de ID (contendo somente a ID do %@) após remover os dados locais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление резервной копии %@ Safe (содержит ваш ID, контакты и группы) или экспорта ID (содержит только %@ ID) после удаления локальных данных"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vymazaní lokálnych údajov obnoviť zálohu z %@ Safe (obsahujúcu vaše ID, kontakty a skupiny), alebo z exportu ID (obsahujúcu iba %@ ID)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel verileri kaldırdıktan sonra bir %@ Safe yedeklemesini (kimliğinizi, kişilerinizi ve gruplarınızı içeren) veya bir kimlik dışa aktarımını (yalnızca %@ kimliğini içeren) geri yükle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновити резервну копію %@ Safe (містить ваш ID, контакти та групи) або експортований ID (містить лише %@ ID) після видалення даних на пристрої"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除本地数据后，恢复 %@ Safe 备份（包含您的 ID，联系人和群组）或 ID 导出（仅包含%@ ID）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除本地資料後，還原 %@ Safe 備份（包括您的 ID，聯絡人和群組）或 ID 匯出（僅限 %@ ID）"
          }
        }
      }
    },
    "restore_option_data_delete_data_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да възстановите напълно %@ Safe резервното копие, Вие трябва да преинсталирате %@: Моля, изтрийте приложението и го изтеглете отново от App Store."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li provést plné obnovení zálohy z %@ Safe, musíte aplikaci %@ přeinstalovat: Odstraňte prosím aplikaci a poté si ji znovu stáhněte z obchodu App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein komplettes %@ Safe-Backup wiederherzustellen, muss eine Neuinstallation von %@ durchgeführt werden: Löschen Sie bitte die App und laden Sie sie erneut aus dem App Store herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In order to restore a full %@ Safe backup, you must reinstall %@: Please delete the app and then download it again from the App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para restaurar una copia de seguridad %@ Safe completa, debe reinstalar %@. Para ello, borre la aplicación y vuelva descargarla desde la App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afin de restaurer une sauvegarde %@ Safe complète, vous devez réinstaller %@. Veuillez supprimer l’application et la télécharger de nouveau depuis l’App Store."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum es kompletts %@ Safe-Backup wiederherzstelle, muess e Neuinstallation vo %@ duregfüehrt werde: Lösched Sie bitte d’App und ladet Sie sie nomal usem App Store abe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ripristinare un intero backup %@ Safe, è necessario reinstallare %@: elimina l’app e riscaricala dall’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeのフルバックアップを復元するためには、%@を再インストールする必要があります。一度アプリを削除してから、App Storeから再度ダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 %@ Safe 백업을 복원하려면 %@을(를) 다시 설치해야 합니다: 앱을 삭제한 다음 App Store에서 다시 다운로드하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een volledige %@ Safe back-up the herstellen, moet u %@ opnieuw installeren. Verwijder de app en download hem opnieuw via de App Store."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przywrócić pełną kopię zapasową %@ Safe, musisz ponownie zainstalować %@: usuń aplikację, a następnie pobierz ją ponownie z App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para restaurar um backup completo do %@ Safe, você deve reinstalar o %@. Exclua o aplicativo e baixe-o novamente na App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы восстановить полную резервную копию %@ Safe, необходимо переустановить %@: удалите приложение, а затем заново скачайте его из App Store."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby bolo možné obnoviť plnú zálohu %@ Safe, musíte aplikáciu %@ preinštalovať: Odstráňte prosím aplikáciu a potom ju z App Storu znovu nainštalujte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir %@ Safe yedeklemesini geri yüklemek için, %@ yeniden yüklemelisiniz: Lütfen uygulamayı silin ve ardından App Store'dan yeniden indirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для відновлення повної резервної копії %@ Safe ви маєте перевстановити %@. Будь ласка, видаліть застосунок та завантажте його знов з App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了恢复完整的 %@ Safe 备份，您必须重新安装 %@。请先删除应用，然后从 App Store 重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了還原完整的 %@ Safe 備份，您必須重新安裝 %@。請先刪除應用程式，然後從 App Store 重新下載。"
          }
        }
      }
    },
