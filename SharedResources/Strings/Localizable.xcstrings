          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad no se ha descargado en su dispositivo. Ábrala en la aplicación Archivos para descargarla y, a continuación, inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde n’est pas téléchargée sur votre appareil. Ouvrez-la dans l’application Fichiers pour la télécharger, puis réessayez."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup isch nöd uf Ihres Grät abeglade. Öffned Sie’s ide App «Dateien», zum’s abelade, und versueched Sie’s dänn nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup non è scaricato sul tuo dispositivo. Aprilo nell’app File per scaricarlo, poi riprova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedekleme cihazınıza indirilmedi. İndirmek için Dosyalar uygulamasında açın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця резервна копія не завантажена на ваш пристрій. Відкрийте її в програмі Файли для завантаження, а потім спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份还未下载到您的设备。请在“文件”应用中打开该备份以进行下载，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
