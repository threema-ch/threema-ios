    "edit_message_can_not_edit" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съобщението беше изпратени преди повече от 6 часа и вече не може да бъде редактирано."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva byla odeslána před více než 6 hodinami, a proto ji již nelze upravovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht wurde vor mehr als 6 Stunden verschickt und kann deswegen nicht mehr bearbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message was sent more than 6 hours ago and can therefore no longer be edited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mensaje se envió hace más de 6 horas, por lo que ya no puede editarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message a été envoyé il y a plus de 6 heures, il ne peut donc plus être modifié."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht isch vor meh als 6 Stunde verschickt worde und cha drum nüme bearbeitet werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il messaggio è stato inviato più di 6 ore fa e non può più essere modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージは6時間以上前に送信されているため、もう編集することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지가 6시간 이상 전에 전송되었으므로 더 이상 편집할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bericht is langer dan 6 uur geleden verzonden en kan niet meer worden bewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomość została wysłana ponad 6 godzin temu i dlatego nie będzie można jej edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mensagem foi enviada há mais de 6 horas e, por isso, não pode mais ser editada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение отправлено более 6 часов назад, поэтому изменить его больше нельзя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správa bola odoslaná pred viac ako 6 hodinami, a preto ju už nemožno upravovať."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesaj 6 saatten daha uzun bir süre önce gönderilmiştir ve bu nedenle artık düzenlenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення надіслано понад 6 годин тому, отже не може бути редаговано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该信息已发送超过6小时，因此无法再编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該訊息已傳送超過6小時，因此無法再編輯。"
          }
        }
      }
    },
