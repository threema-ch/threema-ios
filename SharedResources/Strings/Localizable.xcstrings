          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время привязки звонки и уведомления отключены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas procesu prepojenia sú hovory a upozornenia vypnuté."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlama işlemi sırasında aramalar ve bildirimler devre dışı bırakılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
