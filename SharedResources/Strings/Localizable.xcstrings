    "multi_device_linked_id_missing_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свързаните устройства са премахнати. За да не изгубите съобщения, възстановете %@ за настолен компютър сега. Можете да свържете Вашите устройства отново след възстановяването или да настроите това устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propojená zařízení byla odstraněna. Nechcete-li propásnout žádné zprávy, resetujte desktopovou aplikaci %@. Až si toto zařízení obnovíte nebo znovu nastavíte, budete moci svá zařízení znovu propojit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestehende Verknüpfungen wurden aufgehoben. Setzen Sie %@ für Desktop jetzt zurück, um keine Nachrichten zu verpassen. Nach der Wiederherstellung oder Einrichtung dieses Geräts können Sie Ihre Geräte erneut verknüpfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linked devices have been removed. To avoid missing out on messages, reset %@ for Desktop now. You can link your devices again after restoring or setting up this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han eliminado los dispositivos vinculados. Para no perderse ningún mensaje, restaure %@ para escritorio ahora. Puede volver a vincular sus dispositivos después de restaurar o configurar este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils associés ont été retirés. Pour éviter de rater des messages, réinitialisez %@ pour Desktop maintenant. Vous pouvez associer vos appareils à nouveau après avoir restauré ou configuré cet appareil."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestehendi Verchnüpfige sind ufghobe worde. Setzed Sie %@ für Desktop jetzt zrugg, demit Sie kei Nachrichte verpassed. Nach de Wiederherstellig oder Iirichtig vo dem Grät chönd Sie Ihri Grät nomal verchnüpfe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi collegati sono stati rimossi. Per non perdere i messaggi, ripristinare %@ dal desktop. Sarà possibile collegare nuovamente i dispositivi dopo aver ripristinato o configurato il dispositivo in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紐付けされた端末が削除されました。メッセージを見逃さないように、%@ for Desktopを今すぐリセットしてください。この端末を復元または設定すると、再度紐付けすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 장치가 제거되었습니다. 메시지를 놓치지 않으려면 지금 바로 %@ for Desktop을 재설정하세요. 이 장치를 복원하거나 설정한 후에 다시 장치를 연결할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelde apparaten zijn verwijderd. Reset %@ voor de desktop nu en voorkom dat u berichten mist. Nadat dit apparaat is geconfigureerd of hersteld, kunt u uw apparaten opnieuw koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączone urządzenia zostały usunięte. Aby nie przegapić wiadomości, zresetuj teraz %@ na komputerze. Możesz ponownie połączyć swoje urządzenia po przywróceniu lub skonfigurowaniu tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos vinculados foram removidos. Para não perder nenhuma mensagem, redefina o %@ para Desktop agora. Você pode vincular seus dispositivos novamente após restaurar ou configurar este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привязанные устройства были удалены. Чтобы не пропустить сообщения, выполните сброс %@ для ПК. Вы можете привязать свои устройства повторно после того, как восстановите или настроите это устройство."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepojené zariadenia boli odstránené. Ak chcete zabrániť zmeškaniu správ, resetujte teraz %@ for Desktop. Po obnovení alebo nastavení tohto zariadenia môžete zariadenia opäť prepojiť."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantılı cihazlar kaldırıldı. Mesajları kaçırmamak için %@ for Desktop'ı şimdi sıfırlayın. Bu cihazı geri yükledikten veya kurduktan sonra cihazlarınızı tekrar bağlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прив’язані пристрої вилучено. Щоб не пропустити повідомлення, перезавантажте %@ for Desktop зараз. Ви можете прив’язати їх знову після відновлення або налаштування цього пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前已链接的设备已被移除。为避免错过消息，请立即重置 %@ 电脑版。当您恢复或设置好此设备后，您可以再次链接您的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前已連結的裝置已被移除。為避免錯過訊息，請立即重設 %@ 電腦版。當您還原或設定好此裝置後，您可以再次連結您的裝置。"
          }
        }
      }
    },
