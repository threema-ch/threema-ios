    "settings_threema_calls_hide_voip_call_ip_footer_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установете директна връзка, ако е възможно, а използвайте криптирано обаждане само за непотвърдени контакти през %@ сървъри. Може да се разкрие Вашето IP."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navazovat přímé spojení, je-li to možné, a přes servery %@ směrovat pouze hovory s neověřenými kontakty. Může dojít k odhalení vaší IP adresy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn möglich, direkte Verbindung nutzen und nur Anrufe an unverifizierte Kontakte über %@-Server leiten. Kann Ihre IP-Adresse preisgeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establish a direct connection if possible, and only relay calls to unverified contacts through %@ servers. May expose your IP address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer una conexión directa y, si es posible, transmitir llamadas a contactos no verificados solo a través de los servidores de %@. Su dirección IP puede quedar al descubierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Établissez une connexion directe si possible et transmettez les appels vers des contacts non vérifiés uniquement via les serveurs %@. Cela peut exposer votre adresse IP."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn möglich, direkti Verbindig nutze und nur Arüef a unverifizierti Kontäkt über %@-Server leite. Cha Ihri IP-Adrässe priisgeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisci una connessione diretta, se possibile, e inoltra solo le chiamate ai contatti non verificati tramite i server %@. Potrebbe rivelare il tuo indirizzo IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能であれば直接接続し、検証されていない連絡先への電話は%@サーバーを介してのみ中継してください。これにより、IPアドレスが公開される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 직접 연결을 설정하고 확인되지 않은 연락처에 대한 통화를 %@ 서버를 통해 중계합니다. 이로 인해 IP 주소가 노출될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een directe verbinding maken, indien mogelijk, en oproepen naar niet-geverifieerde contactpersonen alleen doorschakelen via %@-servers. Dit kan uw IP-adres kenbaar maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawiązuj bezpośrednie połączenie, jeśli to możliwe, i przekaż połączenia tylko do niezweryfikowanych kontaktów za pośrednictwem serwerów %@ może ujawnić twój adres IP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabeleça uma conexão direta, se possível, e apenas retransmita chamadas para contatos não verificados através do servidores do %@. Seu endereço de IP pode ser exposto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По возможности устанавливать прямое соединение и ретранслировать звонки непроверенным контактам только через серверы %@. Может быть виден ваш IP-адрес."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je to možné, nadviazať priame spojenie a iba hovory s neoverenými kontaktmi presmerovávať cez %@ servery. Môže to odhaliť vašu IP adresu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkünse doğrudan bir bağlantı kurar ve aramaları yalnızca doğrulanmamış kişiler için %@ sunucuları üzerinden aktarır. IP adresinizi açığa çıkarabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановіть пряме з’єднання, якщо це можливо, і переадресуйте виклики лише неперевіреним контактам через сервери %@. Це може розкрити вашу IP-адресу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可以的话，则建立直接连接，并且只通过 %@ 服务器中继通话到未经核实的联系人。这可能会暴露您的 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可以的話，則建立直接連線，並且僅透過 %@ 伺服器將呼叫中繼至未經驗證的聯絡人。這可能會暴露您的IP位址。"
          }
        }
      }
    },
    "settings_threema_calls_hide_voip_call_ip_footer_on" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Криптирайте всички обаждания през %@ сървърите, за да скриете Вашия IP адрес от събеседниците Ви. Може да се отрази на качеството на разговора."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Směrovat hovory přes servery %@ kvůli skrytí IP adresy před partnery v hovoru. Může ovlivnit kvalitu hovorů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Anrufe über %@-Server leiten. Schützt Ihre IP-Adresse, kann aber zu schlechterer Anrufqualität führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relay all calls through %@ servers to hide IP address from call partners. May affect call quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar la transmisión de todas las llamadas a través de los servidores de %@, protegiendo su dirección IP. Puede afectar a la calidad de la llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmettre tous les appels via les serveurs %@ pour masquer votre adresse IP à vos partenaires d’appel. Cela peut affecter la qualité de l’appel."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Arüef über %@-Server leite. Schützt Ihri IP-Adrässe, cha aber zu schlächterer Aruefqualität füehre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza l’inoltro di tutte le chiamate tramite i server %@, proteggendo il tuo indirizzo IP. Potrebbe avere ripercussioni sulla qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全ての通話を%@サーバーに中継し、IPアドレスを保護します。これは通話品質に影響を与える可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP 주소를 통화 파트너에게 숨기기 위해 모든 통화를 %@ 서버를 통해 중계합니다. 이로 인해 통화 품질에 영향을 줄 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle oproepen doorschakelen via %@-servers om je IP-adres te verbergen. Dit kan de kwaliteit beïnvloeden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuś przekazywanie wszystkich połączeń przez serwery %@, chroniąc swój adres IP. Może wpływać na jakość połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retransmita todas as chamadas através dos servidores do %@ para ocultar o seu endereço de IP dos parceiros de chamada. Isso pode afetar a qualidade da chamada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ретрансляция всех звонков через серверы %@ с целью скрыть IP-адрес от партнеров, обрабатывающих звонки. Может ухудшаться качество связи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presmerovávať všetky hovory cez %@ servery z dôvodu skrytia vašej IP adresy. Môže ovplyvniť kvalitu hovoru."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP adresini gizlemek için tüm aramaları %@ sunucuları üzerinden aktarır. Arama kalitesini etkileyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переадресуйте всі виклики через сервери %@, щоб приховати IP-адресу від партнерів по виклику. Це може вплинути на якість викликів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 %@ 服务器中继所有通话，以隐藏合作伙伴的IP地址。这可能影响通话质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 %@ 伺服器中繼所有通話，以隱藏合作伙伴的IP位址。這可能會影響通話品質。"
          }
        }
      }
    },
    "settings_threema_calls_onprem_hide_voip_call_ip_footer_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установете директна връзка, ако е възможно, а използвайте криптирано обаждане само за непотвърдени контакти през %@ сървъри. Може да се разкрие Вашето IP."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navazovat přímé spojení, je-li to možné, a přes servery %@ směrovat pouze hovory s neověřenými kontakty. Může dojít k odhalení vaší IP adresy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn möglich, direkt verbinden und nur Anrufe mit nicht verifizierten Kontakten über %@-Server leiten. Kann Ihre IP-Adresse preisgeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establish a direct connection if possible, and only relay calls to unverified contacts through your %@ servers. May expose your IP address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer una conexión directa y, si es posible, transmitir llamadas a contactos no verificados solo a través de los servidores de %@. Su dirección IP puede quedar al descubierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Établissez une connexion directe si possible et transmettez les appels vers des contacts non vérifiés uniquement via vos serveurs %@. Cela peut exposer votre adresse IP."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn möglich, direkt verbinde und nur Arüef mit nöd verifizierte Kontäkt über %@-Server leite. Cha Ihri IP-Adrässe priisgeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisci una connessione diretta, se possibile, e inoltra solo le chiamate a contatti non verificati tramite il server %@. Potrebbe rivelare il tuo indirizzo IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能であれば直接接続し、検証されていない連絡先への電話は%@サーバーを介してのみ中継してください。これにより、IPアドレスが公開される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 직접 연결을 설정하고 확인되지 않은 연락처에 대한 통화를 %@ 서버를 통해 중계합니다. 이로 인해 IP 주소가 노출될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een directe verbinding maken, indien mogelijk, en oproepen naar niet-geverifieerde contactpersonen alleen doorschakelen via %@-servers. Dit kan uw IP-adres kenbaar maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawiązuj bezpośrednie połączenie, jeśli to możliwe, i przekaż połączenia tylko do niezweryfikowanych kontaktów za pośrednictwem serwerów %@. Może to ujawnić twój adres IP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabeleça uma conexão direta, se possível, e apenas retransmita chamadas para contatos não verificados através dos seus servidores do %@. Seu endereço de IP pode ser exposto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По возможности устанавливать прямое соединение и ретранслировать звонки непроверенным контактам только через ваши серверы %@. Может быть виден ваш IP-адрес."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je to možné, vytvoriť priame spojenie a hovory na neoverené kontakty sa presmerujú prostredníctvom serverov %@. Môže sa odhaliť vaša IP adresa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkünse doğrudan bir bağlantı kurar ve aramaları yalnızca doğrulanmamış kişiler için yerinde lokal sunucularınız üzerinden aktarır. IP adresinizi açığa çıkarabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановіть пряме з’єднання, якщо це можливо, і переадресуйте виклики лише неперевіреним контактам через ваші сервери %@. Це може розкрити вашу IP-адресу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可以的话，则建立直接连接，并且只通过 %@ 服务器中继通话到未经核实的联系人。这可能会暴露您的 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可以的話，則建立直接連線，並且僅透過 %@ 伺服器將呼叫中繼至未經驗證的聯絡人。這可能會暴露您的IP位址。"
          }
        }
      }
    },
    "settings_threema_calls_onprem_hide_voip_call_ip_footer_on" : {
      "extractionState" : "manual",
