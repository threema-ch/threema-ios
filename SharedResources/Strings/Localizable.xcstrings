    "multi_device_join_failed_threema_web_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, деактивирайте Настолната версия/Уеб клиента (в Настройки > Настолна версия/Уеб) и опитайте да свържете устройството отново. Ако проблемът продължава, свържете се с екипа по поддръжка (Настройки > Поддръжка)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivujte desktop/web (v nabídce Nastavení > Desktop/web) a zkuste propojit zařízení znovu. Bude-li problém přetrvávat, obraťte se na zákaznickou podporu (Nastavení > Podpora)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte deaktivieren Sie Desktop/Web («Einstellungen > Desktop/Web»), und versuchen Sie nochmals, das Gerät zu verknüpfen. Falls das Problem fortbesteht, wenden Sie sich bitte an den Support («Einstellungen > Support»)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please disable Desktop/Web (in Settings > Desktop/Web), and retry linking the device. If this problem persists, please contact customer support (Settings > Support)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Escritorio/Web (en Ajustes > Escritorio/Web) e intenta volver a vincular el dispositivo. Si el problema persiste, contacta con el servicio de asistencia (Ajustes > Asistencia)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez désactiver la connexion Desktop/Web (« Paramètres » > « Desktop/Web ») et tenter d'associer l'appareil à nouveau. Si ce problème persiste, veuillez contacter l'assistance (« Paramètres » > « Assistance »)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte deaktiviered Sie Desktop/Web («Iistellige > Desktop/Web»), und versueched Sie nomal, s’Grät z’verchnüpfe. Falls s’Problem immerno bestaht, wänded Sie sich bitte an Support («Iistellige > Support»)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Desktop/Web (\"Impostazioni > Desktop/Web\") e riprova a collegare il dispositivo. Se il problema persiste, contatta l'assistenza (\"Impostazioni > Assistenza\")."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップ/ウェブを無効にし（「設定」>「デスクトップ/ウェブ」）、デバイスの接続を再試行してください。問題が解決しない場合は、カスタマーサポート（「設定」 > 「サポート」）までご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크톱/웹을 비활성화하고 (설정 > 데스크톱/웹에서), 디바이스 연결을 다시 시도하세요. 이 문제가 지속되면 고객 지원팀에 문의하세요 (설정 > 지원)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel desktop/web uit (Instellingen > Desktop/Web) en probeer het apparaat opnieuw te koppelen. Neem contact op met de klantenservice als het probleem aanhoudt (Instellingen > Ondersteuning)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz opcję Komputer/sieć (w Ustawienia  > Komputer/sieć) i spróbuj ponownie połączyć urządzenie. Jeśli problem nadal występuje, skontaktuj się z pomocą techniczną (Ustawienia > Pomoc techniczna)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative Desktop/Web (em Configurações > Desktop/Web) e tente vincular o dispositivo novamente. Se o problema persistir, entre em contato com o suporte (Configurações > Suporte)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите веб-клиент / клиент на ПК (в меню \"Настройки > ПК/веб-клиент\") и повторите попытку привязать устройство. Если проблема не исчезнет, обратитесь в службу поддержки  (Настройки > Поддержка)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakážte funkciu Desktop/Web (v ponuke Nastavenia > Desktop/Web) a skúste zariadenie znova prepojiť. Ak tento problém pretrváva, kontaktujte prosím zákaznícku podporu (Nastavenia > Podpora)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen Masaüstü/Web'i devre dışı bırakın (Ayarlar > Masaüstü/Web'de) ve cihazı bağlamayı yeniden deneyin. Bu sorun devam ederse lütfen müşteri hizmetleriyle iletişime geçin (Ayarlar > Destek)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть застосунок / вебверсію («Налаштування» > «Застосунок / вебверсія») і спробуйте повторно прив’язати пристрій. Якщо проблема не зникне, зверніться до служби підтримки («Налаштування > «Підтримка»)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先禁用桌面版/网页版连接（“设置” → “Desktop/Web”），然后重新尝试连接设备。如果问题仍然存在，请联系我们的客户支持（“设置” → “支持”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先停用桌面版/網頁版連線（「設定」 → 「Desktop/Web」），然後重新嘗試連結裝置。 如果問題仍然存在，請聯絡我們的客戶支援（「設定」 → 「支援」）。"
          }
        }
      }
    },
