    "webClientSession_error_wrongVersion_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази iOS версия на приложението не поддържа отдалечения протокол на Threema във Вашето настолно приложение / Вашия уеб клиент."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato verze aplikace pro iOS nepodporuje protokol vzdálené aplikace vaší desktopové aplikace / webového klienta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese iOS-App unterstützt das App Remote Protocol Ihrer Desktop-App bzw. des Web-Client nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iOS app version doesn’t support the App Remote Protocol of your desktop app / the web client."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de la aplicación iOS no admite el protocolo remoto de aplicación de su aplicación de escritorio o cliente web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application iOS ne prend pas en charge l’App Remote Protocol de votre application Desktop/du client Web."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iOS-App unterstützt s’App Remote Protocol vo Ihrere Desktop-App bzw. vom Web-Client nöd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione dell’app iOS non supporta il protocollo remoto della tua app desktop/client web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiOSアプリのバージョンは、デスクトップアプリ／ウェブクライアントのアプリリモートプロトコルには対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iOS 앱 버전은 데스크톱 앱 / 웹 클라이언트의 App Remote Protocol을 지원하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iOS-appversie ondersteunt het protocol van de App Remote voor uw desktop-app/webclient niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja aplikacji iOS nie obsługuje zdalnego protokołu Twojej aplikacji komputerowej/ klienta sieciowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa versão do aplicativo de iOS não é compatível com o Protocolo Remoto de Aplicativo do seu aplicativo para desktop / cliente web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия приложения не поддерживает удаленный протокол приложения для вашего приложения для ПК / веб-клиента."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzia tejto iOS aplikácie nepodporuje vzdialený protokol vašej desktopovej aplikácie / webového klienta."
