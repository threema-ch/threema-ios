    "webClientSession_error_updateServer_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грешка във версията на отдалечения протокол на приложението. Моля, изтеглете най-новата версия на настолното приложение или помолете администратора да актуализира уеб клиента."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špatná verze protokolu vzdálené aplikace, stáhněte si prosím aktuální verzi desktopové aplikace nebo požádejte svého správce o aktualizaci webového klienta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsche Version des App Remote Protocol, bitte laden Sie die aktuelle Version der Desktop-App herunter, oder bitten Sie Ihren Administrator, den Web-Client zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrong App Remote Protocol version, please download the current version of the desktop app, or ask your administrator to update the web client."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión del protocolo remoto de aplicación incorrecta. Descargue la versión más reciente de la aplicación de escritorio o pida al administrador que actualice el cliente web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version d’App Remote Protocol incorrecte, veuillez télécharger la version actuelle de l’application Desktop ou demander à votre administrateur de mettre à jour le client Web."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falschi Version vom App Remote Protocol, bitte ladet Sie di aktuell Version vode Desktop-App abe, oder bitted Sie Ihre Administrator, de Web-Client z’aktualisiere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione errata del protocollo remoto dell’app, scaricare la versione corrente dell’app desktop o chiedere all’amministratore di aggiornare il client web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリリモートプロトコルのバージョンが正しくありません。現在のバージョンのデスクトップアプリをダウンロードするか、管理者にウェブクライアントのアップデートを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 앱 원격 프로토콜 버전입니다. 현재 버전의 데스크톱 앱을 다운로드하거나 관리자에게 웹 클라이언트를 업데이트하도록 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkeerde protocolversie van App Remote. Download de huidige versie van de desktop-app of vraag uw beheerder om de webclient bij te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprawidłowa wersja zdalnego protokołu aplikacji, pobierz aktualną wersję aplikacji komputerowej lub poproś administratora o aktualizację klienta sieciowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão errada do protocolo remoto de aplicativo. Baixe a versão atual do aplicativo para desktop ou peça para o administrador atualizar o cliente web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверная версия удаленного протокола приложения, загрузите текущую версию приложения для ПК или попросите администратора обновить веб-клиент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesprávna verzia vzdialeného protokolu aplikácie, stiahnite si prosím aktuálnu verziu desktopovej aplikácie, alebo sa obráťte na správcu s aktualizáciou webového klienta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanlış Uygulama Uzak Protokol sürümü, lütfen masaüstü uygulamasının mevcut sürümünü indirin veya yöneticinizden web istemcisini güncellemesini isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неправильна версія App Remote Protocol, будь ласка, завантажте поточну версію настільного застосунку або попросіть адміністратора оновити вебклієнт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序远程协议版本有误，请下载桌面版应用程序的当前版，或请求管理员更新网页版客户端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的應用程式遠端協定版本出現錯誤。請下載最新版本的桌面 App，或要求管理員更新網路用戶端。"
          }
        }
      }
    },
