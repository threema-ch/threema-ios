    "safe_version_mismatch" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версията на това резервно копие е по-нова от поддържаната версия. Моля, актуализирайте приложението до последната му версия."
