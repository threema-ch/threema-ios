    "backup_local_recovery_key_confirmation_description" : {
      "comment" : "Description of the local backup recovery key.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte poslední číslice klíče pro obnovení, abyste potvrdili, že jste si ho správně uschovali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie die letzten Ziffern Ihres Wiederherstellungsschlüssels ein, um zu bestätigen, dass Sie ihn korrekt gespeichert haben."
          }
        },
        "en" : {
          "stringUnit" : {
