    "safe_intro_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никога не губете Вашия %@ идентификатор, групите или настройките отново!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už nikdy neztraťte své %@ ID, kontakty, skupiny a nastavení!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlieren Sie nie wieder Ihre %@-ID, Kontakte, Gruppen und Einstellungen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never lose your %@ ID, contacts, groups, and settings again!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No vuelva a perder su ID de %@ ni sus contactos, ajustes o grupos!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne perdez plus jamais votre ID, vos contacts et groupes %@ !"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlüüred Sie nie meh Ihri %@-ID, Kontäkt, Gruppe und Iistellige!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non perdere mai più il tuo %@ ID, i gruppi, i contatti e le impostazioni!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ID・連絡先・グループ・設定を二度と失うことはありません！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ID, 연락처, 그룹 및 설정을 다시 분실하지 마십시오!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlies uw %@ ID of uw contactpersonen en groepen nooit meer!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy więcej nie stracisz swojego ID %@, kontaktów, grup i ustawień!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca perca a sua ID do %@ ou seus contatos e grupos de novo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы больше не потеряете свой ID %@, контакты и группы!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už viac nestraťte vaše %@ ID, kontakty, skupiny a nastavenia!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kimliğinizi, kişilerinizi, gruplarınızı ve ayarlarınızı bir daha asla kaybetmeyin!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше не втрачайте %@ ID, контакти, групи та налаштування!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再也不会丢失您的 %@ ID、联系人、群组和设置了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再也不會丟失您的 %@ ID、聯絡人、群組和設定了！"
          }
        }
      }
    },
