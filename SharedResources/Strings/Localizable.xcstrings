    "image_resize_share_extension" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поради ограничения в хранилището, изображенията изпратени през Share Extension са намалени до макс. 1600 на 1600 пиксела."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzhledem k omezené dostupné paměti jsou obrázky, které posíláte přes rozhraní pro sdílení, zmenšeny na maximálně 1600 × 1600 pixelů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgrund begrenzter Arbeitsspeicher-Ressourcen werden über die Share Extension versendete Bilder verkleinert, so dass sie max. 1600 × 1600 Pixel betragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to limited memory resources, images sent via the Share Extension are downscaled to max. 1600 by 1600 pixels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debido a limitaciones de memoria, las imágenes enviadas a través de Share Extension se reducen en tamaño, hasta 1600 x 1600 píxeles como máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À cause des ressources mémoire limitées, les images envoyées via l’extension Partager sont réduites en échelle à un maximum de 1 600 x 1 600 pixels."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wäge begränzte Arbetsspeicher-Ressource werded über d’Share Extension verschickti Bilder verchlinered, so dass sie max. 1600 × 1600 Pixel händ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dimensioni delle immagini inviate con Share Extension sono ridotte a un massimo di 1600 per 1600 pixel, a causa delle risorse limitate della memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量に限りがあるため、送信された画像は、最大1600×1600ピクセルに縮小されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 리소스 제한으로 전송된 이미지는 최대 1600x1600 픽셀로 축소됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanwege het beperkte geheugen worden afbeeldingen die via de Share Extension worden verzonden, verkleind naar max. 1600 x 1600 pixels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze względu na ograniczone zasoby pamięci obrazy wysyłane za pośrednictwem Udostępnij Rozszerzenie są skalowane do maks. 1600 na 1600 pikseli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devido a recursos de memória limitados, as imagens enviadas pelo Share Extension podem ser reduzidas a um máximo de 1600 x 1600 pixels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В связи с ограниченностью ресурсов изображения, отправляемые через расширение «Поделиться», уменьшаются до размера не более чем 1600 на 1600 пикселов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzhľadom k obmedzenej dostupnej pamäti sú odosielané obrázky cez rozhranie pre zdieľanie zmenšené na maximálne 1600 x 1600 pixelov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırlı bellek kaynakları nedeniyle, paylaşım uzantısı aracılığıyla gönderilen görüntülerin ölçeği maksimum 1600 x 1600 piksel boyutundadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через обмежені ресурси пам’яті, надіслані через Share Extension зображення зменшуються до макс. 1600 на 1600 пікселів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于内存资源有限，通过 “分享扩展” (Share Extension) 发送的图像将被降至最高 1600×1600 像素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於記憶體資源有限，通過「分享擴展」 (Share Extension) 傳送的圖片將降至最高 1600 x 1600 像素。"
          }
        }
      }
    },
