    "contact_list_work_contacts_unavailable_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контактите се изтеглят от сървъра. Ще се появят, когато процесът приключи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty se právě stahují ze serveru. Zobrazí se hned poté, co bude přenos dokončen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte werden vom Server heruntergeladen. Sobald der Vorgang abgeschlossen ist, werden die Kontakte angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacts are currently being downloaded from the server. They will be displayed as soon as the process is complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contactos se están descargando del servidor. Se mostrarán en cuanto finalice el proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contacts se téléchargent depuis le serveur. Ils s’afficheront une fois le processus terminé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontäkt werded grad vom Server abeglade. Sobald de Vorgang abgschlosse isch, werded si aazeigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso lo scaricamento dei contatti dal server. Appena l'operazione sarà terminata, i contatti verranno visualizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、サーバーから連絡先をダウンロード中です。処理が完了するとすぐに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 서버에서 연락처를 다운로드 중입니다. 완료되면 연락처가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De contactpersonen worden momenteel gedownload van de server. Zodra dit proces is voltooid, worden ze weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty są obecnie pobierane z serwera. Zostaną wyświetlone, jak tylko zakończy się ten proces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os contatos estão sendo baixados do servidor. Eles serão exibidos assim que o processo for concluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакты сейчас загружаются с сервера. Они будут отображены, как только процесс завершится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty sa momentálne sťahujú zo servera. Zobrazia sa hneď po dokončení procesu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişiler şu anda sunucudan indiriliyor. İşlem tamamlanır tamamlanmaz görüntülenecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакти завантажуються з сервера просто зараз. Ви зможете їх побачити, щойно процес буде завершено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前正在从服务器下载联系人列表。下载完成后，就会显示完整的联系人列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前正在從伺服器下載聯絡人清單。下載完成後，就會顯示完整的聯絡人清單。"
          }
        }
      }
    },
