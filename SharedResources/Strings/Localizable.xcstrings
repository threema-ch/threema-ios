    "multi_device_linked_duplicate_contacts_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заради дублиращите се контакти (%@), не е възможно да се добави устройство. Моля, свържете се с поддръжката („Настройки > Поддръжка“)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení nelze přidat kvůli duplicitním kontaktům (%@). Kontaktujte podporu („Nastavení > Podpora“)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgrund doppelter Kontakte (%@) lässt sich dieses Gerät nicht verknüpfen. Bitte wenden Sie sich an den Support («Einstellungen > Support»)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to duplicate contacts (%@), it is not possible to add a device. Please contact support (Settings > Support)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debido a la existencia de contactos duplicados (%@), no es posible añadir un dispositivo. Contacte con el servicio de asistencia (Ajustes > Asistencia)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En raison de contacts en double (%@), l'ajout d'un appareil est impossible. Veuillez contacter l'assistance (Paramètres > Assistance)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wäge dopplete Kontäkt (%@) laht sich das Grät nöd verchnüpfe. Bitte wänded Sie sich an Support («Iistellige > Support»)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di contatti duplicati (%@), non è possibile aggiungere un dispositivo. Contatta l'assistenza (\"Impostazioni > Assistenza\")."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先が重複しているため（%@）、端末を追加できません。サポートまでご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중복된 연락처(%@)로 인해 기기를 추가할 수 없습니다. 지원팀에 문의하세요 (\"설정 > 지원\")."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanwege dubbele contacten (%@) kunnen er geen apparaten worden toegevoegd. Neem contact op met onze klantenservice (Instellingen > Ondersteuning)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można dodać tego urządzenia z powodu zduplikowanych kontaktów (%@). Skontaktuj się z pomocą techniczną (Ustawienia > Pomoc techniczna)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível desvincular este dispositivo devido a contatos duplicados (%@). Entre em contato com o suporte (\"Configurações > Suporte\")."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из-за дублирующихся контактов (%@) добавить устройство невозможно. Обратитесь в службу поддержки («Настройки > Поддержка»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dôvodu duplicitných kontaktov (%@) nie je možné pridať zariadenie. Kontaktujte prosím podporu („Nastavenia > Podpora“)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yinelenen kişiler (%@) nedeniyle cihaz eklemek mümkün değil. Lütfen destekle iletişime geçin (“Ayarlar > Destek”)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не можете додати цей пристрій через дублікати контактів (%@). Зверніться до нашої служби підтримки («Налаштування» > «Підтримка»)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于通讯录存在重复的联系人 (%@)，您无法链接此设备。请联系我们的客服。（“设置” > “支持”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於通訊錄存在重複的聯絡人 (%@)，您無法連結此裝置。請直接聯絡我們的支援團隊。（「設定」 → 「支援」）。"
          }
        }
      }
    },
