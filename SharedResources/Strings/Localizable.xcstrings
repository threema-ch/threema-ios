    "chat_view_resend_group_message_confirmation_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това съобщение не може да бъде изпратено на всички членове. Искате ли да изпратите отново съобщението на %@?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odeslání této zprávy všem členům se nezdařilo. Chcete ji uživatelům %@ odeslat znovu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachricht konnte nicht an alle Mitglieder versendet werden. Wollen Sie die Nachricht erneut an %@ senden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message could not be sent to all members. Resend message to %@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje no se ha podido enviar a todos los miembros. ¿Reenviar mensaje a %@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message n’a pas pu être envoyé à tous les membres. Envoyer le message à nouveau à %@ ?"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht hät nöd a all Mitglieder chöne verschickt werde. Wänd Sie die Nachricht nomal a %@ schicke?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile inviare questo messaggio a tutti i membri. Vuoi ripetere l'invio del messaggio a %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージは全員に送信できませんでした。%@にメッセージを再送しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메시지를 모든 구성원에게 보낼 수 없습니다. %@님에게 메시지를 재전송하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bericht is niet naar alle leden verzonden. Het bericht opnieuw verzenden naar %@?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można było wysłać tej wiadomości do wszystkich członków. Wysłać ponownie wiadomość do użytkowników: %@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta mensagem não pôde ser enviada a todos os membros. Reenviar a mensagem para %@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отправить сообщение всем участникам. Повторно отправить сообщение %@?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto správa nemohla byť odoslaná všetkým členom. Opätovne odoslať správu na %@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mesaj tüm üyelere gönderilemedi. Mesaj %@ tekrar gönderilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це повідомлення неможливо надіслати усім учасникам. Надіслати повідомлення лише %@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此消息无法发送到所有群组成员。重新发送消息到%@？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此訊息無法傳送至所有群組成員。重新發送訊息至%@？"
