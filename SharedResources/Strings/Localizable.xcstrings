    "group_is_not_member" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можете да изпращате съобщения към групата, защото вече не сте неин член."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do této skupiny nemůžete odesílat zprávy, jelikož už nejste jejím členem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können keine Nachricht an diese Gruppe senden, weil Sie kein Mitglied der Gruppe mehr sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot send a message to this group because you are not a member anymore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puede enviar un mensaje a este grupo porque usted ya no es miembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas envoyer de message à ce groupe : vous n’en êtes plus membre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie chönd kei Nachricht a die Gruppe schicke, wil Sie keis Mitglied vode Gruppe meh sind."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi inviare un messaggio a questo gruppo perché non ne fai più parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループのメンバーではなくなったため、このグループにメッセージを送ることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹에 메시지를 보낼 수 없습니다. 더 이상 그룹의 멤버가 아니기 때문입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt geen berichten naar deze groep sturen omdat je geen lid meer bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możesz wysłać wiadomości do tej grupy, ponieważ nie jesteś już jej członkiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode enviar uma mensagem para este grupo porque você não é mais um membro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не можете отправить сообщение этой группе, так как вы больше не являетесь ее участником."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tejto skupiny nemôžete odoslať žiadnu správ, pretože už nie ste viac členom tejto skupiny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık üye olmadığınız için bu gruba mesaj gönderemezsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не можете надсилати повідомлення до цієї групи оскільки ви більше не її учасник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您无法发送消息到这个群组，因为您已经不是群组成员了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
