    "threema_safe_company_mdm_password_changed_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искате ли да я приемете? Ако се колебаете, свържете се с Вашия администратор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete jej přijmout? Pokud si nejste jisti, kontaktujte svého správce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie das gegenwärtige Passwort durch das neue, verwaltete ersetzen? Im Zweifelsfall wenden Sie sich bitte an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like to accept it? When in doubt, contact your administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quiere aceptarla? En caso de duda, póngase en contacto con su administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voudriez-vous l'accepter ? Si vous avez des doutes, contactez votre administrateur."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wänd Sie s’gägewärtige Passwort dur s’neue, verwaltete ersetze? Im Zwiifelsfall wändet Sie sich bitte a Ihre Administrator."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi sostituire la password attuale con la nuova password gestita? In caso di dubbio rivolgiti all'amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承諾しますか？判断できないときは管理者にお問い合わせください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수락하시겠습니까? 의심될 때는 꼭 당신의 관리자에게 문의하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je het aanvaarden? Neem in geval van twijfel contact op met je beheerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz je zaakceptować? W razie wątpliwości skontaktuj się ze swoim administratorem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de aceitá-la? Em caso de dúvida, entre em contato com o seu administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите принять его? Если у вас есть сомнения, обратитесь к своему администратору."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete ho prijať? V prípade pochybností sa obráťte na správcu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabul etmek ister misiniz? Şüpeniz varsa, yöneticinizle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бажаєте схвалити його? Якщо маєте сумніви – зв’яжіться з адміністратором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您接受这个新密码吗？如有疑问，请联系您的管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你接受這個新密碼嗎？如有疑問，請聯絡您的管理員。"
          }
        }
      }
    },
