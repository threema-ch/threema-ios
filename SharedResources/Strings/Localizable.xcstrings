    "myprofile_link_email_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свързването на Вашия имейл с идентификатора Ви ще позволи на останалите потребители да Ви намерят в %@ автоматично, ако имат имейла Ви в тяхната адресна книга."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propojení e-mailové adresy s vaším ID umožní ostatním uživatelům, aby vás na %@ automaticky našli, pokud mají váš e-mail v adresáři."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihre E-Mail-Adresse mit Ihrer ID verknüpfen, können andere Benutzer Sie auf %@ automatisch finden, sofern sie Sie im Adressbuch haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linking your email address to your ID lets other users find you on %@ automatically if they have your email in their address book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vincula su dirección de correo electrónico con su ID, otras personas podrán encontrarle automáticamente en %@, siempre que le tengan en la libreta de direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lier votre adresse e-mail à votre ID permet aux autres utilisateurs de vous trouver automatiquement sur %@ si votre e-mail fait partie de leur carnet d’adresses."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihri E-Mail-Adrässe mit Ihrere ID verchnüpfed, chönd anderi Benutzer Sie uf %@ automatisch finde, wenn sie Sie im Adrässbuech händ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegando il tuo indirizzo e-mail al tuo ID, altri utenti possono trovarti automaticamente su %@, se figuri nella loro rubrica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレスとIDを紐付けすることで、他のユーザーが”連絡先”アプリにあなたのメールアドレスを登録していれば、自動的に%@であなたを見つけることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 주소를 ID에 연결하면 다른 사용자들이 당신을 자동으로 %@에서 찾을 수 있습니다. 단, 이메일 주소가 그들의 주소록에 저장되어 있어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je e-mailadres aan je ID koppelt, kunnen anderen je automatisch op %@ vinden als je e-mailadres in hun adresboek staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiązanie adresu email z ID umożliwia innym osobom automatyczne znalezienie Ciebie w %@, jeśli mają Twój adres email w książce adresowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vínculo do seu endereço de e-mail com a sua ID permite que outros usuários lhe encontrem no %@ automaticamente, caso tenham o seu e-mail da agenda deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привязка вашего эл. адреса к ID позволяет другим пользователям автоматически находить вас в %@, если ваш адрес электронной почты есть у них в адресной книге."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak prepojíte vašu emailovú adresu s vaším ID, ostatní používatelia vás automaticky nájdu v aplikácii %@, ak majú váš email vo svojom adresári."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posta adresinizi kimliğinize bağlamak, e-postanız adres defterlerinde varsa diğer kullanıcıların sizi %@ üzerinde otomatik olarak bulmasını sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прив'язання електронної пошти до вашого ID дозволить іншим користувачам знаходити вас у %@ автоматично якщо ваш номер збережено у їхніх контактах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将您的电子邮件地址与您的ID链接，如果其他人的通讯录中有保存您的电子邮件地址，他们将在 %@ 上自动找到您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將您的電子郵件地址與您的ID連結，如果其他人的通訊錄中有儲存您的電子郵件地址，他們將在 %@ 上自動找到您。"
          }
        }
      }
    },
