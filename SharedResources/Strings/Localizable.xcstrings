    "safe_setup_backup_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, изберете силна парола. Ще се нуждаете от тази парола, за да възстановите Вашето %@ резервно копие."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte si prosím silné heslo. Toto heslo bude zapotřebí k obnovení vaší zálohy %@ Safe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein sicheres Passwort. Sie benötigen dieses Passwort, um Ihr %@ Safe-Backup wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please choose a strong password. You will need this password to restore your %@ Safe backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una contraseña. Necesitarás una contraseña para restablecer tu copia de seguridad de %@ Safe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez choisir un mot de passe. Celui-ci sera nécessaire pour restaurer votre sauvegarde %@ Safe."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähled Sie es sichers Passwort. Sie benötiged das Passwort, zum Ihres %@ Safe-Backup wiederherzstelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una password. Ti serve per ripristinare il backup %@ Safe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強力なパスワードを設定してください。このパスワードは、%@ Safeのバックアップを復元する際に必要となります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강력한 암호를 선택하십시오. 이 암호는 %@ Safe 백업을 복원하기 위해 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een wachtwoord. U hebt dit wachtwoord nodig om uw back-upbestanden van %@ Safe te herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz silne hasło. Będziesz potrzebować tego hasła, aby przywrócić kopię zapasową %@ Safe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma senha. Você precisará dessa senha para restaurar seu backup do %@ Safe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите пароль. Этот пароль понадобится вам для восстановления данных из резервной копии %@ Safe."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte prosím silné heslo. Toto heslo budete potrebovať pri obnovení zálohy %@ Safe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen güçlü bir şifre seçin. %@ Safe yedeğinizi geri yüklemek için bu şifreye ihtiyacınız olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, виберіть надійний пароль. Цей пароль знадобиться для відновлення резервної копії %@ Safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
