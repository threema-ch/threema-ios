    "private_delete_info_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато изтривате поверителен чат, новият няма да бъде автоматично маркиран като поверителен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odstranění soukromé konverzace nebude nová konverzace automaticky znovu označena jako soukromá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einen privaten Chat löschen, sind zukünftige Chats nicht auch automatisch privat markiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When deleting a Private Chat, a new one won’t automatically be marked as private again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un chat privado, no se volverá a marcar otro chat como privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En supprimant une discussion privée, la nouvelle discussion ne sera pas automatiquement marquée comme étant privée."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie en private Chat lösched, sind zuekünftigi Chats nöd au automatisch privat markiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cancelli una chat privata, quelle successive non saranno automaticamente indicate come private."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートトークを削除しても、新しいトークが再び自動的にプライベートとしてマークされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 채팅을 삭제할 때, 새로운 채팅은 자동으로 다시 비공개로 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer u een privéchat verwijdert, wordt een nieuwe chat niet automatisch opnieuw als privé aangemerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po usunięciu prywatnego czatu nowy nie będzie automatycznie oznaczony jako prywatny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao excluir uma Conversa Privada, o novo não será marcado como privado automaticamente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении личного чата новый чат больше не будет автоматически помечаться как личный."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri odstraňovaní súkromného rozhovoru sa nový rozhovor automaticky znova neoznačí ako súkromný."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Özel Sohbeti silerken, yenisi otomatik olarak tekrar özel olarak işaretlenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У разі видалення приватного діалогу, новий автоматично не позначатиметься приватним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除私密会话时，新的会话不会再次自动标记为私密会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除私密對話時，新的對話不會再次自動標示為私密對話。"
          }
        }
      }
    },
