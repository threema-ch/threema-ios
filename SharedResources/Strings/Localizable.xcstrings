    "md_wizard_pfs_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy ще бъде деактивиран за всички Ваши контакти, след като активирате предварителния преглед за множество устройства."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktivaci náhledu pro více zařízení se u všech kontaktů zakáže Perfect Forward Secrecy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy wird für alle Kontakte deaktiviert, nachdem Sie die Multi-Device-Vorschau aktiviert haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
