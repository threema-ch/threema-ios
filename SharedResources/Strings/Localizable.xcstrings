    "enter_your_recovery_key_subtitle" : {
      "comment" : "Subtitle for the recovery key entry screen.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte klíč pro obnovení, který vám byl poskytnut během vytváření této zálohy. Tento klíč je nezbytný pro obnovení vaší zálohy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den Wiederherstellungsschlüssel ein, der bei der Erstellung dieses Backups bereitgestellt wurde. Dieser Schlüssel ist erforderlich, um Ihr Backup wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enter the recovery key that was provided when you created this backup. This key is required to restore your backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca la clave de recuperación que se le facilitó al crear esta copia de seguridad. Esta clave es necesaria para restaurar su copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la clé de récupération fournie lors de la création de cette sauvegarde. Cette clé est nécessaire pour restaurer votre sauvegarde."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebed Sie de Widerherstelligsschlüssel ii, wo Sie bi de Erstellig vo dem Backup übercho händ. De Schlüssel bruuchts, zum s’Backup widerherzstelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la chiave di recupero fornita quando hai creato questo backup. Questa chiave è necessaria per ripristinare il tuo backup."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedeklemeyi oluştururken size verilen kurtarma anahtarını girin. Yedeklemenizi geri yüklemek için bu anahtar gereklidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入创建此备份时提供的恢复密钥，恢复备份需要输入此密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入建立此備份時提供的還原金鑰，恢復備份需要輸入此金鑰。"
          }
        }
      }
    },
