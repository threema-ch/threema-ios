    "safe_activation_app_migration_failed_error_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се възстанови %@ Safe резервното копие поради грешка в базата данни. Моля, опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohu %@ Safe nelze obnovit kvůli chybě databáze. Zkuste to prosím znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr %@ Safe-Backup konnte aufgrund eines Datenbankfehlers nicht wiederhergestellt werden. Bitte versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not restore %@ Safe Backup due to a database error. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido restaurar %@ Safe Backup debido a un error en la base de datos. Por favor, inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de restaurer la sauvegarde %@ Safe en raison d'une erreur de base de données. Veuillez réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihres %@ Safe-Backup hät wägeme Datebankfehler nöd chöne wiederhergstellt werde. Bitte versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ripristinare il backup %@ Safe a causa di un errore del database. Per favore riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースのエラーにより、%@ Safeバックアップを復元できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 오류로 %@ Safe 백업을 복원할 수 없습니다. 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@ Safe Backup kon vanwege een databasefout niet worden hersteld. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przywrócić kopii zapasowej %@ Safe z powodu błędu bazy danych. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restaurar o Backup do %@ Safe devido a um erro no banco de dados. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось восстановиться из резервной копии %@ Safe из-за ошибки базы данных. Повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa obnoviť zálohu %@ Safe kvôli chybe databázy. Skúste to prosím znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir veritabanı hatası nedeniyle %@ Safe Backup geri yüklenemedi.  Lütfen tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
