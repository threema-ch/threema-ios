      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DualLock токенът не може да бъде извлечен. Моля, проверете Вашата интернет връзка и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
