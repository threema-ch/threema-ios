    "revocation_password_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С тази парола Вие можете да анулирате Вашия %@ идентификатор от https://myid.threema.ch/revoke. Паролата трябва да е от минимум 8 знака (микс от букви, цифри и символи)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostřednictvím tohoto hesla můžete trvale zrušit svoje %@ ID, a to na stránce https://myid.threema.ch/revoke. Je zapotřebí alespoň 8 znaků (doporučuje se použít kombinaci písmen, číslic a symbolů)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Passwort kann die eigene %@-ID auf https://myid.threema.ch/revoke endgültig widerrufen werden (mindestens 8 Zeichen, Mischung aus Buchstaben, Zahlen und Symbolen empfohlen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With this password you can ultimately revoke your %@ ID via https://myid.threema.ch/revoke. Minimum 8 characters (mix of letters, digits and symbols recommended)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con esta contraseña podrá finalmente revocar su ID de %@ a través de https://myid.threema.ch/revoke. Se recomienda que contenga al menos 8 caracteres y que combine letras, cifras y símbolos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe vous permettra de supprimer votre ID %@ sur https://myid.threema.ch/revoke. Minimum 8 caractères (mélange de lettres, chiffres et symboles recommandé)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Passwort cha di eigeni %@-ID uf https://myid.threema.ch/revoke endgültig widerruefe werde (mind. 8 Zeiche und e Mischig us Buechstabe, Zahle und Symbol sind empfohle)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie a questa password potrai annullare in via definitiva il tuo %@ ID all’indirizzo https://myid.threema.ch/revoke (password di almeno 8 caratteri, composta preferibilmente da lettere, cifre e simboli)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードは、ID失効ページ（https://myid.threema.ch/revoke）にて、%@ IDを永久に無効にさせるために使用されます。最低8文字（アルファベット・数字・記号の組み合わせを推奨）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비밀번호로 https://myid.threema.ch/revoke에서 영구적으로 %@ 아이디를 탈퇴할 수 있습니다. 최소 8자(문자, 숫자, 특수문자 조합 권장)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met dit wachtwoord kun je je %@-ID intrekken via https://myid.threema.ch/revoke. Minimaal 8 lettertekens (mix van letters, cijfers en symbolen wordt aanbevolen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pomocą tego hasła możesz ostatecznie unieważnić swój ID %@ przez https://myid.threema.ch/revoke. Minimum 8 znaków (zalecane połączenie liter, cyfr i symboli)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com esta senha, você pode revogar a sua ID do %@ em definitivo através do https://myid.threema.ch/revoke. Mínimo de 8 caracteres (recomenda-se a mistura de letras, dígitos e símbolos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С помощью этого пароля вы можете окончательно отозвать свой идентификатор %@ через веб-страницу https://myid.threema.ch/revoke. Длина пароля не менее 8 символов (рекомендуется использовать буквы, цифры и специальные символы)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocou tohto hesla môžete natrvalo zrušiť svoje %@ ID prostredníctvom stránky https://myid.threema.ch/revoke. Minimálne 8 znakov (odporúča sa kombinácia písmen, číslic a symbolov)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu şifre ile %@ kimliğinizi https://myid.threema.ch/revoke aracılığıyla iptal edebilirsiniz. Minimum 8 karakter (harf, rakam ve sembollerin) karışımı önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За допомогою цього пароля ви можете остаточно скинути свій ідентифікатор %@ через https://myid.threema.ch/revoke. Мінімум 8 символів (рекомендується поєднання букв, цифр і символів)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了这个密码，您可以通过 https://myid.threema.ch/revoke 彻底撤销您的 %@ ID。最少8个字符（建议混合使用字母、数字和符号）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了這個密碼，您可以透過 https://myid.threema.ch/revoke 徹底撤銷您的 %@ ID。最少8個字元（建議混合使用字母、數字和符號）。"
          }
        }
      }
    },
