        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете використовувати сервер %@ або вказати сторонній сервер резервного копіювання для використання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
