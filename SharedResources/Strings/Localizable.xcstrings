    "updating_database" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Актуализиране на базата данни…\n\nМоля, оставете %@ да работи на преден план докато актуализацията приключи.\n\nТова може да отнеме няколко минути, ако имате дълга чат история."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace databáze…\n\nNechte prosím aplikaci %@ spuštěnou na popředí, dokud operace nedoběhne do konce.\n\nMáte-li velkou historii konverzací, může tato akce trvat i několik minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenbank wird aktualisiert …\n\nBitte lassen Sie %@ im Vordergrund laufen, bis der Vorgang abgeschlossen ist.\n\nJe nach Umfang Ihrer Chatverläufe kann dieser Prozess einige Minuten dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updating database…\n\nPlease keep %@ running in the foreground until completion.\n\nThis may take several minutes if you have a large chat history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizando la base de datos...\n\nMantenga %@ funcionando en segundo plano hasta que se complete la actualización. \n\nPodría tardar varios minutos si su historial de chats es grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour de la base de données…\n\nVeuillez garder %@ en premier plan jusqu'à la fin de l'opération.\n\nCela pourrait prendre plusieurs minutes si vous avez un grand historique de chat."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datebank wird aktualisiert…\n\nBitte lönd Sie %@ im Vordergrund laufe, bis de Vorgang abgschlosse isch.\n\nJe nach Umfang vo Ihrne Chatverläuf cha de Prozess es paar Minute duure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamento banca dati in corso...\n\nMantieni %@ attivo fino al completamento.\n\nNel caso di una cronologia chat di grandi dimensioni, potrebbero volerci diversi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースの更新中...\n\n完了するまでフォアグラウンドで%@を実行したままにしてください。\n\nチャット履歴が多い場合、完了まで数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 업데이트 중...\n\n완료될 때까지 %@를 전경에서 실행 상태로 유지해주세요.\n\n대화 기록이 많은 경우 몇 분이 걸릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Database wordt bijgewerkt...\n\nZorg ervoor dat %@ actief is op de voorgrond totdat het proces is voltooid.\n\nAls u een grote chatgeschiedenis hebt, kan dit een paar minuten duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja bazy danych...\n\n%@ musi cały czas działać na pierwszym planie aż do zakończenia aktualizacji.\n\nW przypadku długiej historii czatu może to potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizando banco de dados…\n\nMantenha o %@ rodando em primeiro plano até a conclusão.\n\nIsso pode levar vários minutos se você tiver um histórico de bate-papo grande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновление базы данных…\n\nДо завершения этой операции приложение %@ должно работать в приоритетном режиме (т.е. не в фоне).\n\nЕсли у вас большая история чата, это может занять несколько минут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje sa databáza…\n\nNechajte %@ spustenú v popredí až do skončenia.\n\nAk máte veľkú históriu konverzácií, môže to trvať niekoľko minút."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veritabanı güncelleniyor…\n\nLütfen %@'yı tamamlanana kadar ön planda çalışır durumda tutun.\n\nBüyük bir sohbet geçmişiniz varsa, bu birkaç dakika sürebilir. "
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення бази даних... \n\nЗастосунок %@ повинен працювати на передньому плані до завершення.\n\nЯкщо у вас велика історія чату, це може зайняти кілька хвилин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在更新数据库...\n\n请保持 %@ 在前台运行直到完成为止。\n\n如果您有大量的聊天记录，可能需要几分钟的时间才能完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在更新資料庫...\n\n請保持 %@ 在前景執行直到完成為止。\n\n如果您有大量的對話記錄，可能需要幾分鐘的時間才能完成。"
          }
        }
      }
    },
    "url_warning_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линкът, който искате да отворите е съмнителен:\n\nИмето на хоста:%@\nИстинското име на хоста:%@\n\nТова може да е опит за измама, който да Ви накара да отворите фалшив сайт, който прилича на истинския.\n\nЖелаете ли да продължите въпреки предупреждението?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název hostitele v odkazu, který se chystáte otevřít, je podezřelý:\n\nZobrazený název hostitele: %@\nSkutečný název hostitele: %@\n\nMůže se jednat o pokus přimět vás podvodem k otevření stránky, která se vydává za nějakou jinou.\n\nChcete přesto pokračovat?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website, die Sie öffnen möchten, ist verdächtig:\n\nAngezeigter Hostname: %@\nTatsächlicher Hostname: %@\n\nEs könnte sich um einen Versuch handeln, Sie auf eine gefälschte Website umzuleiten.\n\nMöchten Sie trotzdem fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hostname of the link you’re about to open is suspicious:\n\nDisplayed Hostname: %@\nReal hostname: %@\n\nThis could be an attempt to trick you into opening a site pretending to be something else.\n\nWould you like to continue anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de host del enlace que va a abrir es sospechoso:\n\nNombre de host mostrado: %@\nNombre de host real: %@\n\nEsto podría ser un intento de engaño para que abra un sitio fingiendo ser otro.\n\n¿Quiere continuar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom de domaine du lien que vous êtes sur le point d’ouvrir est suspect :\n\nNom de domaine affiché : %@\nNom de domaine réel : %@\n\nIl pourrait s’agir d’une tentative d’incitation à ouvrir un site susceptible d’être différent de ce qu’il prétend.\n\nSouhaitez-vous continuer malgré tout ?"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Website, wo Sie wänd öffne, isch verdächtig:\n\nDe aazeigt Hostname: %@\nDe tatsächlich Hostname: %@\n\nEs chönnt sich um en Versuech handle, Sie uf e gfälschti Website umzleite.\n\nWänd Sie trotzdem wiitermache?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hostname del link che stai per aprire è sospetto:\n\nHostname visualizzato: %@\nHostname reale: %@\n\nPotrebbe essere un tentativo per farti aprire un sito, con l’identità di qualcun altro.\n\nVuoi continuare comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開こうとしているリンクのホスト名が不審です。\n\n表示されたホスト名: %@\n本当のホスト名: %@\n\nこれは、別のサイトを装ってあなたを騙そうとしている可能性があります。\n\nとにかく続けてみますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려고 하는 링크의 호스트 이름이 의심스러운 것으로 나타납니다:\n\n표시된 호스트 이름: %@\n실제 호스트 이름: %@\n\n이것은 다른 것을 흉내내는 사이트를 열려고 하는 시도일 수 있습니다.\n\n그래도 계속 하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hostnaam van de link die u wilt openen, is verdacht:\n\nWeergegeven hostnaam: %@\nEchte hostnaam: %@\n\nDit kan een poging zijn om u een nepsite te laten openen.\n\nWil je toch doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa hosta linku, który zamierzasz otworzyć, jest podejrzana:\n\nWyświetlana nazwa hosta: %@\nRzeczywista nazwa hosta: %@\n\nMoże to być próba nakłonienia Ciebie do otwarcia witryny podszywającej się pod coś innego.\n\nCzy chcesz mimo to kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome do host do link que você está prestes a abrir é suspeito:\n\nHome do host exibido: %@\nNome do host real: %@\n\nIsto pode ser uma tentativa para fazer com que você abra um site que finge ser outro.\n\nGostaria de continuar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя хоста ссылки, которую вы собираетесь открыть, вызывает подозрения:\n\nОтображаемое имя хоста: %@\nРеальное имя хоста: %@\n\nВозможно, этот попытка завлечь вас на поддельный сайт.\n\nХотите продолжить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názov hostiteľa odkazu, ktorý sa chystáte otvoriť, je podozrivý:\n\nZobrazený názov hostiteľa: %@\nSkutočný názov hostiteľa: %@\n\nMôže ísť o pokus oklamať vás, aby ste otvorili stránku, ktorá sa vydáva za niečo iné.\n\nChcete aj tak pokračovať?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açmak üzere olduğunuz bağlantının ana bilgisayar adı şüpheli:\n\nGörüntülenen ana bilgisayar adı: %@\nGerçek ana bilgisayar adı: %@\n\nBu, başka bir şeymiş gibi davranan bir site açmanız için sizi kandırma girişimi olabilir.\n\nDevam etmek istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ім’я хоста посилання, яке ви збираєтеся відкрити, підозріле:\n\nПоказане ім'я хоста: %@\nСправжнє ім'я: %@\n\nЦе може бути спробою змусити вас відкрити сайт, прикидаючись іншим сайтом.\n\nВсе одно бажаєте продовжити?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您要打开的链接的主机名有可疑。\n\n显示的主机名：%@\n真实主机名：%@\n\n这可能是试图欺骗您打开一个假装成其他网站的虛假网页。\n\n您仍然要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您要打開的連結的主機名有可疑。\n\n顯示的主機名：%@\n真實的主機名：%@\n\n這可能是試圖欺騙您開啟一個假裝成其他網站的虛假網頁。\n\n您仍然要繼續嗎？"
          }
        }
      }
    },
