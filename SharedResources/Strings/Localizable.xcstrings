    "multi_device_new_linked_own_identity_in_contacts_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият списък с контакти съдържа контакт с Вашия %@ идентификатор. Моля, изтрийте го, за да добавите ново устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve vašem seznamu kontaktů se nachází kontakt s vaším vlastním %@ ID. Chcete-li přidat nové zařízení, musíte tento kontakt odstranit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kontaktliste enthält Ihre %@-ID als Kontakt. Bitte löschen Sie diesen, um ein neues Gerät zu verknüpfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your contact list includes a contact entry with your %@ ID. Please delete it to add a new device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su lista de contactos incluye una entrada de contacto con su ID de %@. Elimínela para añadir un nuevo dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre liste de contacts inclut une entrée de contact comportant votre ID %@. Veuillez la supprimer pour ajouter un nouvel appareil."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihri Kontaktliste enthalted Ihri %@-ID als Kontakt. Bitte lösched Sie de, zum es neus Grät z’verchnüpfe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo elenco dei contatti comprende una voce con il tuo %@ ID. Eliminalo per aggiungere un nuovo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先リストに%@ IDの連絡先エントリが含まれています。新しい端末を追加するには、それを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 연락처 목록에는 귀하의 %@ ID와 관련된 연락처 항목이 포함되어 있습니다. 새로운 기기를 추가하려면 이 항목을 삭제해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw contactenlijst bevat een contactpersoon met uw %@-ID. Verwijder deze contactpersoon om een nieuw apparaat te kunnen toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja lista kontaktów obejmuje pozycję kontaktu z Twoim identyfikatorem %@. Usuń ją, aby dodać nowe urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua lista de contatos inclui uma entrada de contato com seu ID do %@. Exclua para adicionar um novo dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш список контактов включает запись контакта с вашим %@ ID. Удалите его, чтобы добавить новое устройство."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš zoznam kontaktov obsahuje položku kontaktu s vaším %@ ID. Ak chcete pridať nové zariadenie, odstráňte ho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişi listeniz %@ Kimliğinizle birlikte bir kişi girişi içerir. Yeni bir cihaz eklemek için lütfen bu girişi silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш список контактів включає запис із вашим %@ ID. Видаліть його, щоб додати новий пристрій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通讯录中存在与您的 %@ ID 相同的联系人。请删除他以添加新设备。"
          }
