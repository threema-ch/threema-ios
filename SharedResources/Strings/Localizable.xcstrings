        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ID-Export wird nicht mit eingeschlossen, wenn Sie Ihr Gerät via iTunes oder iCloud sichern. Speichern Sie den ID-Export manuell, um ihn nicht zu verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ID export will not be included when you back up your phone via iTunes or iCloud. Save the ID export manually to avoid losing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID exportado no se incluirá cuando haga una copia de seguridad de su teléfono desde iTunes o iCloud. Para no perder dicho ID exportado, guárdela manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation d’ID ne sera pas incluse quand vous sauvegarderez votre téléphone via iTunes ou iCloud. Enregistrez manuellement l’exportation d’ID pour ne pas la perdre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ID-Export wird nöd mit iigschlosse, wenn Sie Ihres Grät via iTunes oder iCloud sichered. Speichered Sie de ID-Export manuell, demit Sie ihn nöd verlüüred."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ID esportato non sarà incluso durante il backup del telefono tramite iTunes o iCloud. Salva manualmente l’ID esportato per evitare di perderlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTunesやiCloudで端末をバックアップする際には、IDのエクスポートは含まれません。IDを失わないように、手動でエクスポートして保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTunes 또는 iCloud를 통해 전화를 백업할 때 ID 내보내기가 포함되지 않을 것입니다. ID 내보내기를 수동으로 저장하여 분실을 피하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ID-exportbestand wordt niet opgenomen als u een back-up van uw telefoon maakt via iTunes of iCloud. Sla het exportbestand handmatig op om het te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport ID nie zostanie uwzględniony podczas tworzenia kopii zapasowej telefonu za pośrednictwem iTunes lub iCloud. Zapisz ręcznie eksport ID, aby go nie utracić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação da ID não será incluído ao fazer o backup do seu telefone através do iTunes ou iCloud. Salve a exportação manualmente para evitar perdê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зашифрованный экспорт ID не будет включен в резервную копию данных на вашем телефоне, созданную через службу iTunes или iCloud. Чтобы предотвратить утерю экспорта ID, сохраните его вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak si odzálohujete váš telefón cez iTunes alebo iCloud, export ID v zálohe nebude zahrnutý. Aby ste predišli jeho strate, uložte si ho ručne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzu iTunes veya iCloud aracılığıyla yedeklediğinizde kimliğin dışa aktarılması bu işleme dahil edilmeyecektir. Kaybetmemek için lütfen manuel olarak kaydedin."
