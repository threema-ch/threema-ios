    "multi_device_new_linked_devices_limitation_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бележка: За момента само един компютър може да бъде свързан с бета версията. Свързването с друго iPhone/iPad или Android устройство не се поддържа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: Momentálně lze s beta verzí propojit pouze jeden počítač. Propojení dalšího iPhonu/iPadu nebo zařízení s Androidem není podporováno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Momentan kann mit der Beta-Version nur ein Computer verknüpft werden. Das Verknüpfen von einem zweiten iPhone/iPad oder einem Android-Gerät wird nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: At the moment, only one computer can be linked with the beta version. Linking another iPhone/iPad or an Android device is not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Por el momento, solo se puede vincular un ordenador con la versión beta. No es posible vincular otro iPhone/iPad ni un dispositivo Android."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : pour l'instant, un seul ordinateur peut être associé à la version bêta. Il n'est pas possible d'associer un autre iPhone/iPad ou un appareil Android."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiiwis: Momentan cha mit de Beta-Version nur ein Compi verchnüpft werde. S’Verchnüpfe vomene zweite iPhone/iPad oder eme Android-Grät wird nöd unterstützt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: al momento, con la versione beta, può essere collegato un solo computer. Il collegamento di un altro dispositivo iPhone/iPad o Android non è supportato,"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：現在、ベータ版と紐付けられるのは1台のコンピュータのみです。他のiPhone/iPadやAndroid端末との紐付けには対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 현재 베타 버전에서는 컴퓨터 한 대만 연결할 수 있습니다. 다른 iPhone/iPad 또는 Android 기기를 연결하는 것은 지원되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: op dit moment kan slechts één computer binnen de bètaversie worden gekoppeld. Een andere iPhone/iPad of Android-apparaat koppelen wordt niet ondersteund."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: W tej chwili tylko jeden komputer może być połączony z wersją beta. Połączenie kolejnego urządzenia iPhone/iPad lub Android nie jest obsługiwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: no momento, apenas um computador pode ser vinculado com a versão beta. Não é suportada a vinculação de outro iPhone/iPad ou dispositivo Android."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание. В настоящее время выполнить привязку к бета-версии можно только для одного компьютера. Привязка еще одного устройства iPhone/iPad или Android не поддерживает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: V súčasnosti je možné s beta verziou prepojiť iba jeden počítač. Prepojenie iného iPhone/iPad alebo Android zariadenia nie je podporované."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not: Şu anda yalnızca bir bilgisayar beta sürümüyle ilişkilendirilebilir. Başka bir iPhone/iPad veya Android cihaz bağlantısı desteklenmemektedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: у бета-версії можна прив’язати лише один пристрій. Прив’язування ще одного пристрою iPhone/iPad або Android не підтримується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：当前的测试版只能连接一台电脑，但不支持链接其他 iPhone / iPad 或 Android 设备。"
          }
