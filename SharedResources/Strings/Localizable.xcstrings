    "multi_device_join_perfect_forward_secrecy_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато свържете устройство, Perfect Forward Secrecy ще бъде деактивирана за всички контакти.\n\nТова е ограничение за настоящата бета версия. За да разберете по-подробно за ограниченията, консултирайте се с [ЧЗВ/FAQ] на (%@)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při propojení zařízení se všem kontaktům zakáže funkce Perfect Forward Secrecy.\n\nJedná se o omezení aktuální beta verze. Podrobnější informace o omezeních najdete v [této sekci Častých dotazů](%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie ein Gerät verknüpfen, wird Perfect Forward Secrecy für alle Kontakte deaktiviert.\n\nDies ist eine Einschränkung der aktuellen Beta-Version. Weitere Einschränkungen sind in [dieser FAQ](%@) aufgelistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you link a device, Perfect Forward Secrecy will be disabled for all contacts.\n\nThis is a limitation of the current beta version. For more limitations, please refer to [this FAQ entry](%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al vincular un dispositivo, Perfect Forward Secrecy se desactivará en todos los contactos.\n\nEs una limitación de la versión beta actual. Para obtener más información sobre las limitaciones, consulte [esta entrada de las Preguntas frecuentes](%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En associant un appareil, la Confidentialité de transmission parfaite sera désactivée pour tous les contacts.\n\nIl s'agit d'une limitation de la version bêta actuelle. Pour en savoir plus sur les limitations, veuillez vous référer à [cette entrée de la FAQ](%@)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie es Grät verchnüpfed, wird Perfect Forward Secrecy für all Kontäkt deaktiviert.\n\nDas isch e Ischränkig vode aktuelle Beta-Version. Wiiteri Ischränkige sind i [dere FAQ](%@) ufglischted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando colleghi un dispositivo, Perfect Forward Secrecy verrà disattivato per tutti i contatti.\n\nQuesto è un limite dell'attuale versione beta. Per ulteriori limiti, fai riferimento a [questa Domanda frequente](%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末を紐付けすると、Perfect Forward Secrecyはすべての連絡先で無効になります。\n\nこれは現在のベータ版の制限です。その他の制限については、[こちらのよくある質問]（%@）を参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기를 연결하면 모든 연락처에 대해 완벽한 전달 보안이 비활성화됩니다.\n\n현재 베타 버전의 제한 사항입니다. 더 많은 제한 사항은 이 FAQ 항목을 참조하십시오(%@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer u een apparaat koppelt wordt Perfect Forward Secrecy voor alle contactpersonen uitgeschakeld.\n\nDit is een van de beperkingen van de huidige bètaversie. Voor de andere beperkingen, zie [deze FAQ](%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy połączysz urządzenie, funkcja Perfect Forward Secrecy będzie wyłączona dla wszystkich kontaktów.\n\nJest to ograniczenie bieżącej wersji beta. Więcej ograniczeń opisuje ten [punkt najczęściej zadawanych pytań] (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao vincular um dispositivo, Perfect Forward Secrecy será desativado para todos os contatos.\n\nEsta é uma limitação da versão beta atual. Para saber mais sobre as limitações, consulte [este FAQ](%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы привязываете устройство, протокол Perfect Forward Secrecy отключается для всех контактов.\n\nЭто ограничение текущей бета-версии. Дополнительные сведения об ограничениях см. в [этом пункте вопросов и ответов](%@)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď prepojíte zariadenie, funkcia Perfect Forward Secrecy bude pre všetky kontakty vypnutá.\n\nIde o obmedzenie aktuálnej beta verzie. Ďalšie obmedzenia nájdete v [tejto položke FAQ](%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir cihazı bağladığınızda Mükemmel İletme Gizliliği tüm kişiler için devre dışı bırakılır.\n\nBu işlem mevcut beta versiyonunun bir sınırlamasıdır. Daha fazla sınırlama için lütfen [SSS](%@) girişine bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви прив’яжете пристрій, функцію «Цілковита пряма секретність» буде вимкнено для всіх контактів.\n\nЦе обмеження поточної бета-версії. Щоб дізнатися про інші обмеження, ознайомтесь із [цією статтею поширених запитань](%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您链接新设备时，将对所有联系人禁用完全正向保密。\n\n这是当前测试版的限制。如想知道更多其他的限制，请参阅[这条常见问题解答条目](%@)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您連結新裝置時，將對所有聯絡人停用完全正向保密。\n\n這是當前測試版的限制。如想知道更多其他的限制，請參閱[這則常見問題解答條目](%@)。"
          }
        }
      }
    },
