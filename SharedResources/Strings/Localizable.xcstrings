    "level0_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непознат контакт, който не си е свързал телефонния номер и/или имейла с неговия идентификатор или във Вашия списък с контакти няма информация за него."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neznámý kontakt; buď tento kontakt nepropojil telefonní číslo ani e-mailovou adresu se svým ID, nebo váš adresář údaje o tomto kontaktu neobsahuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannter Kontakt; dieser Kontakt hat entweder seine ID weder mit einer Rufnummer noch mit einer E-Mail-Adresse verknüpft, oder Ihr Adressbuch enthält diese Angaben nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown contact; either this contact did not link a phone number nor an email address to their ID, or your address book does not contain these contact details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacto desconocido; o bien el contacto no vinculó un número de teléfono ni una dirección de correo electrónico a su ID o los detalles de este contacto no están en su libreta de direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact inconnu ; ce contact n’a lié ni numéro de téléphone ni adresse e-mail à son ID ou votre carnet d’adresses ne contient pas ces coordonnées."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte Kontakt; de Kontakt hät entweder sini ID weder mitere Handynummere no mitere E-Mail-Adrässe verchnüpft, oder i Ihrem Adrässbuech sind die Aagabe nöd drin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contatto sconosciuto; il presente contatto non ha collegato il suo ID né con un numero di telefono né con un indirizzo e-mail, oppure questi dati non sono presenti nella tua rubrica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不明な連絡先: この連絡先が自分のIDに電話番号やメールアドレスを紐付けしていないか、アドレス帳にこれらの連絡先の詳細が含まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없는 연락처; 이 연락처는 전화번호나 이메일 주소를 ID에 연결하지 않았거나, 또는 주소록에 이러한 연락처 정보가 포함되어 있지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onbekende contactpersoon; deze contactpersoon heeft geen telefoonnummer of e-mailadres aan zijn/haar ID gekoppeld, of je adresboek bevat de contactgegevens niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieznany kontakt; albo ten kontakt nie połączył numeru telefonu ani email z ID, lub twoja książka adresowa nie zawiera tych danych kontaktowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contato desconhecido: o contato não vinculou um número de telefone ou um endereço de e-mail ao ID, ou o seu catálogo de endereços não contém estas informações de contato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неизвестный контакт: либо этот контакт не привязал номер телефона и адрес эл. почты к своему идентификатору, либо в вашей адресной книге отсутствуют данные этого контакта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neznámy kontakt: buď tento kontakt nepripojil telefónne číslo ani emailovú adresu ku svojmu ID, alebo váš adresár neobsahuje detaily o tomto kontakte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinmeyen kişi; bu kişi kimliğine telefon numarası veya e-posta adresi bağlamadı ya da adres defteriniz bu iletişim bilgilerini içermiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невідомий контакт; цей контакт або не прив’язав номер телефону чи адресу електронної пошти до свого ID, або ваша адресна книга не містить цих контактних даних."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未知联系人；该联系人没有将电话号码或电子邮件地址链接到其ID，或者您的通讯录没有保存该联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未知聯絡人；該聯絡人沒有將電話號碼或電子郵件地址連結至其ID，或者您的通訊錄沒有儲存該聯絡人。"
          }
        }
      }
    },
