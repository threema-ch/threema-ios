        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desea eliminar permanentemente los archivos huérfanos? Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaitez-vous supprimer définitivement les fichiers orphelins ? Cette action est irréversible."
