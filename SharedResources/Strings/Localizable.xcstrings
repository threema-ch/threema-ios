    "safe_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активирайте %@ Safe, за да създадете автоматични, сигурни и анонимни резервни копия на всичките Ви важни данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolením %@ Safe vytvoříte automatické zabezpečené a anonymní zálohy všech vašich důležitých dat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie %@ Safe für automatische, sichere und anonyme Backups Ihrer wichtigsten Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable %@ Safe to create automatic secure and anonymous backups of all your important data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite %@ Safe para crear copias de seguridad automáticas, seguras y anónimas de todos sus datos importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez %@ Safe pour créer des sauvegardes automatiques, sécurisées et anonymes de toutes vos données importantes."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviered Sie %@ Safe für automatischi, sicheri und anonymi Backups vo Ihrne wichtigste Date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita %@ Safe per creare automaticamente backup sicuri e anonimi di tutti i tuoi dati importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeを有効にすると、すべての重要なデータを自動的に安全・匿名にバックアップすることができます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz %@ Safe, aby utworzyć automatycznie, bezpieczne i anonimowe kopie zapasowe wszystkich ważnych danych."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivujte %@ Trezor a vytvárajte automatické, bezpečné a anonymné zálohy všetkých vašich dôležitých údajov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm önemli verilerinizin otomatik, güvenli ve anonim yedeklerini oluşturmak için %@ Safe özelliğini etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть %@ Safe, щоб автоматично створювати безпечні та анонімні резервні копії всіх ваших важливих даних."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 %@ Safe 可以自动为所有重要数据创建安全和匿名备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 %@ Safe 可以自動為所有重要資料建立安全和匿名的備份。"
          }
        }
      }
    },
    "safe_disable_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искате ли да продължите без активен %@ Safe? Когато използвате %@ Safe, Вие можете да възстановите Вашия %@ идентификатор, контактите и групите, ако загубите достъп до Вашето устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete pokračovat bez povolení %@ Safe? Při použití %@ Safe si můžete v případě ztráty přístupu k zařízení obnovit své %@ ID, kontakty a skupiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wollen Sie fortfahren, ohne %@ Safe zu aktivieren?\n%@ Safe erlaubt, Ihre %@-ID, Kontakte und Gruppen wiederherzustellen, falls Sie Ihr Gerät verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you want to continue without enabling %@ Safe? When using %@ Safe, you can restore your %@ ID, contacts and groups in case you lose access to your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quiere continuar sin activar %@ Safe?\nAl utilizar %@ Safe, podrá restaurar su ID de %@, contactos y grupos si pierde el acceso a su dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment continuer sans activer %@ Safe ?\nEn utilisant %@ Safe, vous pouvez restaurer votre ID, vos contacts et vos groupes %@ au cas où vous perdiez l'accès à votre appareil."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wänd Sie wiitermache, ohni %@ Safe z’aktiviere? Mit %@ Safe chönd Sie Ihri %@-ID, Kontäkt und Gruppe wiederherstelle, falls Sie Ihres Grät verlüüred."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi veramente continuare senza abilitare %@ Safe? In caso di perdita del dispositivo %@ Safe ti consente di ripristinare il tuo %@ ID, i tuoi contatti e gruppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeを有効にせずに続行しますか？\n%@ Safeを利用すると、万が一端末にアクセスできなくなった場合に%@ IDや連絡先、グループを復元することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe를 활성화하지 않고 계속 진행하시겠습니까?\n%@ Safe를 사용하면 기기 액세스를 잃은 경우 %@ ID, 연락처 및 그룹을 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilt u doorgaan zonder %@ Safe in te schakelen? \nWanneer u %@ Safe gebruikt, kun u uw %@-ID, contactpersonen en groepen herstellen in het geval dat u toegang tot uw apparaat verliest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz kontynuować bez włączania %@ Safe? Korzystając z %@ Safe możes przywrócić swój identyfikator %@, kontakty i grupy, jeśli utracisz dostęp do urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja continuar sem habilitar o %@ Safe? Usando o %@ Safe, você pode restaurar a sua ID do %@, contatos e grupos caso perca o acesso ao seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действительно продолжить без активации %@ Safe? При использовании %@ Safe вы можете восстановить свой %@ ID, контакты и группы в случае, если вы утратите доступ к своему устройству."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete pokračovať bez aktivácie Trezoru %@?\nPri používaní Trezoru %@ môžete obnoviť svoje %@ ID, kontakty a skupiny v prípade straty prístupu k zariadeniu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe'i etkinleştirmeden devam etmek istiyor musunuz?\n%@ Safe'i kullanırken, cihazınıza erişiminizi kaybetmeniz durumunda %@ Kimliğinizi, kişilerinizi ve gruplarınızı geri yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви бажаєте продовжити не вмикаючи %@ Safe? \nЗа використання %@ Safe ви зможете відновити свій %@ ID, контакти та групи у випадку, якщо ви втратили доступ до свого пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要在不启用 %@ Safe 的情况下继续吗？\n当使用 %@ Safe 时，您可以恢复您的 %@ ID、联系人和群组，以防您失去设备的访问权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要在不開啟 %@ Safe 的情況下繼續嗎？\n當使用 %@ Safe 時，您可以還原您的 %@ ID、聯絡人和群組，以防您失去裝置的存取權。"
          }
        }
      }
    },
    "safe_enable_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко от което се нуждаете, за да чатите, е запазено само на Вашето устройство. Вие нямате регистрация и ние не можем да Ви помогнем, ако си изгубите телефона или случайно си изтриете данните.\n\n%@ Safe създава автоматично резервно копие на всички важни данни, като ключове, контакти и групи, анонимно на сигурен сървър, който Вие си избирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše, co se týká konverzací, je uloženo pouze ve vašem zařízení. Nemáte u nás účet a nemůžeme vám pomoci, pokud ztratíte svůj telefon nebo nechtěně odstraníte svá data.\n\n%@ Safe vytváří automatické zálohy všech důležitých dat včetně vašich šifrovacích klíčů, seznamu kontaktů a členství ve skupinách (ale bez obsahu zpráv) anonymně a na zabezpečeném serveru podle vašeho výběru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Sie zum Chatten benötigen, wird ausschliesslich auf Ihrem Gerät gespeichert. Bei uns haben Sie kein zentrales Benutzerkonto, und wir können Ihnen nicht helfen, wenn Sie Ihr Handy verlieren oder versehentlich Ihre Daten löschen.\n\n%@ Safe erstellt regelmässig automatische Backups aller wichtigen Daten, einschliesslich Ihrer Schlüssel, Ihrer Kontaktliste und Ihrer Gruppenmitgliedschaften, und speichert sie anonym auf einem sicheren Server Ihrer Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All you need to chat is stored only on your device. You don’t have an account with us, and we cannot help you out if you lose your phone or accidentally delete your data.\n\n%@ Safe regularly creates automatic backups of all the important data, including your keys, your contact list, and your group memberships, anonymously on a secure server of your choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que necesita para usar el chat se almacena solo en su dispositivo. No tiene cuenta con nosotros y no podemos ayudarle si pierde el teléfono o elimina sus datos por accidente.\n\n%@ Safe crea regularmente copias de seguridad automáticas de todos los datos importantes, incluidas sus claves, su lista de contactos y sus afiliaciones a grupos, de forma anónima en el servidor seguro que elija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qu’il vous faut pour discuter n’est stocké que sur votre appareil. Vous n’avez pas de compte enregistré chez nous et nous ne pouvons pas vous aider si vous perdez votre téléphone ou si vous supprimez vos données par mégarde.\n\n%@ Safe crée des sauvegardes automatiques de toutes les données importantes, y compris vos clés, votre liste de contacts et vos abonnements de groupes, et ce de manière anonyme sur un serveur sécurisé de votre choix."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Sie zum chatte bruched, isch nume uf Ihrem Grät gspeicheret. Es git keis zentrals Benutzerkonto, und falls Sie Ihres Handy verlüred oder us Versehe Ihri Date lösched, chönd mir die Date nüme wiederherstelle.\n\n%@ Safe erstellt regelmässig automatischi Backups vo all ihrne wichtige Date, inklusive Ihri Schlüssel, Ihri Kontaktliste und Ihri Gruppemitgliedschafte, und speichered si anonym ufeme sichere Server Ihrer Wahl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto quello che ti serve per la chat viene archiviato solo nel tuo dispositivo. Non possiedi un nostro account e non potremo aiutarti in caso di smarrimento del telefono o cancellazione accidentale dei tuoi dati. \n\n%@ Safe crea automaticamente i backup di tutti i dati importanti (come le chiavi, la lista contatti e il tuo gruppo di iscrizione) in un server sicuro di tua scelta e in modo anonimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークに必要なものは、あなたのデバイスにのみ保存されます。あなたは私たちのアカウントを持っていないので、携帯電話を紛失したり、誤ってデータを削除したりしても、私たちはあなたを助けることができません。\n\n%@ Safeはあなたが選んだ安全なサーバーに、あなたのキー・連絡先リスト・グループメンバーなど、すべての重要なデータの自動バックアップを匿名で作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅에 필요한 모든 정보는 귀하의 기기에만 저장됩니다. 당사와 계정이 없으며 휴대폰을 잃거나 데이터를 실수로 삭제한 경우 도움을 드릴 수 없습니다.\n\n%@ Safe는 귀하의 키, 연락처 목록 및 그룹 멤버십을 포함한 모든 중요한 데이터를 귀하의 선택한 안전한 서버에 익명으로 자동 백업합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat u nodig hebt om te chatten wordt alleen op uw apparaat opgeslagen. U hebt geen account bij ons en we kunnen u niet helpen als u uw telefoon verliest of per ongeluk uw gegevens verwijdert.\n\n%@ Safe maakt automatisch back-ups aan van alle belangrijke gegevens, inclusief uw sleutelcodes, uw lijst met contactpersonen en uw groepslidmaatschappen, anoniem en op een beveiligde server van uw keuze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, czego potrzebujesz do czatu, jest przechowywane tylko na Twoim urządzeniu. Nie masz u nas konta i nie możemy Ci pomóc, jeśli zgubisz telefon lub przypadkowo usuniesz swoje dane.\n\n%@ Safe tworzy automatycznie kopie zapasowe wszystkich ważnych danych, w tym kluczy, listy kontaktów i członkostwa w grupach, anonimowo na wybranym przez Ciebie bezpiecznym serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você precisa para conversar somente é armazenado no seu dispositivo. Você não tem uma conta conosco, e não podemos ajudar se você perder seu telefone ou excluir acidentalmente os seus dados.\n\nO %@ Safe cria backups automáticos de todos os dados importantes, incluindo suas chaves, lista de contatos e associações de grupo de forma anônima em um servidor seguro da sua escolha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, что вам нужно для чата, хранится на вашем устройстве. У вас нет нашей учетной записи, и мы не сможем помочь вам, если вы потеряете телефон или случайно удалите данные.\n\n%@ Safe создает автоматические резервные копии всех важных данных, в том числе ваших ключей, вашего списка контактов и групп. Данные в анонимном виде хранятся на выбранном вами защищенном сервере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko, čo potrebujete ku komunikácii je uložené v tomto zariadení. U nás nemáte žiadny účet a v prípade, že stratíte váš telefón alebo omylom vymažete všetky údaje, nebudeme vám vedieť pomôcť.\n\nTrezor %@ vykonáva automatické zálohovanie všetkých dôležitých údajov vrátane vašich šifrovacích kľúčov, zoznamu kontaktov a členstva v skupinách (bez obsahu správ) a to anonymne na zabezpečom serveri podľa vašeho výberu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet etmek için ihtiyacınız olan tek şey yalnızca cihazınızda saklanır. Bizde bir hesabınız yok ve telefonunuzu kaybederseniz veya verilerinizi yanlışlıkla silerseniz size yardımcı olamayız.\n\n%@ Safe, seçtiğiniz güvenli bir sunucuda anonim olarak anahtarlarınız, kişi listeniz ve grup üyelikleriniz dahil tüm önemli verilerin otomatik yedeklerini oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, що вам потрібно для спілкування, зберігається лише на вашому пристрої. Ми не зберігаємо ваш обліковий запис, отже не зможемо допомогти вам, якщо ви втратите телефон або випадково видалите свої дані.\n\n%@ Safe створює автоматичні резервні копії всіх важливих даних, зокрема ключів, списку контактів та участі у групах, анонімно на захищеному сервері на ваш вибір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您会话关连的所有数据只存储在您的设备上。因为我们没有保存您的帐户，所以如果您丢失了手机或意外删除了数据，我们将无法为您提供帮助。\n\n%@ Safe 在您选择的安全服务器上，以匿名方式创建所有重要数据的自动备份，包括您的密钥，联系人列表和群组成员身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您對話相關的所有資料只儲存在您的裝置上。因為我們沒有儲存您的帳戶，所以如果您丢失了電話或意外刪除了資料，我们將無法為您提供協助。\n\n%@ Safe 在您選擇的安全伺服器上，以匿名方式建立所有重要資料的自動備份，包括您的金鑰，聯絡人清單和群組成員身份。"
          }
        }
      }
    },
    "safe_enable_explain_short" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
