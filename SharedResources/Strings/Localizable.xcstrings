    "id_confirm_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият %@ идентификатор е като телефонен номер. Вашите приятели могат да се свържат с Вас чрез този идентификатор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše %@ ID funguje stejně jako telefonní číslo. Prostřednictvím tohoto ID vás mohou kontaktovat vaši přátelé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre %@-ID funktioniert wie eine Telefonnummer. Ihre Freunde können Sie über diese ID erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ ID works just like a phone number. Your friends can reach you through this ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su ID de %@ funciona como un número de teléfono. Sus amigos pueden ponerse en contacto con usted a través de este ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ID %@ fonctionne comme un numéro de téléphone. Vos amis peuvent l’utiliser pour vous joindre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihri %@-ID funktioniert wie e Telefonnummere. Ihri Fründe chönd Sie über die ID erreiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il %@ ID funziona proprio come un numero di telefono. I tuoi amici potranno usarlo per raggiungerti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの%@ IDは、電話番号のように機能します。お友達はこのIDであなたに連絡を取ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 %@ ID는 전화번호처럼 작동합니다. 당신의 친구들은 이 ID를 통해 당신에게 연락할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je %@ ID werkt net als een telefoonnummer. Je vrienden kunnen je via dit ID bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój ID %@ działa jak numer telefonu. Twoi znajomi mogą się z tobą skontaktować za pomocą tego ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua ID do %@ funciona como um número de telefone. Seus amigos podem encontrar você por meio dessa ID."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ID аналогичен номеру телефона. По этому идентификатору с вами смогут связаться ваши друзья."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše %@ ID funguje ako telefónne číslo. Vaši priatelia vás môžu kontaktovať pomocou tohto ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kimliğiniz tıpkı bir telefon numarası gibi çalışır. Arkadaşlarınız size bu kimlik üzerinden ulaşabilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш %@ ID працює як номер телефону. Ваші друзі можуть зв’язатися з вами за допомогою цього ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 %@ ID 就像电话号码一样。您的朋友可以通过这个ID联系您。"
