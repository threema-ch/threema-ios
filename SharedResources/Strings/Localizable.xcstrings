    "doNotDisturb_mention_footer_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако функцията „моля, не безпокойте“ е включена, Вие няма да получавате никакви известия, дори и когато сте споменат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebudete dostávat žádná oznámení, a to ani v případech, kdy vás někdo zmíní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn «Nicht stören» aktiv ist, erhalten Sie keine Benachrichtigungen, auch nicht, wenn Sie erwähnt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If do not disturb is on, you will receive no notifications at all, not even when you are mentioned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recibirá ningún tipo de notificación, ni siquiera cuando alguien le mencione."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevrez aucune notification, même lorsque vous êtes mentionné."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn «Nöd störe» aktiv isch, chömed Sie kei Benachrichtigunge über, au nöd, wenn Sie erwähnt werded."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riceverai alcuna notifica, nemmeno se vieni citato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分が言及されていても、一切の通知は受け取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방해 금지 모드가 켜져 있으면 언급될 때조차도 전혀 알림을 받지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U ontvangt geen meldingen, zelfs niet als u wordt genoemd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będziesz otrzymywać żadnych powiadomień, nawet jeśli zostaniesz wymieniony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não receberá nenhuma notificação - nem mesmo quando for mencionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не будете получать уведомлений, даже если вас упомянули."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnutý režim Nerušiť, nedostanete vôbec žiadne hlásenia, dokonca ani keď vás niekto zmieni."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahatsız etmeyin açıksa, sizden bahsedilse bile hiçbir bildirim almazsınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено не турбувати, ви не отримуватимете жодних сповіщень, навіть коли вас хтось згадує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您打开了 “请勿打扰” ，您不会收到任何通知。即使是在有人提及您时，也不会收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您開啟了「請勿打擾」，您不會收到任何通知。即使是在有人提及您時，也不會收到通知。"
          }
        }
      }
    },
    "doNotDisturb_mention_footer_on" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако функцията „моля, не безпокойте“ е включена, Вие ще получавате известия, когато сте споменат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
