    "backup_exclude" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортирането на идентификатора няма да бъде включено, ако правите резервно копие на телефона през iTunes или iCloud. Запазете идентификатора ръчно, за да избегнете загубата му."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zazálohujete svůj telefon přes iTunes nebo iCloud, nebude součástí těchto dat export ID. Nechcete-li o své ID přijít, uložte si export ID ručně."
