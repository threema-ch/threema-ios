    "md_wizard_connection_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докато тече процесът по свързване, обажданията и известията са деактивирани."
          }
        },
        "cs" : {
          "stringUnit" : {
