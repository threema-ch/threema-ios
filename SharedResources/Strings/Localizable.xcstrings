    "safe_expired_notification" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашето %@ Safe резервно копие може би е старо и може да бъде изтрито скоро. Моля, проверете %@ Safe настройките и се уверете, че %@ Safe резервното копие може да бъде създадено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost vaší zálohy %@ Safe může být zastaralá a brzy může být odstraněna ze serveru. Zkontrolujte prosím nastavení %@ Safe a ujistěte se, že lze vytvořit zálohu %@ Safe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr %@ Safe-Backup ist möglicherweise nicht mehr aktuell und wird ggf. gelöscht. Bitte überprüfen Sie die %@ Safe-Einstellungen, und stellen Sie sicher, dass ein %@ Safe-Backup erstellt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ Safe backup might be outdated and could be deleted soon. Please check the %@ Safe settings and make sure a %@ Safe backup can be created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su copia de seguridad %@ Safe puede estar desactualizada y se eliminará pronto. Por favor, compruebe los ajustes de %@ Safe y asegúrese de que se pueda crear una copia de seguridad %@ Safe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sauvegarde %@ Safe pourrait être obsolète et bientôt supprimée. Veuillez vérifier les paramètres %@ Safe et veillez à ce qu’une sauvegarde %@ Safe puisse être créée."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihres %@ Safe-Backup isch möglicherwiis nüme aktuell und wird ggf. glöscht. Bitte überprüefed Sie d’%@ Safe-Iistellige und stelled Sie sicher, dass es %@ Safe-Backup erstellt werde chan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo backup %@ Safe potrebbe essere scaduto e pertanto venire eliminato entro breve. Verifica le impostazioni %@ Safe e crea un nuovo backup %@ Safe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの%@ Safeのバックアップは古く、すぐに削除される可能性があります。%@ Safeの設定を確認し、%@ Safeのバックアップが作成できるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe 백업이 오래되어 곧 삭제될 수 있습니다. %@ Safe 설정을 확인하고 %@ Safe 백업을 생성할 수 있도록 해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw back-up van %@ Safe kan zijn verlopen en wordt binnenkort misschien verwijderd. Controleer de instellingen voor %@ Safe en zorg ervoor dat een nieuw back-upbestand voor %@ Safe kan worden aangemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja kopia zapasowa %@ Safe może być nieaktualna i wkrótce może zostać usunięta. Sprawdź ustawienia %@ Safe, upewnij się czy można utworzyć kopię zapasową %@ Safe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu backup do %@ Safe pode estar desatualizado e ser excluído em breve. Verifique as configurações do %@ Safe e certifique-se de que um backup do %@ Safe possa ser criado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша резервная копия %@ Safe устарела и вскоре будет удалена с сервера. Проверьте настройки %@ Safe и убедитесь, что возможно создать новую резервную копию %@ Safe."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša záloha Trezoru %@ sa zdá byť zastaralá a čoskoro môže byť vymazaná. Skontrolujte prosím nastavenia %@ Safe a uistite sa, či je možné vytvárať %@ Safe zálohu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe yedeklemeniz eski olabilir ve yakında silinebilir. Lütfen %@ Safe ayarlarını kontrol edin ve %@ Safe yedeğinin oluşturulabildiğinden emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша резервна копія %@ Safe може бути застарілою та незабаром може бути видалена. Перевірте налаштування %@ Safe та переконайтесь, резервну копію %@ Safe може бути створено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 %@ Safe 备份可能已过期，可能很快将被删除。请检查 %@ Safe 设置，并确保可以创建 %@ Safe 备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 %@ Safe 備份可能已過期，可能很快將被刪除。請檢查 %@ Safe 設定，並確保可以建立 %@ Safe 備份。"
          }
        }
      }
    },
