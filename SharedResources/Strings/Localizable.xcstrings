    "amount_of_free_storage_needed" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужни са %@, за да експортирате този чат. В момента са свободни %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K exportu této konverzace je potřeba %@. Aktuálně je volných %@."
