          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn «Nicht stören» aktiv ist und Sie erwähnt werden, erhalten Sie trotzdem Benachrichtigungen."
          }
        },
        "en" : {
          "stringUnit" : {
