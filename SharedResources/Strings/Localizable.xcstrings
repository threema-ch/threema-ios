        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie później. Może z innym obrazem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente novamente, talvez com outra imagem."
          }
        },
