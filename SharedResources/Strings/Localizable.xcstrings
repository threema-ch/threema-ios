    "reaction_alert_message_no_support_remote_single" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият събеседник използва версия на приложението, която все още не поддържа премахването на емоджи реакции или изпращането на повече от една реакция. Все още можете да заместите 👍 с 👎и обратното."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš chatovací partner používá verzi aplikace, která zatím nepodporuje odstraňování reakcí s emodži nebo odesílání více než jedné reakce emodži. Stále je můžete nahradit 👍 za 👎 nebo naopak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Chatpartner verwendet eine App-Version, welche das Entfernen von Emoji-Reaktionen oder das Senden mehrerer Emoji-Reaktionen noch nicht unterstützt. 👍 und 👎 lassen sich weiterhin austauschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your chat partner is using an app version that does not yet support removing emoji reactions or sending more than one emoji reaction. You can still replace 👍 with 👎 or vice versa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero de chat usa una versión de la aplicación que aún no admite la eliminación de reacciones de emojis ni el envío de más de una reacción de emojis. Aún puedes reemplazar 👍 por 👎 o viceversa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre partenaire de chat utilise une version de l’application qui ne prend pas encore en charge la suppression des réactions emoji ou l’envoi de plusieurs réactions emoji. Vous pouvez toujours remplacer 👍 par 👎 ou vice versa."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Chatpartner hät e App-Version, wo s’Lösche vo Emoji-Reaktione oder s’Sände vo mehrere Emoji-Reaktione nonig unterstützt. 👍 und 👎 chönd wiiterhin ustuuscht werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo interlocutore di chat sta utilizzando una versione dell'app che non supporta ancora la rimozione delle reazioni emoji o l'invio di più di una reazione emoji. Puoi comunque sostituire 👍 con 👎 o viceversa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットのパートナーが、絵文字リアクションの削除や複数の絵文字リアクションの送信をまだサポートしていないバージョンのアプリを使用しています。引き続き 👍 を 👎 に、またはその逆に置き換えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 파트너가 아직 이모티콘 반응을 제거하거나 하나 이상의 이모티콘 반응을 보내는 것을 지원하지 않는 앱 버전을 사용하고 있습니다. 여전히 👍 를 👎 로 바꾸거나 그 반대로 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je chatpartner gebruikt een app-versie die het verwijderen van emoji-reacties of het verzenden van meer dan één emoji-reactie nog niet ondersteunt. Je kunt 👍 nog steeds vervangen door 👎 of andersom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współuczestnik rozmowy na czacie używa wersji aplikacji, która na razie nie obsługuje usuwania reakcji w formie emoji ani wysyłania więcej niż jednej takiej reakcji. Nadal możesz zastąpić 👍 emoji 👎 lub na odwrót."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu parceiro de bate-papo está usando uma versão do aplicativo que ainda não suporta a remoção de reações de emoji ou o envio de mais de uma reação de emoji. Você ainda pode substituir 👍 por 👎 ou vice-versa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш собеседник в чате использует версию приложения, которая пока не поддерживает удаление реакций со смайликами или отправку нескольких смайликов. Вы все еще можете заменить 👍 на 👎 или наоборот."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš partner v konverzázii používa verziu aplikácie, ktorá zatiaľ nepodporuje odstraňovanie reakcií emodži alebo odosielanie viac ako jednej reakcie emodži. Stále môžete nahradiť 👍 za 👎 alebo naopak."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet arkadaşınız, henüz simge tepkilerinin kaldırılmasını veya birden fazla simge tepkisi gönderilmesini desteklemeyen bir uygulama sürümü kullanıyor. 👍 yine 👎 ile değiştirebilirsiniz veya tam tersi de mümkündür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш співрозмовник використовує версію застосунку, яка не підтримує прибирання реакцій емодзі або надсилання більше однієї реакції емодзі. Але ви все ще можете замінити 👍 на 👎 або навпаки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然对方使用的应用版本尚不支持删除心情表态或发送多个心情表态，但您仍然可以选择 👍 或 👎 。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雖然對方使用的應用程式版本尚未支援刪除表情回應或傳送多個表情回應，但您仍然可以選擇 👍 或 👎 。"
          }
        }
      }
    },
