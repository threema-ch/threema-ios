    "flavorinfo_businessappviewmodel_work_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work е приложение за сигурна комуникация между фирми и компании, което е криптирано от край до край, съобразено с GDPR и е разработено в Швейцария."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work je bezpečné řešení komunikace pro firmy. Je end-to-end (koncově) šifrované, v souladu s GDPR a vyvinuté ve Švýcarsku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work ist die sichere Kommunikationslösung für Unternehmen – Ende-zu-Ende-verschlüsselt, DSGVO-konform und in der Schweiz entwickelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work is the secure communication solution for companies – end-to-end encrypted, GDPR-compliant, and developed in Switzerland."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work es la solución de comunicación segura para empresas: cifrada de extremo a extremo, compatible con el RGPD y desarrollada en Suiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work est la solution de communication sécurisée pour les entreprises : cryptage de bout en bout, conforme au RGPD et développée en Suisse."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work isch di sicher Kommunikationslösig für Undernehme – Ändi-zu-Ändi-verschlüsslet, DSGVO-konform und ide Schwiiz entwicklet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work è la soluzione di comunicazione sicura per le aziende: crittografata end-to-end, conforme al GDPR e sviluppata in Svizzera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work は、エンドツーエンドで暗号化され、GDPR に準拠し、スイスで開発された、企業向けの安全なコミュニケーション ソリューションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work는 기업을 위한 안전한 커뮤니케이션 솔루션입니다. 종단 간 암호화를 지원하며, GDPR 준수하고, 스위스에서 개발되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work is de veilige communicatieoplossing voor bedrijven – end-to-end gecodeerd, AVG-conform en ontwikkeld in Zwitserland."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work to bezpieczne rozwiązanie komunikacyjne dla firm – szyfrowane od końca do końca, zgodne z RODO i opracowane w Szwajcarii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work é a solução de comunicação segura para empresas, oferecendo criptografada de ponta a ponta, compatível com GDPR e desenvolvida na Suíça."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work je bezpečné komunikačné riešenie pre firmy – s end-to-end šifrovaním, v súlade s GDPR a vyvinuté vo Švajčiarsku."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work, şirketler için uçtan uca şifrelenmiş, GDPR uyumlu ve İsviçre'de geliştirilen güvenli iletişim çözümüdür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work — безпечне рішення для комунікації в компаніях, що забезпечує наскрізне шифрування, відповідає вимогам GDPR і розроблене у Швейцарії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work 是专为企业设计的加密通信解决方案 — 端到端加密、符合欧盟通用数据保护条例 (GDPR) 标准，应用程序在瑞士开发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema Work 是專為公司設計的安全通訊解決方案 — 端對端加密、符合歐盟一般資料保護規則 (GDPR) 規範，應用程式在瑞士開發。"
          }
        }
      }
    },
