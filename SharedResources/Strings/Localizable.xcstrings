    "error_rogue_device_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засечена е връзка от друго устройство"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detekováno připojení z jiného zařízení"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung von anderem Gerät erkannt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection from another device detected"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha detectado una conexión desde otro dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion à partir d'un autre appareil a été détectée."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindig vomene andere Grät erchännt"
          }
        },
        "it" : {
          "stringUnit" : {
