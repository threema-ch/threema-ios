        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activar la Vista previa multidispositivo, se desactivará Perfect Forward Secrecy en todos los contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option de Confidentialité de transmission parfaite sera désactivée pour tous les contacts une fois l'Aperçu multi-appareils activé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy wird für all Kontäkt deaktiviert, nachdem Sie d’Multi-Device-Vorschau aktiviert händ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Perfect Forward Secrecy sarà disattivato per tutti i contatti non appena avrai attivato l'anteprima multi-dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マルチデバイスプレビューを有効にすると、すべての連絡先に対してPFS（Perfect Forward Secrecy）が無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy는 다중 기기 미리보기를 활성화한 후 모든 연락처에 대해 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat u Multi-Device preview hebt geactiveerd, wordt Perfect forward secrecy voor alle contacten uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktywacji opcji połączonych urządzeń zostanie wyłączone idealne utajnianie z wyprzedzeniem (PFS) dla wszystkich kontaktów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect Forward Secrecy será desativado para todos os contatos após a ativação da Prévia de multidispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После того как вы активируете предпросмотр на нескольких устройствах, протокол Perfect Forward Secrecy будет отключен для всех контактов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktivácii náhľadu viacerých zariadení bude funkcia \"Perfect Forward Secrecy\" pre všetky kontakty deaktivovaná."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoklu Cihaz Önizlemesini etkinleştirdikten sonra Mükemmel İletme Gizliliği tüm kişiler için devre dışı bırakılacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цілковита пряма секретність буде заблокована для усіх контактів після активації Огляду на декількох пристроях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
