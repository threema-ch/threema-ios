    "backup_local_recovery_password_warning" : {
      "comment" : "A warning message that instructs the user to store their recovery key in a secure location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důležité: Toto heslo v případě jeho ztráty nelze obnovit. Bezpečně si jej uložte do správce hesel, nebo si jej zapište a uschovejte na bezpečné místo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Dieses Passwort kann nicht wiederhergestellt werden, wenn es verloren geht. Speichern Sie es sicher in einem Passwortmanager oder notieren Sie es und bewahren Sie es an einem sicheren Ort auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Important: This password cannot be recovered if lost. Store it securely in a password manager or write it down and keep it somewhere safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Importante**: si pierde esta contraseña, no podrá recuperarla. Guárdela de forma segura en un gestor de contraseñas o anótela y guárdela en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Important** : vous ne pourrez pas récupérer ce mot de passe si vous le perdez. Stockez-le en toute sécurité dans un gestionnaire de mots de passe ou notez-le et conservez-le dans un endroit sûr."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Das Passwort cha nüme widerhergstellt werde, wenn Sie’s verlüüred. Speichered Sie’s sicher imene Passwortmanager oder notiered Sie’s sich und bewahred Sie’s amene sichere Ort uf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante: se persa, questa password non può essere recuperata. Conservala in modo sicuro in un gestore di password o annotala e tienila in un luogo sicuro."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dôležité**: V prípade straty nie je možné toto heslo obnoviť. Uložte si ho bezpečne v správcovi hesiel alebo si ho zapíšte a uchovajte na bezpečnom mieste."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Önemli**: Bu şifre kaybedilirse geri alınamaz. Onu güvenli bir şekilde bir şifre yöneticisine kaydedin veya bir yere yazıp güvenli bir yerde saklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**重要提示**：如丟失此密码，将无法找回。请将其安全地保存在密码管理器中，或者写下来并存放在安全的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**重要提示**：如遺失此密碼，將無法找回。請將其安全地儲存於密碼管理工具中，或寫下來並存放在安全的地方。"
          }
        }
      }
    },
