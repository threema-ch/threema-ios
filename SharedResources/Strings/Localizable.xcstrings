    "still_compressed_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Много големите видеа могат да бъдат компресирани, независимо от настройките."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velmi velká videa mohou být komprimována bez ohledu na toto nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr grosse Videos werden unabhängig von dieser Einstellung komprimiert, damit sie versendet werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very large videos may be compressed regardless of this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vídeos muy largos podrían comprimirse independientemente de este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vidéos très volumineuses peuvent être compressées quel que soit ce paramètre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr grossi Videos werded unabhängig vo dere Istellig komprimiert, demit sie verschickt werde chönd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per inviare video molto grandi questi vengono compressi indipendentemente da questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常に大きな動画は、この設定に関係なく圧縮される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
