    "settings_privacy_TIRR_reset_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Върнете всички контакти към настройките по подразбиране. Това действие е непоправимо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetovat všechny kontakty do výchozího nastavení. Akci nelze vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Kontakte werden auf die Standardeinstellung zurückgesetzt. Kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset all contacts to the default setting. Action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablecer todos los contactos a la configuración predeterminada. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialiser tous les contacts au paramètre par défaut. Cette action est irréversible."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Kontäkt werded uf d’Standardiistellig zrugggsetzt. Cha nöd rückgängig gmacht werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i contatti verranno resettati alle impostazioni predefinite. Questa operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての連絡先をデフォルト設定にリセットします。この操作は元に戻すことができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 연락처를 기본 설정으로 재설정합니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaardinstellingen voor alle contactpersonen herstellen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetuj wszystkie kontakty do ustawienia domyślnego. Działania tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinir todos os contatos para a configuração padrão. A ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить все контакты до параметров по умолчанию. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetovať všetky kontakty na predvolené nastavenie. Akciu nie je možné vrátiť späť."
          }
        },
        "tr" : {
          "stringUnit" : {
