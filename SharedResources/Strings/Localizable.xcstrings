    "end_note_group_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Вие вече не сте единственият в този чат*\nНовите съобщения ще се изпращат до всички членове на групата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*V této konverzaci již nejste sami*\nNové zprávy budou odesílány všem členům skupiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Sie sind nicht mehr alleine in diesem Chat*\nNeue Nachrichten werden an alle Gruppenmitglieder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*You’re no longer alone in this chat*\nNew messages will be sent to all group members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ya no está solo en este chat*\nLos nuevos mensajes se enviarán a todos los miembros del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Vous n’êtes plus seul dans cette conversation*\nLes nouveaux messages seront envoyés à tous les membres du groupe."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Sie sind nüme ellei i dem Chat*\nNeui Nachrichte werded a all Gruppemitglieder gschickt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Sono presenti altre persone in questa chat*\nI nuovi messaggi vengono inviati a tutti i membri del gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*あなたはこのトークで一人ではなくなります*\n新しいメッセージはすべてのグループメンバーに送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*이 채팅에서 더 이상 혼자가 아닙니다*\n새 메시지는 모든 그룹 멤버에게 전송됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*U bent niet langer de enige in deze chat*\nNieuwe berichten worden aan alle groepsleden verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Nie jesteś już sam(-a) w tym czacie*\nNowe wiadomości będą wysyłane do wszystkich członków grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Você não está mais sozinho neste bate-papo\" \nNovas mensagens serão enviadas a todos membros do grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Вы уже не одиноки в этом чате*\nНовые сообщения будут отправляться всем участникам группы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*V tejto konverzácii uz nie ste jediný*\nNové správy budú poslané všetkým členom skupiny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Artık bu sohbette yalnız değilsiniz *\nTüm grup üyelerine yeni mesajlar gönderilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ви більше не самотні у цьому чаті*\nНові повідомлення надсилатимуться усім членам групи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*在此会话中不再只有您一个人能访问*\n新消息将被发送到所有群组成员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*在此對話中不再只有您一個人能存取*\n新訊息將被傳送至所有群組成員。"
          }
        }
      }
    },
