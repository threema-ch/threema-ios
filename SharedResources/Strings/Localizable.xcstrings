        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiippen und halten Sie auf Reaktion um zu sehen von wem sie stammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-tap on reactions to see who sent them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa prolongadamente las reacciones para ver quién las ha enviado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyer longuement sur les réactions pour voir qui les a envoyées."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipped Sie lang uf Reaktione um z'gseh vo wem sie sind."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto a lungo sulle reazioni per vedere chi le ha inviate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアクションを長押しすると、誰が送信したかを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반응을 길게 탭하면 누가 보냈는지 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik lang op reacties om te zien wie ze heeft gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij i przytrzymaj reakcje, aby zobaczyć, kto je wysłał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque longamente nas reações para ver quem as enviou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгое нажатие реакции покажет отправителя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dlhým stlačením na reakcie uvidíte, kto ich poslal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimin gönderdiğini görmek için tepkilere uzun dokunun."
          }
        },
