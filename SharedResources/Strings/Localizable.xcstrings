    "sqldhsessionstore_cannot_downgrade_to" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nНе може да се премине от версия %d към по-старата версия %d"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nNelze přejít na nižší verzi, tedy z verze %d na verzi %d"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nEin Downgrade von Version %d auf Version %d konnte nicht durchgeführt werden\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nCould not downgrade from version %d to version %d"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "( %@)\nNo se ha podido pasar de la versión %d a la versión %d"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nImpossible de passer de la version %d à la version antérieure %d"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nEs Downgrade vo Version %d uf Version %d hät nöd chöne duregfüehrt werde"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nImpossibile eseguire il downgrade dalla versione %d alla versione %d"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（%@）\nバージョン%dからバージョン%dにダウングレードできませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nCould not downgrade from version %d to version %d"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nNiet afgewaardeerd van versie %d naar versie %d"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nNie można cofnąć z wersji %d do wersji %d"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nNão foi possível fazer downgrade da versão %d para a versão %d"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nНельзя понизить версию приложения с %d на %d"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\n\nNepodarilo sa prejsť z verzie %d na verziu %d"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\n%d sürümünden %d sürümüne geçilemedi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\nНе вдалося перейти з версії %d на нижчу версію %d"
