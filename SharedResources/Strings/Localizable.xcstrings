    "password_bad_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избраната парола за %@ Safe не е сигурна и може много лесно да бъде отгатната от хакери. Моля, изберете друга парола. Съвет: Използвайте парола, която е съставена от множество думи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolené heslo pro %@ Safe není bezpečné a útočníci jej mohou snadno uhodnout. Vyberte si prosím jiné. Tip: Použijte heslo složené z několika samostatných slov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gewählte %@ Safe-Passwort ist sehr unsicher und kann deshalb leicht von Angreifern erraten werden. Bitte wählen Sie ein sicheres Passwort. Tipp: Benutzen Sie ein zusammengesetztes Wort aus mehreren Begriffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected password for %@ Safe is not secure and can be easily guessed by attackers. Please choose another one. Hint: Use a password composed of multiple individual words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña seleccionada para %@ Safe no es segura y los intrusos pueden adivinarla con facilidad. Elige otra. Consejo: Usa una contraseña compuesta de múltiples palabras individuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe sélectionné pour %@ Safe n’est pas sécurisé et peut facilement être deviné par les pirates. Veuillez en choisir un autre. Astuce : utilisez un mot de passe composé de plusieurs mots individuels."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’gwählte %@ Safe-Passwort isch sehr unsicher und cha drum liecht vo Agriifer errate werde. Bitte wähled Sie es sichers Passwort. Tipp: Nutzed Sie es zämegsetzts Wort us mehrere Begriff."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password scelta per %@ Safe non è sicura e può essere facilmente individuata dagli hacker. Scegline un’altra. Suggerimento: usa una password con parole multiple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した%@ Safeのパスワードは安全ではなく、攻撃者に簡単に推測されてしまいます。別のパスワードを選択してください。ヒント: 複数の単語を組み合わせたパスワードを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 %@ Safe 비밀번호는 안전하지 않으며 공격자에 의해 쉽게 추측될 수 있습니다. 다른 비밀번호를 선택하세요. 힌트: 여러 개의 개별 단어로 구성된 비밀번호를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het geselecteerde wachtwoord voor %@ Safe is niet veilig en kan gemakkelijk worden geraden. Voer een ander wachtwoord in. Hint: gebruik een wachtwoord dat u meerdere woorden bestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane hasło do %@ Safe nie jest bezpieczne i hakerzy mogą je łatwo odgadnąć. Proszę wybrać inne. Wskazówka: Użyj hasła złożonego z wielu pojedyńczych słów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha selecionada para o %@ Safe não está protegida e pode ser adivinhada facilmente por invasores. Escolha outra senha. Dica: use uma senha composta de diversas palavras individuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный для %@ Safe пароль недостаточно надежный, т. е. его легко угадать. Совет: используйте пароль из нескольких отдельных слов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadané heslo pre Trezor %@ nie je bezpečné a môže byť ľahko uhádnuté útočníkmi. Zadajte prosím iné. Nápoveda: Použite heslo zložené z niekoľkých samostatných slov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe için seçilen şifre güvenli değil ve saldırganlar tarafından kolayca tahmin edilebilir. Lütfen başka bir şifre seçiniz. İpucu: Birden çok kelimeden oluşan bir şifre kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обраний пароль для %@ Safe не є безпечним і може бути легко вгаданий зловмисниками. Будь ласка, виберіть інший пароль. Підказка: використовуйте пароль, що складається з кількох окремих слів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe 所选的密码不安全，容易被攻击者猜中，请选择其他密码。提示：使用由多个单词组成的密码。"
