    "pull_to_sync_429_message_work" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволеният дневен лимит за синхронизация на контакти е достигнат. Моля, продължете синхронизирането утре или се свържете с Вашия %@ администратор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bylo dosaženo povoleného limitu synchronizací kontaktů za den. Pokračujte v synchronizaci zítra nebo se obraťte na svého správce %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Limit der erlaubten Kontaktsynchronisationen pro Tag wurde erreicht. Setzen Sie die Synchronisierung morgen fort, oder kontaktieren Sie Ihren %@-Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The limit of allowed contact syncs per day has been reached. Please continue syncing tomorrow, or contact your %@ administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha alcanzado el límite de sincronizaciones de contactos permitidas al día. Continúe la sincronización mañana o póngase en contacto con su administrador de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de synchronisations de contacts autorisées par jour a été atteinte. Veuillez poursuivre la synchronisation demain ou contacter votre administrateur %@."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’Limit vode erlaubte Kontaktsynchronisatione pro Tag isch erreicht. Mached Sie mit de Synchronisation morn wiiter, oder kontaktiered Sie Ihre %@-Administrator."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato raggiunto il limite di sincronizzazioni di contatti consentite al giorno. Continua la sincronizzazione domani oppure contatta l'amministratore %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日に許可される連絡先同期の上限に達しました。明日に同期を続けるか、またはあなたの%@管理者に連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 동안 허용된 연락처 동기화 한도에 도달했습니다. 내일 계속 동기화하거나 %@ 관리자에게 연락하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dagelijkse limiet voor toegestane synchronisaties van contacten is bereikt. Ga morgen verder met synchroniseren, of neem contact op met de beheerder van %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto dzienny limit dozwolonych synchronizacji kontaktów. Można spróbować synchronizacji jutro albo skontaktować się z pomocą techniczną %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de sincronizações de contato permitidas por dia foi atingido. Continue com a sincronização amanhã ou contate o seu administrador do %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит на разрешенное количество синхронизаций контактов в день. Продолжите синхронизацию завтра или обратитесь к своему администратору %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit povolených synchronizácií kontaktov za deň bol dosiahnutý. Pokračujte v synchronizácii zajtra alebo kontaktujte vášho správcu %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük izin verilen kişi senkronizasyonu sınırına ulaşıldı. Lütfen senkronizasyona yarın devam edin veya %@ yöneticinizle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вичерпано ліміт дозволених синхронізацій контактів на добу. Продовжте синхронізацію завтра або зверніться до свого адміністратора %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到每天允许的联系人同步数量上限。 请到明天继续同步，或联系您的 %@ 管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達到每天允許的聯絡人同步數量上限。 請到明天繼續同步，或聯絡您的 %@ 管理員。"
          }
        }
      }
    },
    "push_reminder_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма да бъдете информиран за нови входящи съобщения или обаждания, когато %@ е затворен.\n\nЗа да оправите това, отидете в системните настройки и активирайте известията за %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zavřete %@, nebudete dostávat informace o nových zprávách a příchozích hovorech.\n\nChcete-li to opravit, přejděte do nabídky Nastavení systému a povolte oznámení pro %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden nicht über neue Nachrichten oder eingehende Anrufe informiert, wenn %@ geschlossen ist.\n\nUm dies zu beheben, gehen Sie in die System-Einstellungen und aktivieren Sie Benachrichtigungen für %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will not be informed of new messages or incoming calls when %@ is closed.\n\nTo fix this, go to System Settings and enable Notifications for %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recibirá información sobre mensajes nuevos o llamadas entrantes cuando haya cerrado %@. \n\nPara solucionarlo, entre en Ajustes del sistema y active las notificaciones de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne serez pas informé de l’arrivée de nouveaux messages ou des appels entrants si %@ est fermée.\n\nPour corriger cela, accédez aux paramètres système et activez les notifications pour %@."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werded nöd über neui Nachrichte oder iigehendi Arüef informiert, wenn %@ gschlosse isch. \n\nZum das z’behebe, gönd Sie id System-Iistellige und aktiviered Sie Benachrichtigunge für %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riceverai nuovi messaggi o chiamate in arrivo quando %@ è chiusa. Per modificarlo, accedi alle impostazioni di sistema e attiva alla voce \"Notifiche\" le notifiche per %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が閉じていると、新着メッセージや着信が通知されません。\n\n修正するには、システムの設定に移動し、%@の通知を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 닫힌 경우 새로운 메시지나 수신 전화에 대한 알림을 받지 못할 것입니다.\n\n이 문제를 해결하려면 시스템 설정으로 이동하여 %@에 대한 알림을 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U ontvangt geen meldingen voor berichten of inkomende gesprekken  wanneer %@ is uitgeschakeld. \n\nGa naar de systeeminstellingen en schakel meldingen in voor %@ om dit op te lossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie otrzymasz informacji o nowych wiadomościach lub nadchodzących połączeniach po zamknięciu %@. \n\nAby to rozwiązać, przejdź do Ustawień systemowych i włącz powiadomienia dla %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não será informado sobre novas mensagens ou chamadas recebidas quando %@ estiver fechado.\n\nPara corrigir isso, acesse os Ajustes do Sistema e ative as Notificações para %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не будете получать сообщения о новых сообщениях, если приложение %@ закрыто.\n\nЧтобы исправить это, перейдите в настройки системы и включите уведомления для %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je %@ zatvorená, nebudete informovaný o nových správach alebo prichádzajúcich hovoroch.\n\nAk to chcete vyriešiť, prejdite do nastavení systému a povoľte upozornenia pre %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kapalıyken yeni mesajlardan veya gelen aramalardan haberdar edilmeyeceksiniz.\n\nBunu düzeltmek için Sistem Ayarlarına gidin ve %@ için Bildirimleri etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не отримуватимете сповіщення про нові повідомлення чи вхідні дзвінки, коли застосунок %@ закрито.\n\nЩоб виправити це, перейдіть у розділ «Системні налаштування» і увімкніть сповіщення для %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 %@ 关闭时，您将不会收到新消息或来电通知。\n\n如要解决此问题，请前往系统设置并为 %@ 启用通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 %@ 關閉時，您將不會收到新訊息或來電通知。\n\n要解決此問題，請前往系統設定並開啟 %@ 通知。"
          }
        }
      }
    },
