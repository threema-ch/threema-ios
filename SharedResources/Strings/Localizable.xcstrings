    "sync_error_general_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, проверете интернет връзката Ви и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte své připojení k internetu a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please check your Internet connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión a Internet y prueba de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez vérifier votre connexion Internet et réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte überprüefed Sie Ihri Internetverbindig und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione a Internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認して、もう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer uw internetverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosimy sprawdzić połączenie internetowe i spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a sua conexão com a internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте соединение с Интернетом и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte svoje internetové pripojenie a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen internet bağlantınızı kontrol edin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, перевірте з’єднання з інтернетом та спробуйте знов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查您的互联网连接并重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查您的網路連線並再試一次。"
          }
        }
      }
    },
    "sync_error_same_transaction_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този профил вече се синхронизира на друго устройство. Моля, изчакайте до завършване на синхронизацията. Промените на това устройство ще бъдат отхвърлени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil se již synchronizuje na jiném zařízení. Počkejte na dokončení synchronizace. Změny na tomto zařízení se zruší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft bereits eine Synchronisierung auf einem anderen Gerät. Bitte warten Sie, bis diese abgeschlossen ist. Die Änderungen auf diesem Gerät werden verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profile is already being synchronized on another device. Please wait until the synchronization is complete. Changes on this device will be discarded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil ya se está sincronizando en otro dispositivo. Espera hasta que la sincronización se complete. Se descartarán los cambios en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil est déjà en cours de synchronisation sur un autre appareil. Veuillez attendre la fin de la synchronisation. Les modifications sur cet appareil seront annulées."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lauft scho e Synchronisierig ufeme andere Grät. Bitte warted Sie, bis die abgschlosse isch. D’Änderige uf dem Grät werded verworfe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è già in corso su un altro dispositivo. Attendi il completamento della sincronizzazione. Le modifiche apportate a questo dispositivo verranno eliminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールは既に別のデバイスで同期されています。同期が完了するまでお待ちください。このデバイスでの変更は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필이 이미 다른 기기에서 동기화되고 있습니다. 동기화가 완료될 때까지 기다려 주세요. 이 기기에서의 변경 사항은 폐기됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het profiel wordt al gesynchroniseerd op een ander apparaat. Wacht tot de synchronisatie is voltooid. Wijzigingen op dit apparaat zullen worden genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil jest już synchronizowany na innym urządzeniu. Prosimy poczekać, aż synchronizacja zostanie zakończona. Zmiany na tym urządzeniu zostaną odrzucone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil já está sendo sincronizado em outro dispositivo. Por favor, aguarde até que a sincronização seja concluída. As alterações neste dispositivo serão descartadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль уже синхронизируется на другом устройстве. Пожалуйста, подождите, пока синхронизация не завершится. Изменения на этом устройстве будут отменены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil je už synchronizovaný v inom zariadení. Počkajte, kým sa synchronizácia dokončí. Zmeny v tomto zariadení sa zrušia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil zaten başka bir cihazda senkronize ediliyor. Lütfen senkronizasyon tamamlanana kadar bekleyin. Bu cihazdaki değişiklikler göz ardı edilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей профіль зараз синхронізується на іншому пристрої. Будь ласка, дочекайтесь завершення синхронізаціїї. Зміни профілю на цьому пристрої не буде враховано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件已在另一台设备上同步。请等待同步完成。此设备上的更改将被丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔已在另一台裝置上同步。請等待同步完成。此裝置上的變更將被捨棄。"
          }
        }
      }
    },
