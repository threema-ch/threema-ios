    "webClientSession_error_updateApp_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грешка във версията на отдалечения протокол на приложението. Моля, актуализирайте Вашето iOS приложение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špatná verze protokolu vzdálené aplikace, aktualizujte si prosím aplikaci pro iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsche Version des App Remote Protocol, bitte aktualisieren Sie die iOS-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrong App Remote Protocol version, please update your iOS app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión del protocolo remoto de aplicación incorrecta. Actualice la aplicación iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version d’App Remote Protocol incorrecte, veuillez mettre à jour votre application iOS."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falschi Version vom App Remote Protocol, bitte aktualisiered Sie d’iOS-App."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione errata del protocollo remoto dell’app, aggiorna la tua app iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリリモートプロトコルのバージョンが正しくありません。iOSアプリをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 앱 원격 프로토콜 버전, iOS 앱을 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkeerde protocolversie van App Remote. Werk uw iOS-app bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprawidłowa wersja zdalnego protokołu aplikacji, zaktualizuj swoją aplikację iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão errada do protocolo remoto de aplicativo. Atualize seu aplicativo do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверная версия удаленного протокола приложения, обновите приложение для iOS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesprávna verzia vzdialeného protokolu aplikácie, aktualizujte prosím vašu iOS aplikáciu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanlış Uygulama Uzak Protokol sürümü, lütfen iOS uygulamanızı güncelleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неправильна версія App Remote Protocol, будь ласка, оновіть програму iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序远程协议版本有误，请更新您的iOS应用程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的應用程式遠端協定版本出現錯誤。請更新目前的 iOS App。"
          }
        }
      }
    },
