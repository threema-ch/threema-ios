    "settings_privacy_block_unknown_foooter_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки може да Ви изпрати съобщение. Новите контакти ще се добавят автоматично при първото им съобщение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy vám může odesílat kdokoliv. Nové kontakty budou přidávány automaticky poté, co od nich obdržíte první zprávu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder kann Ihnen Nachrichten senden. Neue Kontakte werden bei der ersten Nachricht automatisch hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anybody can send you a message. New contacts will be added automatically when their first message arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier persona puede enviarle un mensaje. Los contactos nuevos se añadirán automáticamente cuando llegue su primer mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde peut vous envoyer un message. Les nouveaux contacts seront automatiquement ajoutés à l'arrivée de leur premier message."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede cha Ihne Nachrichte schicke. Neui Kontäkt werded bi de erste Nachricht automatisch dezue taa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque può inviarti messaggi. I nuovi contatti vengono aggiunti automaticamente dopo il primo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰でもあなたにメッセージを送ることができます。新しい連絡先は、最初のメッセージが届いたときに自動的に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누구나 당신에게 메시지를 보낼 수 있습니다. 새로운 연락처는 첫 번째 메시지가 도착할 때 자동으로 추가됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen kan u een bericht sturen. Nieuwe contacten worden automatisch toegevoegd wanneer hun eerste bericht aankomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy może wysłać Ci wiadomość. Nowe kontakty zostaną dodane automatycznie, po odebraniu pierwszej wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa pode lhe enviar mensagens. Novos contatos serão adicionados automaticamente quando a primeira mensagem deles chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправить вам сообщение может кто угодно. Новые контакты будут добавлены автоматически после прихода первого сообщения от них."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správu vám môže poslať ktokoľvek. Nové kontakty sa pridajú automaticky, keď príde ich prvá správa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkes size mesaj gönderebilir. İlk mesajları geldiğinde yeni kişiler otomatik olarak eklenecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто може надіслати вам повідомлення. Нові контакти будуть додані автоматично, коли надійде перше повідомлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以向您发送消息。当他向您发送第一条消息时，会自动添加到新的联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以向您傳送訊息。當他向您傳送第一則訊息時，會自動新增至新聯絡人。"
          }
        }
      }
    },
    "settings_privacy_block_unknown_footer_on" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
