    "safe_intro_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe редовно създава криптирани и анонимни резервни копия на най-важните Ви данни и ги запазва в %@ сървъра, който сте избрали или в този по подразбиране."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe pravidelně vytváří šifrované, anonymní zálohy vašich nejdůležitějších dat a ukládá je na server %@ nebo jiný, vámi zvolený server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe erstellt regelmässig ein verschlüsseltes, anonymes Backup der wichtigsten Daten und speichert es auf dem %@-Server oder einem anderen Server Ihrer Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe regularly creates an encrypted, anonymous backup of the most important data and stores it on the %@ server or another server of your choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe crea regularmente una copia de seguridad cifrada y anónima de los datos más importantes y los almacena en el servidor de %@ o en otro servidor que elija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe crée régulièrement une sauvegarde chiffrée et anonyme de vos données les plus importantes et les stocke sur le serveur %@ ou sur un autre serveur de votre choix."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe erstellt regelmässig es verschlüsslets, anonyms Backup vode wichtigste Date und speicherets ufem %@-Server oder eme andere Server Ihrer Wahl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe crea con regolarità un backup criptato ed anonimo di tutti i tuoi dati importanti e li archivia sul server %@ o un altro a tua scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeは、あなたにとって最も重要なデータの暗号化された匿名のバックアップを定期的に作成し、%@のサーバーまたはあなたが選択した別のサーバーに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe는 정기적으로 가장 중요한 데이터를 암호화하고 익명으로 백업하여 %@ 서버 또는 선택한 다른 서버에 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe maakt regelmatig versleutelde en anonieme back-ups van uw belangrijkste gegevens en slaat deze op op de %@-server of een andere server van uw keuze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe regularnie tworzy zaszyfrowaną, anonimową kopię zapasową najważniejszych danych i przechowuje ją na serwerze %@ lub innym wybranym przez Ciebie serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ Safe cria regularmente um backup criptografado e anônimo dos dados mais importantes para você e o armazena no servidor do %@ ou outro servidor da sua escolha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe регулярно создает зашифрованную анонимную резервную копию ваших наиболее важных данных и хранит их на сервере %@ или на другом выбранном вами сервере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trezor %@ pre vás pravidelne vytvára zašifrované, anonymné zálohy najdôležitejších údajov a tieto ukladá buď na %@ server, alebo iný podľa vašeho výberu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe, sizin için en önemli verilerin şifreli, anonim bir yedeğini düzenli olarak oluşturur ve bunları %@ sunucusunda veya seçtiğiniz başka bir sunucuda saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe регулярно створює зашифровану анонімну резервну копію найважливіших даних для вас та зберігає її на сервері %@ або іншому сервері на ваш вибір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe 定期为您最重要的数据创建加密的匿名备份，并将其存储在 %@ 服务器，或在您选择的其他服务器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe 定期為您最重要的資料建立加密的匿名備份，並將其儲存在 %@ 伺服器，或在您選擇的其他伺服器上。"
          }
        }
      }
    },
