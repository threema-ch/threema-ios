        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wänd Sie di verwaiste Dateie unwiderrueflich lösche? Die Aktion laht sich nüme rückgängig mache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi cancellare i file abbandonati? Ciò comporta la perdita irrevocabile dei dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "orphanedとなったファイルを永久に削除したいですか？この操作は元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되지 않은 파일을 영구적으로 삭제할까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilt u de zwevende bestanden permanent verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz trwale usunąć porzucone pliki? Nie można cofnąć tej czynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de excluir os arquivos órfãos permanentemente? Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите окончательно удалить потерянные файлы? Это действие нельзя отменить."
