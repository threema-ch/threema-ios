    "restoring_backup_failed_message" : {
      "comment" : "Message displayed when restoring a backup fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se nám obnovit vaši zálohu. To může být způsobeno poškozeným souborem, nesprávným klíčem nebo nedostatečným úložným prostorem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Backup konnte nicht wiederhergestellt werden. Möglicherweise ist die Datei beschädigt, der Schlüssel falsch, oder der Speicherplatz reicht nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We couldn’t restore your backup. This may be due to a corrupted file, incorrect key, or insufficient storage space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido restaurar su copia de seguridad. Esto puede deberse a un archivo dañado, una clave incorrecta o a que no hay suficiente espacio de almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas pu restaurer votre sauvegarde. Cela peut être dû à un fichier corrompu, une clé incorrecte, ou un espace de stockage insuffisant."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihres Backup hät nöd chöne widerhergstellt werde. Möglicherwiis isch d’Datei beschädigt, de Schlüssel falsch, oder de Speicherplatz langed nöd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a ripristinare il tuo backup. Ciò potrebbe essere dovuto a un file corrotto, una chiave errata o spazio di archiviazione insufficiente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklemenizi geri yükleyemedik. Bunun nedeni bozuk bir dosya, yanlış anahtar veya yetersiz depolama alanı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми не змогли відновити вашу резервну копію. Це могло статися через пошкоджений файл, неправильний ключ або недостатній обсяг пам'яті."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法恢复您的备份。这可能是由于文件损坏、密钥不正确或存储空间不足所造成的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們無法還原您的備份。這可能是由於檔案損毀、金鑰不正確或儲存空間不足所造成的。"
          }
        }
      }
    },
    "restoring_backup_not_on_device" : {
      "comment" : "Error shown when a data backup picked from iCloud Drive or another file provider has not been downloaded to the device.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato záloha není stažena do vašeho zařízení. Chcete-li ji stáhnout, otevřete ji v aplikaci Soubory (Files), a poté to zkuste znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
