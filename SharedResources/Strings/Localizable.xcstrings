    "privateChat_setup_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашето %@ Safe резервно копие съдържа поверителни чатове. Длъжен сте да зададете парола, за да имате достъп до тях."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše záloha %@ Safe obsahovala soukromé konverzace. Pro jejich otevření musíte nastavit přístupový kód."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr %@ Safe-Backup enthielt private Chats. Um diese öffnen zu können, müssen Sie die Code-Sperre einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ Safe backup contained private chats, you must set a passcode to access them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su copia de seguridad de %@ Safe contenía chats privados. Tiene que establecer una contraseña para acceder a ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sauvegarde %@ Safe comporte des chats privés, vous devez définir un code d'accès pour y accéder."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihres %@ Safe-Backup hät privati Chats enthalte. Demit Sie die chönd ufmache, müend Sie d’Code-Sperri iirichte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo backup %@ Safe contiene delle chat private. Per aprirle devi definire un codice d'accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeのバックアップにはプライベートチャットが含まれているため、アクセスするにはパスコードを設定する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe 백업에는 개인 대화가 포함되어 있습니다. 이에 접근하려면 암호를 설정해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw %@ Safe back-up bevat privéchats, u moet een wachtwoord instellen om toegang te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa %@ Safe zawierała prywatne czaty, musisz ustawić kod dostępu, aby uzyskać do nich dostęp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu backup do %@ Safe continha bate-papos privados. Você deve definir uma senha para acessá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша резервная копия %@ Safe содержала личные чаты, вы должны задать пароль для доступа к ним."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša bezpečná záloha %@ Safe obsahovala súkromné čety. Ak k ním chcete získať prístup, musíte si nastaviť prístupový kód."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe yedeklemeniz özel sohbetler içeriyordu, bunlara erişmek için bir parola belirlemeniz gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервна копія %@ Safe містить чати. Вам потрібно встановити пароль для доступу до них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 %@ Safe 备份包含私密聊天记录，您必须设置密码才能访问备份内容。"
