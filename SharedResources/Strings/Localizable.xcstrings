        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Speicherplatz werden benötigt. %@ sind im Moment frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ are needed to export this chat. %@ are currently free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan %@ para exportar este chat. En este momento hay %@ libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut %@ pour exporter ce chat. Il y a actuellement %@ d’espace libre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Speicherplatz wird benötigt. %@ sind im Moment frei."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di memoria necessari. %@ attualmente disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の容量が必要になります。現在%@が利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 용량이 필요합니다. 현재 %@를 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is vereist om dit gesprek te exporteren. Momenteel is er %@ beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest potrzebne do wyeksportowania tego czatu. %@ jest obecnie bezpłatny."
          }
