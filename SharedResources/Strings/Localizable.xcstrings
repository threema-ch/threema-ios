          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримайте палець на реакції та дізнайтесь, хто її надіслав."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按心情表态即可查看是谁发送的。"
          }
        },
