    "multi_device_new_linked_device_instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преди да добавите ново устройство, изтеглете настоящата бета версия на %@ за настолен компютър и я отворете:\n\n%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než přidáte nové zařízení, stáhněte si aktuální beta verzi %@ pro stolní počítač a otevřete ji:\n\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Sie ein neues Gerät verknüpfen, laden Sie bitte die aktuelle Beta-Version von %@ für Desktop herunter und öffnen Sie diese:\n\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before adding a new device, please download the current beta version of %@ for desktop and open it:\n\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de añadir un dispositivo nuevo, descárguese la versión beta actual de %@ para escritorio y ábrala:\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d'ajouter un nouvel appareil, veuillez télécharger la version bêta actuelle de %@ pour ordinateur et l'ouvrir :\n\n%@"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Sie es neus Grät verchnüpfed, ladet Sie bitte di aktuell Beta-Version vo %@ für Desktop abe und mached Sie die uf:\n\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di aggiungere un nuovo dispositivo, scarica la versione beta attuale di %@ per desktop e aprila:\n\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい端末を追加する前に、現在のベータ版デスクトップ用%@をダウンロードして開いてください：\n\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 기기를 추가하기 전에 데스크톱용 %@의 현재 베타 버전을 다운로드하고 열어주세요:\n\n%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download de huidige bètaversie van %@ voor desktop en open haar voordat u een nieuw apparaat toevoegt:\n\n%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed dodaniem nowego urządzenia pobierz bieżącą wersję beta %@ na komputer stacjonarny i otwórz ją:\n\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de adicionar um novo dispositivo, faça o download e abra a versão beta atual do %@ para desktop:\n\n%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед тем как добавлять новое устройство, скачайте текущую бета-версию программы %@ для компьютера и откройте ее:\n\n%@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred pridaním nového zariadenia si prosím stiahnite aktuálnu beta verziu %@ do svojho počítača a spustite ju:\n\n%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir cihaz eklemeden önce lütfen masaüstü için mevcut %@ beta sürümünü indirin ve açın:\n\n %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж додавати новий пристрій, завантажте поточну бета-версію %@ для ПК та відкрийте її:\n\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在添加新设备之前，请下载 %@ 电脑版的当前测试版并打开：\n%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新增新裝置之前，請先下載 %@ 電腦版的最新測試版並啟動：\n%@"
          }
        }
      }
    },
