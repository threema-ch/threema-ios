    "safe_deactivate_confirmation_message" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако деактивирате %@ Safe, всяко съществуващо резервно копие ще бъде изтрито от сървъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud deaktivujete %@ Safe, všechny stávající zálohy budou ze serveru odstraněny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie %@ Safe deaktivieren, werden bestehende Backups unwiderruflich vom Server gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you deactivate %@ Safe, any existing backups will be deleted from the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desactiva %@ Safe, se eliminarán todas las copias de seguridad existentes del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous désactivez %@ Safe, toute sauvegarde existante sera supprimée du serveur."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie %@ Safe deaktiviered, werded bestehendi Backups unwiderrueflich vom Server glöscht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivi %@ Safe ogni backup esistente sarà eliminato dal server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli dezaktywujesz %@ Safe, wszystkie istniejące kopie zapasowe zostaną usunięte z serwera."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak deaktivujete %@ Trezor, všetky existujúce zálohy budú zo servera odstránené."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe özelliğini devre dışı bırakırsanız, sunucudaki mevcut tüm yedekler silinecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви вимкнете %@ Safe, усі наявні резервні копії будуть видалені з сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您禁用 %@ Safe，任何现有的备份都将在服务器上被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您停用 %@ Safe，任何現有的備份都將在伺服器上被刪除。"
          }
        }
      }
    },
    "safe_deactivate_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако деактивирате %@ Safe, всяко съществуващо резервно копие ще бъде изтрито от сървъра. Ще продължите ли?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud %@ Safe zakážete, všechny stávající zálohy budou ze serveru odstraněny. Chcete pokračovat?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre bestehenden %@ Safe-Backups werden auf dem Server unwiderruflich gelöscht. Möchten Sie fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you disable %@ Safe, any existing backups will be deleted on the server. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si deshabilitas %@ Safe, todas las copias de seguridad existentes se eliminarán del servidor. ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous désactivez %@ Safe, toute sauvegarde existante sera supprimée du serveur. Continuer ?"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihri bestehende %@ Safe-Backups werded ufem Server unwiderrueflich glöscht. Wänd Sie wiitermache?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disabiliti %@ Safe ogni backup esistente sarà eliminato dal server. Continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safeを無効にすると、既存のバックアップがサーバー上から削除されます。続けますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe를 비활성화하면 서버에서 기존 백업이 삭제됩니다. 계속하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u %@ Safe uitschakelt, worden bestaande back-ups van de server verwijderd. Doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wyłączysz %@ Safe, wszystkie istniejące kopie zapasowe zostaną usunięte na serwerze. Kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você desabilitar o %@ Safe, todos os backups existentes serão excluídos do servidor. Continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если отключить %@ Safe, все существующие резервные копии будут удалены с сервера. Продолжить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak vypnete Trezor %@, všetky existujúce zálohy budú zo servera odstránené. Pokračovať?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe'i devre dışı bırakırsanız, sunucudaki tüm mevcut yedeklemeler silinecektir. Devam edilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вимкнути %@ Safe, усі наявні резервні копії будуть видалені з сервера. Продовжити?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您禁用 %@ Safe，任何现有的备份都将在服务器上被删除。是否继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您停用 %@ Safe，任何現有的備份都將在伺服器上被刪除。是否繼續？"
