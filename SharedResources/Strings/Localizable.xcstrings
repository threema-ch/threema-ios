            "value" : "Създайте резервно копие, за да запазите съобщенията и медийните файлове на сигурно място. Може да изберете между множество опции за създаване на резервно копие, които да отговарят на Вашите предпочитания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte zálohu pro bezpečné uložení vašich zpráv a médií. Můžete si vybrat z několika možností zálohy podle vašich preferencí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie ein Backup, um Ihre Nachrichten und Medien sicher zu speichern. Sie können aus verschiedenen Backup-Optionen wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a backup to securely save your messages and media. You can choose from multiple backup options to suit your preferences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree una copia de seguridad para guardar de manera segura sus mensajes y archivos multimedia. Puede elegir entre varias opciones de copia de seguridad según sus preferencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une sauvegarde pour enregistrer vos messages et médias en toute sécurité. Vous pouvez choisir parmi plusieurs options de sauvegarde en fonction de vos préférences."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelled Sie es Backup, zum Ihri Nachrichte und Medie sicher z’speichere. Sie chönd us verschidene Backup-Optione wähle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un backup per salvare in modo sicuro i tuoi messaggi e i tuoi file multimediali. Puoi scegliere tra diverse opzioni di backup in base alle tue preferenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージやメディアを安全に保存するために、バックアップを作成しましょう。お好みに合わせて、複数のバックアップ方法から選択できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz kopię zapasową, aby bezpiecznie zachować wiadomości i multimedia. Oferujemy wiele opcji tworzenia kopii zapasowych z możliwością dostosowania ich do swoich preferencji."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte zálohu na bezpečné uloženie vašich správ a médií. Môžete si vybrať z viacerých možností zálohovania, ktoré vyhovujú vašim preferenciám."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajlarınızı ve medya dosyalarınızı güvenli bir şekilde kaydetmek için bir yedekleme oluşturun. Tercihlerinize uygun birden fazla yedekleme seçeneği arasından seçim yapabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть резервну копію, щоб безпечно зберегти ваші повідомлення та медіа. Ви можете обрати з кількох варіантів резервного копіювання відповідно до ваших вподобань."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建备份以安全地保存您的消息和媒体文件。您可以根据个人偏好选择多种备份选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立備份以安全地儲存您的訊息和媒體檔案。您可以依照個人偏好選擇多種備份選項。"
          }
        }
      }
    },
    "bad_identity_backup" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните на експортирания идентификатор са невалидни или сте въвели грешна парола. Използвайте паролата, която сте въвели при експортирането на идентификатора, за да възстановите Вашия %@ идентификатор. Моля, проверете какво въвеждате и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data exportu ID jsou neplatná nebo jste zadali špatné heslo. Chcete-li obnovit své %@ ID, použijte heslo zvolené při vytváření exportu. Zkontrolujte, zda jste vše zadali správně, a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ID-Export ist ungültig, oder Sie haben ein falsches Passwort eingegeben. Verwenden Sie das Passwort, das Sie beim Erstellen des Exports gewählt haben, um Ihre %@-ID wiederherzustellen. Bitte überprüfen Sie Ihre Eingaben und versuchen Sie es nochmals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ID export data is invalid or you have entered the wrong password. Use the password you chose when you created the export in order to restore your %@ ID. Please check your input and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la ID exportado no son válidos o la contraseña introducida es incorrecta. Para restaurar el ID de %@, utilice la contraseña que eligió al crear la exportación. Compruebe los datos introducidos y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d’exportation d’ID sont invalides ou vous avez saisi un mot de passe incorrect. Utilisez le mot de passe choisi lors de la création de l’exportation pour restaurer votre ID %@. Vérifiez votre saisie et réessayez."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ID-Export isch ungültig, oder Sie händ es falsches Passwort igeh. Bruuched Sie s’Passwort, wo Sie bim Erstelle vom Export gwählt händ, zum Ihri %@-ID wiederherzstelle. Bitte überprüefed Sie Ihri Iigabe und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati relativi all’ID esportato non sono validi oppure è stata inserita una password errata. Per ripristinare il %@ ID, utilizza la password scelta durante la creazione dell’esportazione. Controlla i dati inseriti e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDのエクスポートデータが無効であるか、間違ったパスワードを入力している可能性があります。%@ IDを復元するには、エクスポートを作成したときに選択したパスワードを使用してください。入力内容をご確認の上、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 내보내기 데이터가 잘못되었거나 잘못된 암호를 입력했습니다. %@ ID를 복원하려면 내보내기를 생성할 때 선택한 암호를 사용하십시오. 입력을 확인하고 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevens van het ID-exportbestand zijn ongeldig of u hebt het verkeerde wachtwoord ingevoerd. Gebruik het wachtwoord dat u koos toen u het exportbestand uitvoerde om uw %@ ID te herstellen. Controleer de invoer en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane eksportu ID są nieprawidłowe lub wprowadzono nieprawidłowe hasło. Użyj hasła wybranego podczas tworzenia eksportu, aby przywrócić ID %@. Sprawdź wprowadzone dane i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de exportação da ID são inválidos ou você digitou a senha errada. Use a senha que você escolheu quando criou a exportação para restaurar a sua ID do %@. Verifique a sua digitação e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные экспорта ID неправильные или вы ввели неправильный пароль. Чтобы восстановить %@ ID, воспользуйтесь паролем, который вы выбрали при экспорте. Проверьте введенные данные и попробуйте еще раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje exportu ID sú neplatné, alebo ste zadali zlé heslo. Ak chcete obnoviť vaše %@ ID, zadajte heslo, ktoré ste uviedli pri vytváraní exportu. Skontrolujte, či ste všetko zadali správne a skúste to znovu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışarı aktarılan kimlik verileri geçersiz veya yanlış şifre girdiniz. %@ kimliğinizi geri yüklemek için dışa aktarım yapılırken seçtiğiniz parolayı kullanın. Lütfen şifrenizi kontrol edin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані експортованого ID недійсні або ви ввели хибний пароль. Використовуйте пароль, який ви ввели під час експортування для відновлення свого %@ ID. Перевірте введені дані та повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 导出数据无效，或者您输入了错误的密码。请使用您创建导出时选择的密码来恢复您的 %@ ID。請檢查您的輸入，再試一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 匯出資料無效，或者您輸入了錯誤的密碼。請使用您建立匯出時選擇的密碼以還原您的 %@ ID。請檢查您的輸入，再試一次。"
          }
        }
      }
    },
    "bad_phone_number_format_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведеният телефонен номер не може да бъде разпознат. Моля, опитайте се да го въведете в международен формат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vámi zadané telefonní číslo nebylo rozeznáno. Zkuste jej uvést v mezinárodním formátu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eingegebene Telefonnummer wurde nicht erkannt. Bitte versuchen Sie, die Nummer im internationalen Format einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone number that you have entered could not be recognized. Please try entering it in international format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha reconocido el número introducido. Intente introducir el número en su formato internacional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le numéro de téléphone que vous avez saisi n’a pas pu être reconnu. Essayez de le saisir dans son format international."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Telefonnummere, wo Sie ageh händ, isch nöd erchännt worde. Bitte versueched Sie, d’Nummere im internationale Format iizgeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di telefono inserito non è stato riconosciuto. Inserisci il numero in formato internazionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力された電話番号が認識されませんでした。国際的なフォーマットで番号を入力してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 전화번호를 인식할 수 없습니다. 국제적인 형식으로 입력해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het telefoonnummer dat je hebt ingevoerd, werd niet herkend. Voor het opnieuw in met het landnummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podany numer telefonu nie został rozpoznany. Spróbuj wprowadzić go w formacie międzynarodowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O número de telefone que você digitou não pode ser reconhecido. Tente digitá-la no formato internacional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введенный вами номер телефона не может быть распознан. Попробуйте ввести номер в международном формате."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefónne číslo, ktoré ste zadali nebolo rozpoznané. Skúste ho prosím zadať v medzinárodnom formáte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girdiğiniz telefon numarası tanınamadı. Lütfen uluslararası formatta girmeyi deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номер телефону, що ви вказали, не вдалось розпізнати. Будь ласка, введіть його у міжнародному форматі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您输入的电话号码无法被识别。请尝试以国际格式输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您輸入的電話號碼無法被識別。請嘗試以國際格式輸入。"
          }
        }
      }
    },
