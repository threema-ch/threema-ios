    "level1_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакт, чийто телефонен номер и/или имейл се съдържа в списъка Ви с контакти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt, jehož telefonní číslo a/nebo e‑mailová adresa je ve vašem adresáři."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt, dessen Rufnummer und/oder E-Mail-Adresse in Ihrem Adressbuch enthalten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact whose phone number and/or email address is contained in your address book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacto con un número de teléfono o dirección de correo electrónico en su libreta de direcciones. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contact dont le numéro de téléphone ou l’adresse e-mail se trouve dans votre carnet d’adresses."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt, vo dem d’Handynummere und/oder d’E-Mail-Adrässe i Ihrem Adrässbuech drin isch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contatto presente nella tua rubrica con numero di telefono e/o indirizzo e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレス帳に登録されている電話番号や電子メールアドレスを持つ連絡先。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화번호 및/또는 이메일 주소가 주소록에 포함된 연락처."
          }
        },
        "nl" : {
