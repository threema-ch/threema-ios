    "new_message_db_requires_migration" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да избегнете загубата на съобщения, отворете приложението и довършете актуализацията."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Threema byla aktualizována, otevřete ji a dokončete aktualizaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um keine Nachrichten zu verpassen, schliessen Sie das Update durch Öffnen der App ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To avoid missing messages, please complete the update by opening the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar perder mensajes, complete la actualización abriendo la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour éviter de manquer des messages, veuillez terminer la mise à jour en ouvrant l’application."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema isch aktualisiert worde. Bitte öffned Sie d’App, demit s’Update cha abgschlosse werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per non perdere messaggi, completa l'aggiornamento aprendo l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threemaはアップデートされました。アプリを開いてアップデートを完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema가 업데이트되었습니다. 업데이트를 완료하려면 앱을 열어주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema is geüpdatet, open de app om de update te voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizowano aplikację Threema. Aby zakończyć aktualizację, otwórz aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Threema foi atualizado. Abra o aplicativo para concluir a atualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение Threema обновлено, откройте приложение, чтобы завершить обновление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ste nepremeškali žiadne správy, dokončite aktualizáciu otvorením aplikácie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema güncellendi, lütfen güncellemeyi tamamlamak için uygulamayı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не пропустити нові повідомлення, відкрийте застосунок для завершення оновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了避免错过消息，请打开应用程序完成更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了避免錯過訊息，請開啟應用程式以完成更新。"
          }
        }
      }
    },
