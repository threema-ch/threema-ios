    "restricted_linked_contact_access_edit_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ няма достъп до Вашия свързан контакт заради ограничения достъп. Попитайте Вашия началник да Ви даде достъп до контактите или премахнете връзката към контакта перманентно, за да го редактирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli omezeným oprávněním nemá %@ přístup k vašemu propojenému kontaktu. Požádejte svého nadřízeného o přístup ke kontaktům. Můžete také kontakt trvale odpojit a poté provést jeho úpravu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht auf den verknüpften Kontakt zugreifen, weil der Zugriff eingeschränkt ist. Bitten Sie Ihren Administrator, diese Einschränkung aufzuheben. Oder heben Sie die Verknüpfung permanent auf, um den Kontakt zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unable to access your linked contact due to access restrictions. Ask your supervisor to grant access to Contacts. Or unlink contact permanently to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede acceder a su contacto vinculado debido a las restricciones de acceso. Pida a su supervisor que conceda acceso a los contactos o desvincule el contacto permanentemente para editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est incapable d’accéder à votre contact lié à cause des restrictions d’accès. Demandez à votre superviseur d’accorder l’accès aux contacts. Vous pouvez sinon dissocier le contact de façon permanente pour apporter des modifications."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cha nöd uf de verchnüpft Kontakt zuegriife, wil de Zuegriff igschränkt isch. Bitted Sie Ihre Administrator, die Ischränkig ufzhebe. Oder hebed Sie d’Verchnüpfig permanent uf, zum de Kontakt z’bearbeite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può accedere al contatto collegato a causa dell’accesso limitato. Chiedi il tuo amministratore di concedere l’accesso ai contatti oppure rimuovi il collegamento in modo permanente per modificare il contatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス制限のため、%@は紐付けされた連絡先にアクセスできません。責任者に連絡先へのアクセス許可を依頼してください。または、連絡先の紐付けを永久に解除して編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근 제한으로 인해 %@는 연결된 연락처에 접근할 수 없습니다. 관리자에게 연락처 접근 권한을 요청하십시오. 또는 편집하기 위해 연락처 연결을 영구적으로 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft vanwege toegangsbeperkingen geen toegang tot je gekoppelde contactpersonen. Vraag je supervisor om toegang tot de contactpersonen. Of verbreek de koppeling met de contactpersoon permanent om deze te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma dostępu do kontaktu powiązanego  z powodu ograniczeń dostępu. Poproś przełożonego o dostęp do Kontaktów lub trwale usuń powiązanie kontaktu do edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ não conseguiu acessar o seu contato vinculado devido a restrições de acesso. Peça ao seu supervisor para conceder acesso aos Contatos ou desvincule o contato permanentemente para editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может получить доступ к привязанному контакту из-за ограничений на доступ. Попросите своего начальника предоставить доступ к контактам. Либо отсоедините контакт окончательно для редактирования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nemôže získať prístup k vášmu prepojenému kontaktu z dôvodu obmedzení prístupu. Požiadajte svojho nadriadeného o udelenie prístupu ku kontaktom. Alebo zrušte prepojenie kontaktu natrvalo a upravte ho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, erişim kısıtlamaları nedeniyle bağlı kişinize erişemiyor. Yöneticinizden Kişiler'e erişim izni vermesini isteyin veya düzenlemek için kişinin bağlantısını kalıcı olarak kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не може отримати доступ до вашого прив’язаного контакту через обмеження доступу. Попросіть свого керівника надати доступ до Контактів. Або назавжди від’єднайте контакт, щоб редагувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于系统访问限制，%@ 无法访问您的已链接联系人。请向您的主管授予访问通讯录的权限，或者编辑永久解除链接的联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於系統取用限制，%@ 無法取用您的已連結聯絡人。請向您的主管授予取用通訊錄的權限，或者編輯永久解除連結的聯絡人。"
          }
        }
      }
    },
