    "multi_device_join_sending_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новото устройство ще запази независимо копие на Вашия %@ профил и съобщенията ще бъдат изпращани и получавани от Ваше име."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na novém zařízení se uloží nezávislá kopie vašeho profilu %@ a zprávy budou odesílány a přijímány vaším jménem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Gerät speichert eine unabhängige Kopie Ihres %@-Profils, und Nachrichten werden in Ihrem Namen gesendet und empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new device will store an independent copy of your %@ profile, and messages will be sent and received on your behalf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo dispositivo almacenará una copia independiente de su perfil de %@, y los mensajes se enviarán y recibirán en su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouvel appareil stockera une copie indépendante de votre profil %@ et les messages seront envoyés et reçus à votre place."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’neue Grät speicheret e unabhängigi Kopie vo Ihrem %@-Profil, und Nachrichte werded i Ihrem Name gschickt und empfange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nuovo dispositivo memorizzerà una copia indipendente del tuo profilo %@ e i messaggi verranno inviati e ricevuti per tuo conto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい端末はあなたの%@プロフィールの独立したコピーを保存し、メッセージはあなたに代わって送受信されます。"
          }
        },
        "ko" : {
