    "settings_orphaned_files_bin_delete_confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искате ли да изтриете перманентно ненужните файлове? Това действие е необратимо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejete si permanentně odstranit osiřelé soubory? Tuto akci nelze vzít zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie die verwaisten Dateien unwiderruflich löschen? Diese Aktion lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like to permanently delete the orphaned files? This action cannot be undone."
