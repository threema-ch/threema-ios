    "app_setup_steps_failed_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, проверете Вашата интернет връзка и опитайте отново. Ако проблемът продължава, свържете се с поддръжката."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte své připojení k internetu a zkuste to znovu. Bude-li problém přetrvávat, obraťte se na naši podporu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut. Falls das Problem weiterhin besteht, wenden Sie sich bitte an den Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please check your Internet connection and try again. If the problem persists, please contact our support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compruebe su conexión a Internet e inténtelo de nuevo. Si el problema persiste, póngase en contacto con nuestro equipo de asistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez vérifier votre connexion Internet et réessayer. Si le problème persiste, veuillez contacter notre assistance."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte prüefed Sie Ihri Internetverbindig und versueched Sie’s nomal. Falls s’Problem wiiterhin bestaht, wänded Sie sich bitte an Support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la connessione a Internet e riprova. Se il problema persiste, contatta l'assistenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認して、もう一度やり直してください。問題が解決しない場合はサポートにお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결을 확인하고 다시 시도하세요. 문제가 지속되면 지원팀에 문의하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer uw internetverbinding en probeer het opnieuw. Neem contact op met ondersteuning als het probleem aanhoudt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie internetowe i spróbuj ponownie. Jeśli problem dalej występuje, skontaktuj się z pomocą techniczną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a sua conexão com a internet e tente novamente. Caso o problema persista, entre em contato com o suporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте соединение с Интернетом и повторите попытку. Если проблема не исчезнет, обратитесь в службу поддержки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte svoje internetové pripojenie a skúste to znova. Ak problém pretrváva, kontaktujte našu podporu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen İnternet bağlantınızı kontrol edin ve tekrar deneyin. Sorun devam ederse, lütfen destek ekibimizle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, перевірте зʼєднання з інтернетом та спробуйте знов. Якщо проблема залишається, будь ласка, звʼяжіться з нашою підтримкою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查您的网络连接并重试。如果问题仍然存在，请联系我们的客服。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查您的網路連線並再試一次。如果問題仍然存在，請聯絡我們的支援人員。"
          }
        }
      }
    },
