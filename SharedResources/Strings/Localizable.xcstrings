    "multi_device_new_linked_devices_failed_to_load" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се заредят свързаните устройства. Моля, проверете Вашата интернет връзка и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze načíst propojená zařízení. Zkontrolujte své připojení k internetu a potažením dolů to zkuste znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräteliste konnte nicht geladen werden. Bitte überprüfen Sie die Internetverbindung und ziehen Sie anschliessend die Ansicht nach unten, um sie neu zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to load linked devices. Please check your Internet connection and pull down to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al cargar los dispositivos vinculados. Compruebe su conexión a Internet y tire hacia abajo para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les appareils associés, veuillez vérifier votre connexion Internet et tirer vers le bas pour réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gräteliste hät nöd chöne glade werde. Bitte überprüefed Sie d’Internetverbindig und ziehnd Sie nachher d’Asicht abe, zum sie neu z’lade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i dispositivi collegati. Controlla la connessione a Internet e scorri verso il basso per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紐付けされた端末の読み込みに失敗しました。インターネット接続を確認し、プルダウンして再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 기기를 로드하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하려면 아래로 당기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gekoppelde apparaten zijn niet geladen. Controleer uw internetverbinding en veeg omlaag om het opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można załadować połączonych urządzeń. Sprawdź połączenie internetowe i pociągnij w dół, aby spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao carregar dispositivos vinculados. Verifique a sua conexão com a internet e puxe para tentar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить привязанные устройства, проверьте соединение с Интернетом и потяните экран вниз, чтобы повторить попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepojené zariadenia sa nepodarilo načítať. Skontrolujte svoje internetové pripojenie a potiahnutím nadol to skúste znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı cihazlar yüklenemedi. Lütfen internet bağlantınızı kontrol edin ve tekrar denemek için aşağı çekin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити прив’язані пристрої. Перевірте інтернет-з'єднання та потягніть вниз, щоб спробувати ще раз."
          }
