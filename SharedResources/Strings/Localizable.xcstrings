    "group_dissolve_sheet_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако разпуснете групата, никой няма да може да изпраща съобщения до групата и тя няма да може да се управлява. Разпуснатата група все още може да бъде клонирана."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud skupinu jen rozpustíte, nikdo už do ní nebude moci odesílat nové zprávy a nebude možné ji spravovat. Rozpuštěnou skupinu stále lze klonovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Gruppe nur auflösen, kann niemand mehr neue Nachrichten in die Gruppe senden, und sie lässt sich auch nicht mehr verwalten. Die aufgelöste Gruppe kann weiterhin geklont werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you just dissolve the group, nobody can send new messages to the group anymore, and it can no longer be managed. The dissolved group can still be cloned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si solo disuelves el grupo, nadie podrá enviar mensajes nuevos al grupo ni convertirse en su administrador. Un grupo disuelto se puede clonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous dissolvez le groupe, personne ne pourra plus envoyer de nouveaux messages dans le groupe et celui-ci ne pourra plus être géré. Il sera quand même possible de cloner le groupe dissous."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie d’Gruppe nur uflösed, cha niemer meh neui Nachrichte id Gruppe schicke, und sie laht sich au nüme verwalte. Die ufglösti Gruppe cha wiiterhin klont werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se chiudi il gruppo, nessuno può inviare nuovi messaggi al gruppo e il gruppo non può più essere amministrato. Il gruppo chiuso può tuttavia ancora essere clonato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループを解散しただけでは、誰もそのグループに新しいメッセージを送ることができなくなり、管理もできなくなりますが、解散したグループは複製することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹을 해체하면 더 이상 그룹에 새로운 메시지를 보낼 수 없으며 더 이상 관리할 수 없습니다. 해체된 그룹은 여전히 복제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de groep slechts ontbindt, kan niemand meer nieuwe berichten naar de groep sturen, en kan de groep niet meer worden beheerd. De ontbonden groep kan nog wel worden gekloond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli tylko rozwiążesz grupę, nikt nie będzie mógł wysyłać nowych wiadomości do grupy i nie będzie mozna nią zarządzać. Rozwiązaną grupę ciągle można klonować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se apenas dissolver o grupo, ninguém mais poderá enviar novas mensagens ao grupo, e ele não poderá mais ser gerenciado. O grupo dissolvido ainda poderá ser clonado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если просто распустить группу, никто больше не сможет отправлять сообщения группе, также станет невозможным управление ею. Распущенную группу можно клонировать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak skupinu rozpustíte, nikto už do skupiny nebude môcť posielať nové správy a už ju nebude možné spravovať. Rozpustená skupina môže byť stále klonovaná."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grubu dağıtırsanız, artık kimse gruba yeni mesaj gönderemez ve artık yönetilemez. Dağıtılan grup yine de kopyalanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви просто розпустите групу, ніхто більше не зможе надсилати повідомлення групі та нею не можна буде керувати. Розпущену групу можна клонувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您只是解散群组，没有人可以再向此群组发送新消息，并且无法再对群组进行管理，而解散的群组仍然可以被克隆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您只是解散群組，沒有人可以再向此群組傳送新訊息，並且無法再對群組進行管理，而解散的群組仍然可以被克隆。"
          }
        }
      }
    },
