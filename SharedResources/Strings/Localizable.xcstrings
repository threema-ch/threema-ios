    "group_different_identity" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази група бе създадена докато използвахте друг %@ идентификатор. Не можете да изпращате съобщения в нея докато използвате настоящия идентификатор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V době vytvoření této skupiny jste používali jiné %@ ID. Se svým současným ID do ní nemůžete odeslat žádnou zprávu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe wurde erstellt, als Sie eine andere %@-ID genutzt haben. Sie können mit Ihrer aktuellen ID keine Nachrichten an diese Gruppe senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group was created while you were using a different %@ ID. You cannot send any messages to it with your current ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crear este grupo, utilizó otro ID de %@. No puede enviar mensajes a este grupo con su ID actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce groupe a été créé pendant que vous utilisiez un autre ID %@. Vous ne pouvez pas envoyer des messages avec votre ID en cours."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe isch erstellt worde, wo Sie e anderi %@-ID gnutzt händ. Mit Ihrere aktuelle ID chönd Sie kei Nachrichte a die Gruppe schicke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gruppo è stato creato quando utilizzavi un altro %@ ID. Con il tuo ID attuale non puoi inviare messaggi a questo gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループは、あなたが別の%@ IDを使用していたときに作成されました。現在のIDでは、このグループにメッセージを送ることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신이 다른 %@ ID를 사용하고 있을 때 이 그룹이 생성되었습니다. 현재 ID로 이 그룹에 메시지를 보낼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze groep is aangemaakt terwijl je een ander %@-ID gebruikte. Je kunt er geen berichten naar sturen met je huidige ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta grupa została utworzona podczas używania innego  %@ ID. Nie można wysyłać do niego żadnych wiadomości z aktualnym ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo foi criado enquanto você estava usando uma ID diferente do %@. Você não pode enviar mensagens para ele com a sua ID atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда создавалась эта группа, вы использовали другой %@ ID. Вы не можете отправлять сообщения с текущим ID."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto skupina bola vytvorená keď ste používali iné %@ ID. S vašim súčasným ID nemôžete do tejto skupiny odoslať žiadnu správu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grup, siz farklı bir %@ kimliği kullanırken oluşturuldu. Mevcut kimliğinizle ona mesaj gönderemezsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю групу створено коли у вас був інший %@ ID. Ви не можете надсилати повідомлення до групи з поточним ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个群组是您在使用其他 %@ ID 时创建的。您无法使用您当前的ID发送任何消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個群組是您在使用其他 %@ ID 時建立的。您無法使用您目前的ID傳送任何訊息。"
          }
        }
      }
