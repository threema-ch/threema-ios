    "add_note_group_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Вие сте единственият член на тази група*\nИзползвайте този чат за водене на лични бележки, за изображения или документи, които са Ваши лични."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Jste tu sami*\nTuto konverzaci můžete používat jako bezpečný zápisník pro textové poznámky, média a dokumenty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Sie sind alleine hier*\nVerwenden Sie diesen Chat als sicheres Notizbuch für Texte, Medien oder Dokumente."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*You’re alone in here*\nUse this chat as a secure notebook for text, media, and documents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Está solo aquí*\nUse este chat como una libreta segura para almacenar mensajes de texto, archivos multimedia y documentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Il n’y a que vous ici*\nUtilisez ce chat comme bloc-notes sécurisé pour les textes, les médias et les documents."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Sie sind ellei da ine*\nBruched Sie de Chat als sichers Notizbuech für Text, Medie oder Dokument."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Non sono presenti altre persone*\nUsa questa chat come taccuino sicuro per testi, media o file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*あなたはここでは一人です*\nこのトークは安全なノート・メディア・ドキュメントとして使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*여기엔 당신 혼자입니다*\n이 채팅을 텍스트, 미디어, 문서를 위한 안전한 노트북으로 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*U bent hier helemaal alleen*\nGebruik deze chat als een beveiligd notitieboekje voor tekst, mediabestanden en documenten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Jesteś tu sam(-a)*\nUżywaj tego czatu jako bezpiecznego notesu do przechowywania tekstów, plików multimedialnych i dokumentów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Você não está sozinho(a) aqui*\nUse este bate-papo como um bloco de notas seguro para texto, mídia e documentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Вы здесь в одиночестве*\nИспользуйте этот чат как защищенный блокнот для заметок, мультимедийных файлов и документов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ste tu úplne sám*\nTúto konverzáciu použite na bezpečné ukladanie textových poznámok, médií a dokumentov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Burada yalnızsınız*\nBu sohbeti metin, medya ve belgeler için güvenli bir not defteri olarak kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Тут лише ви*\nВикористовуйте цей чат як надійний нотатник для тексту, медіафайлів та документів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*在此会话中只有您一个人能访问*\n将此会话用作保存文本、媒体和文件的安全笔记本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*在此對話中只有您一個人能存取*\n將此對話用作儲存文字、媒體和檔案的安全筆記本。"
          }
        }
      }
    },
