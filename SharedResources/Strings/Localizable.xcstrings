            "value" : "Alle oproepen doorschakelen via %@-servers om je IP-adres te beschermen. Dit kan de kwaliteit beïnvloeden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuś przekazywanie wszystkich połączeń przez serwery %@, chroniąc swój adres IP. Może wpływać na jakość połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retransmita todas as chamadas através dos servidores do %@ para ocultar o seu endereço de IP dos parceiros de chamada. Isso pode afetar a qualidade da chamada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительно ретранслировать все звонки через ваши серверы %@ с защитой вашего IP-адреса. Может ухудшаться качество связи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presmeruje všetky hovory cez vaše %@ servery, aby ste skryli IP adresu pred volajúcimi partnermi. Môže byť ovplyvnená kvalita hovoru."
