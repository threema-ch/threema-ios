    "archived_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да видите Архивираните Чатове, натиснете бутона долу в превизуализацията на чата."
