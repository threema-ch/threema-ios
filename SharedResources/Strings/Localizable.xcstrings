    "enter_license_work_admin_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забравили сте Вашите данни за вписване? Моля, свържете се с Вашия %@ администратор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomněli jste své přihlašovací údaje? Obraťte se na svého správce %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten vergessen? Melden Sie sich bei Ihrem %@-Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your credentials? Please contact your %@ administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ha olvidado sus credenciales? Póngase en contacto con su administrador de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez oublié vos identifiants ? Veuillez contacter votre administrateur %@."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuegangsdate vergesse? Mälded Sie sich bi Ihrem %@-Administrator."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dimenticato le credenziali? Contatta l'amministratore %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資格情報を忘れましたか？%@の管理者に連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명을 잊으셨나요? %@ 관리자에게 연락하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bent u uw toegangsgegevens vergeten? Neem contact op met de beheerder van %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pamiętasz swoich referencji? Skontakuj się ze swoim administratorem %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueceu das suas credenciais? Entre em contato com o seu administrador do %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыли свои учетные данные? Обратитесь к своему администратору %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabudli ste svoje poverenia? Obráťte sa na vášho správcu %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik bilgilerinizi mi unuttunuz? Lütfen %@ yöneticinizle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забули свої облікові дані? Зверніться до свого адміністратора %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记了您的凭证？请联系您的 %@ 管理员。"
