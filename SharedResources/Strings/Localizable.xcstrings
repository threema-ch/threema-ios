        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während dem Verknüpfungsvorgang werden Anrufe und Benachrichtigungen deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the linking process, calls and notifications are disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el proceso de vinculación, se desactivan las llamadas y las notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le processus de liaison, les appels et les notifications sont désactivés."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während em Verchnüpfigsvorgang werded Arüef und Benachrichtigunge deaktiviert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante il collegamento, le chiamate e le notifiche sono disattivate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク処理中は通話と通知が無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 프로세스 중에는 통화와 알림이 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens het koppelingsproces zijn oproepen en meldingen uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas procedury łączenia połączenia i powiadomienia są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
