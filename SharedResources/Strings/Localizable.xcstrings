    "group_leave_delete_sheet_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако напуснете и изтриете групата, Вие вече няма да можете да участвате в разговора и чат историята ще бъде изтрита."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud skupinu opustíte a odstraníte, nebudete se již moci konverzace účastnit a historie konverzace bude odstraněna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Gruppe verlassen und löschen, können Sie nicht mehr an der Konversation teilnehmen, und der Nachrichtenverlauf wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you leave and delete the group, you can no longer participate in the conversation, and the chat history will be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si abandonas y eliminas el grupo, no podrás volver a participar en la conversación y se eliminará el historial del chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez et supprimez le groupe, vous ne pourrez plus participer à la conversation et l'historique de discussion sera supprimé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie d’Gruppe verlönd und lösched, chönd Sie nüme a de Konversation teilneh, und de Nachrichteverlauf wird glöscht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abbandoni e cancelli il gruppo non puoi più partecipare alla conversazione e la cronologia della chat verrà cancellata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループを退会して削除すると、会話に参加できなくなり、トーク履歴も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹을 나가고 삭제하면 더 이상 대화에 참여할 수 없으며 채팅 기록이 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de groep verlaat en deze verwijdert, kun je niet meer deelnemen aan het gesprek en wordt de chatgeschiedenis verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli opuścisz i usuniesz tę grupę, nie możesz już brać udziału w konwersacji, a historia czatu zostanie usunięta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sair do grupo e excluí-lo, você não poderá mais participar da conversa, e o histórico do bate-papo será excluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выйти и удалить группу, вы больше не сможете принимать участие в обсуждении, также будет удалена история чата."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak práve odídete, už sa nemôžete zúčastniť konverzácie, ale stále máte prístup k histórii chatu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruptan ayrılır ve silerseniz, artık sohbete katılamazsınız ve sohbet geçmişi silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви вийдете й видалите групу, то не зможете брати участь у подальшій розмові, а історію діалогу буде видалено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您离开并删除群组，您将无法再参与会话，并且聊天记录将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您離開並刪除群組，您將無法再參與對話，並且歷史對話記錄將被刪除。"
          }
        }
      }
    },
