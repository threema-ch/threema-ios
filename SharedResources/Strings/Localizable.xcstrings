    "no_linked_contact_access_edit_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, отворете настройките и позволете достъпа до контактите, за да редактирате свързаните контакти. Можете и да премахнете връзката на контакта перманентно, за да го редактирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li upravit propojený kontakt, otevřete Nastavení a povolte přístup ke kontaktům. Můžete také kontakt trvale odpojit a poté provést jeho úpravu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte öffnen Sie die Einstellungen, um den Zugriff auf die Kontakte zu erlauben und den verknüpften Kontakt anzuzeigen. Oder heben Sie die Verknüpfung permanent auf, um den Kontakt zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please open Settings and allow Contacts access to edit linked contact. Or unlink contact permanently to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre los ajustes para permitir el acceso a los contactos y editar el contacto vinculado o desvincula el contacto permanentemente para editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez ouvrir les Réglages et accorder l’accès aux contacts pour modifier le contact lié. Vous pouvez sinon dissocier le contact de façon permanente pour apporter des modifications."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte mached Sie d’Iistellige uf, zum de Zuegriff uf d’Kontäkt z’erlaube und de verchnüpfti Kontakt ah z’zeige. Oder hebed Sie d’Verchnüpfig permanent uf, zum de Kontakt z’bearbeite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri le impostazioni per consentire l’accesso ai contatti e per visualizzare il contatto collegato, oppure rimuovi il collegamento in modo permanente per modificare il contatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を開き、連絡先へのアクセスを許可すると、紐付けされた連絡先を編集できます。または、連絡先の紐付けを永久に解除して編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 연락처를 편집하기 위해 설정을 열고 연락처 접근 권한을 허용하십시오. 또는 편집하기 위해 연락처 연결을 영구적으로 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de Instellingen en geef toegang tot Contactpersonen om de gekoppelde contactpersoon te bewerken. Of verbreek de koppeling met de contactpersoon permanent om deze te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Ustawienia i udziel dostępu do edytowania kontaktów powiązanych. lub trwale usuń powiązanie kontaktu do edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra as Configurações e autorize o acesso aos Contatos para editar o contato vinculado. Ou desvincule o contato permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте доступ и разрешите контактам доступ для редактирования привязанного контакта. Или отсоедините контакт окончательно для редактирования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete upraviť prepojený kontakt, otvorte prosím nastavenia a povolte prístup ku kontaktom. Alebo kontakt natrvalo odpojte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen Ayarlar'ı açın ve bağlı kişiyi düzenlemek için Kişiler'e erişim izin verin veya düzenlemek için kişinin bağlantısını kalıcı olarak kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Налаштування та дозвольте Контактам доступ до редагування прив'язаних контактів. Або відв'яжіть контакт для редагування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开 “设置” 并允许 “通讯录” 访问以编辑已链接的联系人，或者编辑永久解除链接的联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟「設定」並允許「通訊錄」取用以編輯已連結的聯絡人，或者編輯永久解除連結的聯絡人。"
          }
        }
      }
    },
