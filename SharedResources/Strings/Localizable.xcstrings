    "safe_configure_server_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да използвате сървъра на %@ или да изберете сървър за резервни копия от трети страни."
          }
        },
        "cs" : {
          "stringUnit" : {
