    "webClientSession_error_voip_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ се опита да се свърже с Вашия компютър. Моля, прекратете сесията на Вашия компютър и започнете нова."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ se pokusila připojit se k vašemu počítači. Zapomeňte na relaci ve svém počítači a spusťte novou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ versuchte, eine Verbindung mit Ihrem Computer herzustellen. Bitte löschen Sie die gespeicherte Sitzung auf dem Computer und starten Sie eine neue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tried to connect to your computer. Please forget the session on your computer and start a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha intentado conectarse a tu ordenador. Olvida la sesión en tu ordenador e inicia una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a tenté de se connecter à votre ordinateur. Veuillez oublier la session sur votre ordinateur et en initier une nouvelle."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hät versuecht, e Verbindig mit Ihrem Compi herzstelle. Bitte lösched Sie di gspeicheret Sitzig ufem Compi und started Sie e neui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha cercato di stabilire un collegamento con il tuo computer. Cancella sul tuo computer la sessione salvata e avviane una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのコンピュータに%@が接続しようとしました。コンピュータのセッションを破棄して、新しいセッションを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 컴퓨터에 연결을 시도했습니다. 컴퓨터에서 세션을 잊고 새로 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wil verbinding maken met je computer. Vergeet de sessie op je computer en start een nieuwe sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użytkownik %@ próbował połączyć się z twoim komputerem. Zapomnij sesję na komputerze i rozpocznij nową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tentou se conectar ao seu computador. Esqueça a sessão no seu computador e inicie uma nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ пытается подключиться к вашему компьютеру. Закройте сеанс на компьютере и начните новый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa pokúsil pripojiť k vášmu počítaču. Zabudnite na reláciu na počítači a začnite novú."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bilgisayarınıza bağlanmayı denedi. Lütfen bilgisayarınızdaki oturumu unutun ve yeni bir oturum başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ намагався(-лася) під’єднатися до вашого комп’ютера. Вимкніть сесію на вашому комп’ютері й почніть нову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尝试连接到您的电脑。请您先忘记电脑上现时的会话，然后再启动另一个新会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 嘗試連線到您的電腦。請您先忘記電腦上現時的工作階段，然後再啟動另一個新工作階段。"
          }
        }
      }
    },
