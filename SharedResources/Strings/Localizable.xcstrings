    "settings_advanced_contacts_cleanup_log_disabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логовете/журналите са деактивирани.\n\nМоля, върнете се в „разширени“, включете “дебъг логовете/журналите“ и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávání je zakázáno.\n\nVraťte se do nabídky „Pokročilé“, aktivujte položku „Záznam ladění“ a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Debug Log ist deaktiviert.\n\nBitte gehen Sie zurück zu «Erweitert», aktivieren das «Debug Log», und versuchen es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logging is disabled.\n\nPlease go back to Advanced, turn on Debug Log, and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro está deshabilitado.\n\nVuelva a Avanzado, active Registro de depuración e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consignation est désactivée.\n\nVeuillez revenir à « Avancé, » activer « Journal de débogage » et réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’Debug-Log isch deaktiviert. \n\nBitte gönd Sie zrugg zu «Erwiiteret», aktiviered Sie s’Debug-Log, und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione è disabilitata.\n\nTorna ad \"Avanzate\", attiva \"Registro di debug\" e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログが無効になっています。\n\n「詳細設定」に戻り、「デバッグログ」を有効にして、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깅이 비활성화되었습니다.\n\n\"고급\"으로 돌아가 \"디버그 로그\"를 켜고 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het loggen is uitgeschakeld.\n\nGa terug naar 'Geavanceerd', zet 'Debug log' aan en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejestrowanie jest wyłączone.\n\nWróć do opcji Zaawansowane, włącz funkcję Dziennik debugowania i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A criação de logs está desativada.\n\nVá até \"Avançado\", ative \"Log de depuração\" e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведение журнала отключено.\n\nВернитесь на экран \"Расширенный\", включите \"Журнал отладки\" и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolovanie je vypnuté.\n\nVráťte sa späť do časti \"Rozšírené\", zapnite funkciu \"Debug Log\" a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük kaydı devre dışı.\n\nLütfen \"Gelişmiş\" bölümüne geri dönün, \"Hata Ayıklama Günlüğü \"nü açın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведення журналу вимкнено.\n\nПоверніться до розділу \"Додатково\", увімкніть \"Журнал налагодження\" і спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试日志记录已禁用。\n\n请先返回 “高级设置”，再打开 \"调试日志\"，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵錯記錄已停用。\n\n請先返回「進階設定」，再開啟「偵錯記錄」，然後再試一次。"
          }
        }
      }
    },
