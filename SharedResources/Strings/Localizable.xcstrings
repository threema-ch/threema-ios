        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatto. In caso di problemi con l’impostazione di una connessione per le chiamate, invia questo risultato all’assistenza di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了しました。通話接続に問題がある場合は、この結果を%@サポートに送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료되었습니다. 통화 연결에 문제가 있는 경우 이 음성을 %@ 지원팀에 보내주십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
