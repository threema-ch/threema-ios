    "work_availability_status_chat_tip_text" : {
      "comment" : "Text displayed in a chat message when the user's work availability status is set.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте дали някой е зает или недостъпен преди да му пишете. Може да зададете собствения Ви статус в профила."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistěte, zda ten, komu se chystáte napsat, není zaneprázdněný nebo nedostupný. Ve svém profilu můžete nastavit vlastní stav."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie vor dem Senden einer Nachricht, ob jemand beschäftigt oder abwesend ist. Ihren eigenen Status können Sie im Profil festlegen.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See if someone is busy or unavailable before messaging them. You can set your own status in your profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea si alguien está ocupado o no está disponible antes de enviarle un mensaje. Puede elegir su estado en su perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez voir si votre interlocuteur est occupé ou indisponible avant de lui envoyer un message. Vous pouvez définir votre propre statut dans votre profil."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahred Sie vorem Schicke vonere Nachricht, öb öpper beschäftigt oder abwesend isch. Ihre eiget Status chönd Sie im Profil festlegge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di inviare un messaggio, verifica se la persona è occupata o non disponibile. Puoi impostare il tuo stato nel tuo profilo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zistite, či je niekto zaneprázdnený alebo nedostupný, pred tým ako im pošlete správu. Môžete si nastaviť vlastný stav vo svojom profile."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birine mesaj atmadan önce meşgul veya uygun olmadığını kontrol edin. Kendi durumunuzu profilinizde ayarlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте, чи зайнятий або недоступний контакт, перед тим як надсилати йому повідомлення. Ви можете встановити власний статус у своєму профілі."
          }
        },
