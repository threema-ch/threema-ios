    "settings_privacy_os_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако е включена опцията, %@ контактите ще бъдат препоръчвани, когато споделяте съдържание в iOS. Споделянето на взаимодействия разкрива информация на iOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je tato funkce zapnuta, budou se při sdílení obsahu v iOS nabízet kontakty %@. Sdílení interakcí odhalí informace systému iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden %@-Kontakte beim Teilen von Inhalten in iOS vorgeschlagen. Dadurch werden Informationen zu Interaktionen ans Betriebssystem weitergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If turned on, %@ contacts will be suggested when sharing content in iOS. Sharing interactions exposes information to iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la opción está activada, se sugerirán contactos de %@ al compartir contenido en iOS. Compartir interacciones expone información a iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce paramètre est activé, des contacts %@ seront suggérés lors du partage de contenu sur iOS. Le partage d'interactions expose des informations à iOS."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werded %@-Kontäkt bim Teile vo Inhält in iOS vorgschlage. Dur das werded Informatione zu Interaktione as Betribssystem wiitergeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivata, i contatti %@ vengono suggeriti quando si condividono contenuti in iOS. In questo modo le informazioni sulle interazioni vengono trasmesse al sistema operativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、iOSでコンテンツを共有する際に%@の連絡先が提案されるようになります。インタラクションを共有することで、iOSに情報が公開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만약 켜져 있다면, iOS에서 콘텐츠를 공유할 때 %@ 연락처가 제안됩니다. 공유 상호작용은 정보를 iOS에 노출시킵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, worden er contactpersonen van %@ voorgesteld wanneer er in iOS inhoud wordt gedeeld. Het delen van interacties onthult informatie aan iOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli opcja jest włączona, kontakty %@ będą sugerowane podczas udostępniania treści w iOS. Udostępnianie interakcji ujawnia informacje w systemie iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, contatos do %@ serão sugeridos ao compartilhar conteúdos no iOS. As interações de compartilhamento expõem informações ao iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включен, то когда вы делитесь контентом в iOS, вам будут предлагаться контакты %@. Это параметр дает системе iOS доступ к информации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je táto možnosť zapnutá, pri zdieľaní obsahu v systéme iOS budú navrhované kontakty z aplikácie %@. Interakcie zdieľania odhaľujú informácie systému iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıksa, iOS'ta içerik paylaşılırken %@ kişileri önerilecektir.  Etkileşimleri paylaşmak, bilgileri iOS'a gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо цю опцію буде ввімкнено, контакти %@ будуть пропонуватися, коли ви поширюватимете контент в iOS. Ця дія робить інформацію доступною для iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果打开分享互动，在iOS中分享内容时会建议 %@ 联系人列表。 分享互动可能会将信息暴露给iOS系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果開啟分享互動，在iOS中分享內容時會建議 %@ 聯絡人清單。分享互動可能會將資訊暴露至iOS系統。"
          }
        }
      }
    },
