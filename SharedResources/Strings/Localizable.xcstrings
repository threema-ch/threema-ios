    "could_not_add_all_items_memory_constrained_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поради технически причини, файлове над определен размер могат да бъдат изпратени в приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z technických důvodů mohou být soubory přesahující určitou velikost odeslány pouze přes aplikaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus technischen Gründen ist der Versand von Dateien ab einer bestimmten Grösse nur über die App möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For technical reasons, files over a certain size can only be sent in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por motivos de seguridad, solo pueden enviarse archivos que superen un tamaño determinado en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour des raisons techniques, les fichiers dépassant une certaine taille ne peuvent être envoyés que dans l'application."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Us technische Gründ isch de Versand vo Dateie abere bestimmte Grössi nur über d’App möglich."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di restrizioni tecniche i file oltre una data dimensione possono solo essere inviati all'interno dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術的な制約により、1つまたは複数のファイルを処理できませんでした。これらのファイルをアプリケーションから直接送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기술적인 이유로 일정 크기 이상의 파일은 앱에서만 전송할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omwille van technische redenen kunnen bestanden boven een bepaalde grootte alleen in de app worden verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z powodów technicznych pliki powyżej określonego rozmiaru mogą być wysyłane tylko z aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por motivos técnicos, arquivos acima de um determinado tamanho só podem ser enviados no aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По техническим причинам файлы, размер которых превышает определенный лимит, можно отправлять только в приложении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z technických dôvodov je možné súbory, ktoré presahujú určitú veľkosť, poslať iba v aplikácii."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknik nedenlerle, belirli bir boyutun üzerindeki dosyalar yalnızca uygulamadan gönderilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через технічні обмеження в застосунку можна відправляти лише ті файли, розмір яких більший за визначений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于技术限制，超过一定大小的文件只能在此应用程序内发送，而不是通过分享功能发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於技術限制，超過一定大小的檔案只能在此應用程式內傳送，而不是透過分享功能傳送。"
          }
        }
      }
    },
