    "create_note_group_info_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съвет: Ако не добавите други членове на групата, съобщенията в тази група ще се запазват локално в устройството Ви. Това е идеално за сигурното запазване на бележки, мултимедия или документи. Ще може да си ги изпратите към компютъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte skupinu, ve které budete pouze vy, kde můžete bezpečně ukládat poznámky, média a dokumenty a přesouvat tyto položky do desktopu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie eine Gruppe nur für sich selbst, um Notizen, Medien und Dokumente sicher zu speichern oder auf den Desktop zu übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a group with just yourself to securely store notes, media, and documents or to transfer items to the desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree un grupo solo con usted para almacenar notas, archivos multimedia y documentos de forma segura o para transferir elementos al escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un groupe avec seulement vous-même pour stocker des notes, médias et documents en toute sécurité ou pour transférer des éléments sur le bureau."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelled Sie e Gruppe nur für sich sälber, zum Notize, Medie und Dokumänt sicher z’speichere oder ufde Desktop z’übeträge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un gruppo solo con te per archiviare in modo sicuro note, contenuti multimediali e documenti o per trasferire elementi al desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしメンバーを追加しない場合、このグループへのメッセージはローカルに保存されます。メモ・メディア・ドキュメントを安全に保管したり、アイテムをパソコンに転送したりするのに最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹 멤버를 추가하지 않으면 이 그룹에 대한 메시지는 로컬에 머무릅니다. 이것은 노트, 미디어, 문서를 안전하게 저장하거나 데스크톱으로 항목을 전송하기에 이상적입니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u geen groepsleden toevoegt, blijven de berichten plaatselijk in deze groep opgeslagen. Dat is ideaal om notities, mediabestanden en documenten veilig op te slaan of om bestanden over te zetten naar de desktop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nie dodasz żadnych członków czy wiadomości do tej grupy, pozostanie ona lokalna. To idealne rozwiązanie, jeśli chcesz bezpiecznie przechowywać notatki, pliki multimedialne i dokumenty lub przenosić je na pulpit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não adicionar nenhum membro ao grupo, as mensagens para este grupo permanecerão locais. Isso é o ideal para armazenar em segurança notas, mídia e documentos ou transferir itens à área de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если не добавлять участников в группу, сообщения этой группе останутся локальными. Это отличный вариант для безопасного хранения заметок, мультимедийных файлов и документов или для передачи данных на ПК."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte skupinu, v ktorej budete len vy sami, a bezpečne v nej ukladajte poznámky, multimediálne súbory a dokumenty alebo prenášajte položky na pracovnú plochu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir grup üyesi eklemezseniz, bu gruba gönderilen mesajlar yerel olarak kalacaktır. Bu, notları, medyayı ve belgeleri güvenli bir şekilde depolamak veya öğeleri masaüstüne aktarmak için idealdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви не додасте жодного учасника групи, повідомлення до цієї групи залишаться на пристрої. Це ідеально підходить для безпечного зберігання нотаток, медіа та документів або для перенесення елементів на робочий стіл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不添加任何群组成员，发送到这个群组的信息将保留在本地。这样能方便您安全地存储笔记、媒体和文件，或将文件转移到桌面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不新增任何群組成員，傳送至這個群組的訊息將保留在本地。這樣能方便您安全地儲存筆記、媒體和檔案，或將檔案轉移至桌面。"
          }
        }
      }
    },
