    "chat_view_spam_reporting_banner_group_confirmation_text" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID této skupiny, počet jejích členů, ID a přezdívka tvůrce skupiny budou nahlášeny společnosti Threema spolu s vaším ID. Obsah zpráv nebo osobní informace sdíleny nebudou, a nikdo ze skupiny nebude nijak informován."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ID dieser Gruppe, die Anzahl Mitglieder sowie die ID und der Nickname des Gruppen-Admins werden zusammen mit Ihrer ID an Threema übermittelt. Es werden weder Nachrichteninhalte noch personenbezogene Daten weitergegeben, und niemand in dieser Gruppe wird benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group’s ID, the number of members, and the ID and nickname of the group creator will be reported to Threema along with your ID. No message content or personal information will be shared, and no one in the group will be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El identificador de este grupo, el número de miembros, así como el identificador y el apodo del creador del grupo, se comunicarán a Threema junto con su identificador. No se compartirá el contenido de los mensajes ni información personal, y no se notificará a ningún miembro del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ID de ce groupe, le nombre de membres, ainsi que l'ID et le pseudo du créateur du groupe seront signalés à Threema avec votre ID. Aucun contenu de message ou information personnelle ne sera partagé, et personne dans le groupe ne sera informé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’ID vo dere Gruppe, d’Azahl Mitglieder und d’ID und de Nickname vom Gruppe-Admin werded zäme mit Ihrere ID a Threema übermittled. Es werded kei Nachrichteinhält und kei personebezogeni Date wiitergeh, und niemer i dere Gruppe wird benachrichtigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ID di questo gruppo, il numero di membri, e l'ID e il nickname del creatore del gruppo saranno riportati a Threema insieme al tuo ID. Nessun contenuto dei messaggi o informazione personale verrà condiviso, e nessuno nel gruppo sarà notificato."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grubun kimliği, üye sayısı, grup kurucusunun kimliği ve takma ismi, sizin kimliğinizle birlikte Threema'ya bildirilecektir. Hiçbir mesaj içeriği veya kişisel bilgi paylaşılmayacak ve gruptaki hiç kimse bilgilendirilmeyecektir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该群组的 ID、成员人数，以及群组创建者的 ID 和昵称，将连同您的 ID 一并上报给 Threema。消息内容或个人信息都不会被分享，群组中的任何成员都不会收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該群組的ID、成員人數，以及群組建立者的ID和暱稱，將連同您的 ID 一併回報給 Threema。訊息內容或個人資料均不會被分享，群組內任何成員都不會收到通知。"
          }
        }
      }
    },
