    "md_wizard_terms_backup" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните могат да бъдат изгубени. Моля, създайте резервно копие преди да продължите. [Инструкции за създаването на резервно копие](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Může dojít ke ztrátě dat. Než budete pokračovat, vytvořte si zálohu.\n[Pokyny k zálohování](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenverlust kann auftreten. Bitte erstellen Sie ein Backup, bevor Sie fortfahren. \n [Backup-Anleitung](https://threema.com/docs/threema/ios_backup_manual_de.pdf)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data loss might occur. Please create a backup before you proceed.\n [Backup instructions](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que se pierdan datos. Cree una copia de seguridad antes de continuar.\n [Instrucciones de la copia de seguridad](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une perte de données peut se produire. Veuillez faire une sauvegarde avant de continuer.\n[Instructions de sauvegarde](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateverlust cha ufträtte. Bitte mached Sie es Backup, bevor Sie wiitermached.\n[Backup-Aleitig]\n(https://threema.com/docs/threema/ios_backup_manual_de.pdf)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe verificarsi una perdita di dati. Crea un backup prima di procedere.\n[Istruzioni per il backup](https://threema.com/docs/threema/ios_backup_manual_it.pdf)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの損失が発生する可能性があります。続行する前にバックアップを作成してください。\n［バックアップの手順］\n（https://threema.com/docs/threema/ios_backup_manual_en.pdf）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 손실이 발생할 수 있습니다. 진행하기 전에 백업을 만들어 주세요.\n[백업 지침](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kan gegevensverlies optreden. Zorg dat u een back-up maakt voordat u verdergaat.\n[Back-up instructies](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może nastąpić utrata danych. Zanim przejdziesz dalej, sporządź kopię zapasową. [Instrukcje tworzenia kopii zapasowej](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode haver perda de dados. Crie um backup antes de continuar.\n[Instruções de backup](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможна утеря данных. Перед тем как продолжить, создайте резервную копию.\n[Инструкции по резервному копированию](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môže dôjsť k strate údajov. Pred pokračovaním vytvorte zálohu.\n[Pokyny na zálohovanie](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veri kaybı meydana gelebilir. Devam etmeden önce lütfen bir yedek oluşturun. [Backup instructions] (https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані може бути втрачено. Створіть резервну копію, перш ніж продовжити.\n[Інструкції зі створення резервної копії] (https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用技术预览版可能会发生数据丢失的问题，请在加入测试之前创建备份。\n[创建备份步骤（只提供英文版）](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用技術預覽版可能會發生資料丟失的問題，請在加入測試之前建立備份。\n[建立備份步驟（只提供英文版）](https://threema.com/docs/threema/ios_backup_manual_en.pdf)"
          }
        }
      }
    },
