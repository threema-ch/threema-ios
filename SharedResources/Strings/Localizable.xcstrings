    "delete_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтрийте стари мултимедийни файлове, за да освободите място. Моля, забележете: Съобщенията не се изтриват автоматично, а само когато натиснете бутона за изтриване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li uvolnit místo na disku, odstraňte stará média a soubory. Upozornění: Zprávy se neodstraňují automaticky, ale pouze po klepnutí na příslušné tlačítko „Smazat“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen Sie alte Medien und Dateien, um Speicherplatz freizugeben. Bitte beachten Sie: Nachrichten werden nicht automatisch gelöscht, sondern nur beim Betätigen der jeweiligen Löschen-Schaltfläche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete old media and files to free up disk space. Please note: Messages are not deleted automatically but only when tapping the respective Delete button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimine archivos y medios antiguos para liberar espacio en disco. Aviso: los mensajes solo se eliminan automáticamente cuando se toca el correspondiente botón Eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez les médias et fichiers anciens pour libérer de l’espace disque. Veuillez noter que les messages ne sont pas automatiquement supprimés, mais seulement en touchant le bouton Supprimer respectif."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösched Sie alti Medie und Dateie, zum Speicherplatz freizgeh. Bitte beachted Sie: Nachrichte werded nöd automatisch glöscht, sondern nur bim Betätige vode entsprächende Lösche-Schaltflächi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina vecchi messaggi multimediali e file per liberare la memoria. Ricordati che i messaggi non vengono automaticamente eliminati, ma soltanto toccando il relativo tasto Elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い写真・動画やファイルを削除して、端末容量を空けることができます。注意: メッセージは自動的には削除されず、それぞれの削除ボタンをタップしたときにのみ削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 공간을 확보하려면 오래된 미디어 및 파일을 삭제하세요. 주의: 메시지는 자동으로 삭제되지 않고 해당 삭제 버튼을 눌러야만 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder oude media en bestanden om opslagruimte vrij te maken. Let op: berichten worden niet automatisch verwijderd; alleen wanneer je op de respectievelijke knop Verwijderen tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń stare multimedia i pliki, aby zwolnić miejsce na dysku. Uwaga: Wiadomości nie są usuwane automatycznie, ale tylko po dotknięciu odpowiedniego przycisku Usuń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua arquivos e mídia antigos para liberar espaço na memória. Note: as mensagens não são excluídas automaticamente, apenas quando tocar no respectivo botão Excluir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите старые мультимедийные и другие файлы, чтобы освободить место на диске. Обратите внимание: сообщения не удаляются автоматически, необходимо нажать соответствующую кнопку «Удалить»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete uvoľniť miesto na disku, odstáňte staré médiá a súbory. Upozornenie: Správy sa nemažú automaticky, ale len po kliknutí na príslušné tlačidlo \"Vymazať\"."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk alanını boşaltmak için eski medyayı ve dosyaları sil. Lütfen unutmayın: Mesajlar otomatik olarak silinmez, yalnızca ilgili sil düğmesine dokunulduğunda temizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаліть старі медіа та файли, щоб звільнити місце на диску. Зверніть увагу: повідомлення не видаляються автоматично, а лише після натискання відповідної кнопки Видалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除旧媒体和文件以释放磁盘空间。请注意：消息不会自动删除，只有在点击相应的 “删除” 按钮时才会删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除舊媒體和檔案以釋放磁碟空間。請注意：訊息不會自動刪除，只有在點擊相應的「刪除」按鈕時才會刪除。"
          }
        }
      }
    },
