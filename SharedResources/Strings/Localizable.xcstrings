        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас еще нет контактов. Синхронизация включена, но судя по всему, никто из контактов, имеющихся в вашей телефонной книге, не пользуется %@ (пригласите их!)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ nemáte žiadne kontakty. Synchronizácia je zapnutá, ale zdá sa, že žiadny z vašich kontaktov v adresári nie je na %@ (pozvite ich!)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz hiç kişiniz yok. Eşitleme açık, ancak adres defteri kişilerinizin hiçbiri %@'da değil gibi görünüyor (davet edin!)."
          }
        },
        "uk" : {
