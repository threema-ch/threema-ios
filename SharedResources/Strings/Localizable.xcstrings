          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzenie kopii zapasowych %@ Safe nie powiodło się przez %.0f kolejnych dni. Sprawdź ustawienia %@ Safe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
