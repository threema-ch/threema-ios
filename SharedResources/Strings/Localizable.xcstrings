    "privateChat_code_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маркирайте чатовете като поверителни, за да ги защитите с парола и да ги скриете от общия списък с чатовете. Трябва да се зададе парола."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte konverzace jako soukromé, abyste je ochránili přístupovým kódem a skryli je z přehledu konverzací. Je zapotřebí nastavit zámek přístupového kódu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Chat als privat zu markieren, muss die Code-Sperre eingerichtet sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark chats as private to protect them with a passcode and hide them from the chat overview. Passcode Lock must be set up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca los chats como privados para protegerlos con un código y ocultarlos del resumen de chats. Es necesario configurar el bloqueo con código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez les discussions comme privées pour les protéger avec un code et les masquer de l'aperçu des discussions. Vous devez configurer le verrouillage par code."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum en Chat als privat z’markiere, muess d’Code-Sperri iigrichted sii."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per segnare una chat come privata devi impostare il blocco codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークをプライベートとしてマークすると、パスコードで保護され、トーク概要から非表示になります。パスコードロックを設定する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅을 비공개로 표시하여 비밀번호로 보호하고 채팅 개요에서 숨깁니다. 비밀번호 잠금을 설정해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer chats als privé om ze met een beveiligingscode te beveiligen en ze in het chatoverzicht te verbergen. Je moet het wachtwoordslot instellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz czaty jako prywatne, aby chronić je kodem dostępu i ukrywaj je w podglądzie czatów. Należy skonfigurować blokadę kodem dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque bate-papos como privados para protegê-los com uma senha e ocultá-los da visão geral do bate-papo. O Bloqueio por Código precisa estar definido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помечайте чаты как личные, чтобы защитить их паролем и скрыть с экрана обзора чатов. Необходимо настроить блокировку паролем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte chaty ako súkromné, aby ste ich ochránili pomocou prístupového kódu a skryli ich v prehľade chatu. Musí byť nastavený zámok hesla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şifreyle korumak ve sohbete genel bakıştan gizlemek için sohbetleri özel olarak işaretleyin. Şifre kilidi ayarlanmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначте діалоги приватними для захисту за допомогою паролю та приховання з переліку бесід. Для цього має бути налаштовано Блокування паролем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想将会话标记为私密会话，并在会话主界面中隐藏，则必须设置密码锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想將對話標示為私密對話，並在對話主畫面中隱藏，則必須設定密碼鎖。"
          }
        }
      }
    },
