          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij tutaj, aby wypróbować następną generację aplikacji na komputer z obsługą wielu urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque aqui para experimentar a próxima geração do aplicativo para desktop com suporte a vários dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите сюда, чтобы попробовать приложение нового поколения для ПК с поддержкой нескольких устройств."
