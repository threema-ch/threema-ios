    "contact_list_limited_access_header_label" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ има само ограничен достъп до Вашите телефонни контакти. Някои от контактите Ви няма да са видими."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé kontakty mohou být skryté kvůli omezenému přístupu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Kontakte sind aufgrund eingeschränkten Zugriffs verborgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some contacts may be hidden due to limited access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que algunos contactos estén ocultos debido al acceso limitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est possible que certains contacts soient masqués en raison d'un accès limité."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es paar Kontäkt sind wege iigschränktem Zuegriff nöd sichtbar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni contatti potrebbero essere nascosti a causa di accesso limitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、お使いの電話の連絡先へのアクセス権が制限されています。一部の連絡先が表示されない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 휴대폰의 연락처에 제한적으로만 접근할 수 있습니다. 일부 연락처가 표시되지 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft slechts beperkte toegang tot de contactpersonen op je telefoon. Sommige contactpersonen worden mogelijk niet weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze względu na ograniczony dostęp niektóre kontakty mogą być ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem acesso limitado aos contatos do seu telefone. Alguns contatos podem não ser exibidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ ограниченный доступ к контактам вашего телефона. Некоторые контакты могут быть не видны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ má len obmedzený prístup ku kontaktom vo vašom telefóne. Niektoré kontakty môžu byť neviditeľné."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ telefonunuzun kişilerine yalnızca sınırlı erişime sahiptir. Bazı kişiler görünmeyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ має обмежений доступ до контактів у телефоні. Певні контакти можуть бути приховані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只能有限地访问您手机的联系人，某些联系人可能无法显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只能有限地存取您手機的聯絡人，某些聯絡人可能無法顯示。"
          }
        }
      }
    },
