    "settings_threema_web_connectioninfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашето устройство трябва да бъде отключено с %@ работещ на преден план, за да останете свързан. Докато сте свързан, устройството Ви няма да се заключва автоматично."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abyste mohli zůstat připojeni, musí být vaše zařízení odemčené a v popředí musí být spuštěna aplikace %@. Během připojení se zařízení automaticky nezamkne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Gerät muss entsperrt und %@ im Vordergrund sein, damit die Verbindung aufrechterhalten bleibt. Bei aktiver Verbindung wird das Gerät nicht automatisch gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device must be unlocked with %@ running in the foreground to stay connected. While connected, your device will not lock automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo tiene que desbloquearse con %@ ejecutándose en primer plano para permanecer conectado. Mientras estés conectado, tu dispositivo no se bloqueará automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil doit être déverrouillé avec %@ fonctionnant en premier plan pour rester connecté. En étant connecté, votre appareil ne sera pas automatiquement verrouillé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihres Grät muess entsperrt und %@ im Vordergrund sii, demit d’Verbindig ufrechterhalte blibt. Binere aktive Verbindig wird s’Grät nöd automatisch gsperrt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mantenere il collegamento, il tuo dispositivo deve essere sbloccato e %@ posto in primo piano. In caso di collegamento attivo, il dispositivo non viene bloccato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を維持するには、フォアグラウンドで%@を実行した状態で端末をロック解除する必要があります。接続中は、端末は自動的にロックされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치는 연결을 유지하기 위해 %@이(가) 화면 앞에서 실행 중이어야 합니다. 연결 중일 때, 장치는 자동으로 잠겨지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je apparaat moet zijn vrijgegeven en %@ moet in de voorgrond actief zijn om verbonden te blijven. Zo lang je verbonden bent, zal je apparaat niet automatisch worden vergrendeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenie musi być odblokowane, a %@ musi działać na pierwszym planie, aby zachować połączenie. Przy połączeniu urządzenie nie zablokuje się automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu dispositivo precisa ser desbloqueado com o %@ operando em primeiro plano para ficar conectado. Enquanto estiver conectado, seu dispositivo não será bloqueado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для поддержания соединения ваше устройство должно быть разблокировано с работающим не в фоновом режиме приложением %@. Во время соединения ваше устройство не будет блокироваться автоматически."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete zostať v spojení, vaše zariadenie musí byť odomknuté so spusteným %@ v popredí. Počas pripojenia sa vaše zariadenie automaticky neuzamkne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı kalmak için cihazınızın kilidinin %@ ön planda çalışırken açılmış olması gerekir. Bağlıyken cihazınız otomatik olarak kilitlenmeyecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб залишатися на зв’язку, ваш пристрій має бути розблоковано, а %@ має працювати у фоновому режимі. Під’єднаний пристрій не блокуватиметься автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了保持与桌面版/网页版的连接，您的设备必须解锁，并在前台运行 %@。连接后，您的设备将不会自动锁屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了保持與桌面版/網頁版的連結，您的裝置必須解鎖，並在前景執行 %@。連結後，您的裝置將不會自動鎖定。"
          }
        }
      }
    },
    "settings_threema_web_desktop_banner_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
