    "forward_message_tip_message" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригиналният надпис ще бъде препратен със съобщението. Вие може да го премахнете или да добавите текст чрез натискане на бутона за затваряне на полето с надпис."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpráva bude přeposlána i s původním popiskem. Tento popisek můžete odstranit nebo přidat další text klepnutím na tlačítko zavřít v poli s popiskem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ursprüngliche Bildunterschrift wird mit der Nachricht weitergeleitet. Sie können die Bildunterschrift löschen oder weiteren Text hinzufügen, indem Sie im Feld für die Bildunterschrift auf «Schliessen» tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original caption will be forwarded with the message. You can remove the caption or add additional text by tapping the close button in the caption field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El subtítulo original se reenviará con el mensaje. Puede eliminar el subtítulo o añadir texto adicional pulsando el botón Cerrar en el campo del subtítulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La légende originale sera transmise avec le message. Vous pouvez supprimer la légende ou ajouter du texte supplémentaire en appuyant sur le bouton Fermer dans le champ de la légende."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di ursprünglich Bildunterschrift wird mit de Nachricht wiitergleitet. Sie chönd die Bildunterschrift lösche oder andere Text dezuetue, indem Sie im Feld für d’Bildunterschrift uf «Schlüsse» tipped."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La didascalia originale verrà inoltrata insieme al messaggio. È possibile rimuovere la didascalia o aggiungere altro testo toccando il pulsante di chiusura nel campo della didascalia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のキャプションはメッセージと共に転送されます。キャプションを削除したり、閉じるボタンをタップして追加のテキストを追加することもできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z wiadomością zostanie przesłany oryginalny podpis. Możesz go usunąć lub dodać dodatkowy tekst, dotykając przycisku zamknięcia w polu podpisu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pôvodný popis bude poslaný spolu so správou. Môžete odstrániť popis alebo pridať ďalší text klepnutím na tlačidlo zavrieť v poli popisu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal altyazı mesajla birlikte iletilecektir. Altyazı alanındaki kapat düğmesine dokunarak altyazıyı kaldırabilir veya ek metin ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригінальний підпис буде переадресовано разом із повідомленням. Ви можете видалити підпис або додати додатковий текст, натиснувши кнопку закриття в полі підпису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始标题将随消息一起转发。您可以点击标题栏中的关闭按钮来删除标题或添加其他文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始描述將隨訊息一起轉寄。您可以點擊描述列中的關閉按鈕以刪除描述或新增其他文字。"
          }
        }
      }
    },
