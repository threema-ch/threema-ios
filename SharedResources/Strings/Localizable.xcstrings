    "invite_sms_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравейте! Нека използваме %@, за да си общуваме по сигурен и поверителен начин! Моят %@ идентификатор е: https://threema.id/%@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahoj! Začněme používat aplikaci %@, ať spolu můžeme komunikovat bezpečně a v soukromí! Moje %@ ID je: https://threema.id/%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Lass uns sicher und datenschutzkonform über %@ kommunizieren! Meine %@-ID: https://threema.id/%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Let’s use %@ to communicate in a safe and privacy-compliant way! My %@ ID: https://threema.id/%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! ¡Utilicemos %@ para comunicarnos de forma segura y privada! Mi ID en %@ es: https://threema.id/%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! Utilisons %@ pour communiquer d’une manière sécurisée et respectant la vie privée ! Mon ID %@ : https://threema.id/%@"
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Lah üs sicher und dateschutzkonform über %@ kommuniziere! Mini %@-ID: https://threema.id/%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Usiamo %@ per comunicare in maniera sicura e rispettosa della privacy. Il mio %@ ID è: https://threema.id/%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！%@を使って、プライバシーに配慮した安全なコミュニケーションをしていきましょう。私の%@ IDは https://threema.id/%@ です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 우리는 %@를 사용하여 안전하고 개인 정보를 준수하는 방식으로 통신합시다! 내 %@ ID: https://threema.id/%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Laten we %@ gebruiken om te communiceren in een beveiligde omgeving die de privacy beschermt! Mijn %@-ID is: https://threema.id/%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaj! Użyj %@ do komunikacji w sposób bezpieczny i zgodny z zasadami prywatności! Mój ID %@: https://threema.id/%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi! Vamos usar o %@ para conversar de forma segura e simples! Minha ID %@ é: https://threema.id/%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давайте использовать %@ для безопасной и конфиденциальной связи! Мой %@ ID: https://threema.id/%@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahoj! Začnime používať aplikáciu %@, nech môžme spolu komunikovať bezpečne a v súkromí! Moje %@ ID: https://threema.id/%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba! Güvenli ve gizliliğe uygun bir şekilde iletişim kurmak için %@'yı kullanalım! %@ kimliğim: https://threema.id/%@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт! Використовуймо %@ для безпечного та конфіденційного спілкування! Мій %@ ID: https://threema.id/%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
