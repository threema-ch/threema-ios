        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja kopii zapasowej jest nowsza niż wersja obsługiwana. Zaktualizuj tę aplikację do najnowszej wersji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
