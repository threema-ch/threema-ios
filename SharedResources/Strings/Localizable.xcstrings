    "settings_notification_type_preview_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете каква информация да бъде включена в push-известията на входящите %@ съобщения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, které informace mají být zahrnuty do nabízených oznámení k příchozím zprávám %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie fest, welche Informationen in Push-Benachrichtigungen für eingehende %@-Nachrichten enthalten sein sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which information should be included in push notifications for incoming %@ messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique qué información debe incluirse en las notificaciones automáticas para los mensajes entrantes de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quelles informations à inclure dans les notifications Push pour les messages %@ entrants."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legged Sie fest, weli Informatione in Push-Benachrichtigunge für iigehendi %@-Nachrichte sölled enthalte sii."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta le informazioni da includere nelle notifiche push per i messaggi %@ in arrivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のメッセージ受信時のプッシュ通知に含める情報を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 메시지 수신 시 푸시 알림에 포함되어야 할 정보를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke informatie er moet worden opgenomen in pushmeldingen voor inkomende %@-berichten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, które informacje powinny być uwzględnione w powiadomieniach push o nadchodzących wiadomościach %@."
          }
        },
        "pt-BR" : {
