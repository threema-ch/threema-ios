    "qr_code_scanner_wrong_identity_code_error_message" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този QR код Ви позволява да удостоверите контакт. За да го използвате, отидете в Профил и натиснете бутона горе вдясно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento QR kód vám umožňuje ověřit kontakt. Chcete-li jej použít, přejděte do sekce Profil a klepněte na tlačítko vpravo nahoře."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem QR-Code können Sie einen Kontakt verifizieren. Gehen Sie dafür zu «Profil» und tippen Sie auf den QR-Button oben rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code allows you to verify a contact. To use it, go to Profile, and tap the button in the top right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código QR le permite verificar un contacto. Para utilizarlo, vaya a Perfil y pulse el botón en la esquina superior derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code QR vous permet de vérifier un contact. Pour l'utiliser, rendez-vous dans Profil et appuyez sur le bouton en haut à droite."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem QR-Code chönd Sie en Kontakt verifiziere. Gönd Sie defür zu «Profil» und wähled Sie de Button rechts obe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice QR ti consente di verificare un contatto. Per usarlo, vai su Profilo e tocca il pulsante in alto a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このQRコードは連絡先を確認するためのものです。使用するには、プロフィールに移動して、右上のボタンをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 QR 코드는 연락처 인증에 사용됩니다. 사용하려면 프로필 > ID 스캔으로 이동하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze QR-code kunt u een contactpersoon verifiëren. Ga naar Profiel > Identiteit scannen om hem te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod QR umożliwia zweryfikowanie kontaktu. Aby skorzystać z tej opcji, przejdź do sekcji Profil > Skanuj identyfikator."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código QR permite que você verifique um contato. Para usá-lo, vá para Perfil > Ler ID."
          }
        },
        "sk" : {
          "stringUnit" : {
