    "flavorinfo_privateappviewmodel_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако искате да използвате Threema за лични нужди, то ние Ви препоръчваме да използвате частното Threema приложение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li používat aplikaci Threema pro soukromé účely, doporučujeme vám aplikaci Threema Private."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Threema privat nutzen möchten, empfehlen wir die Threema Private-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to use Threema for private purposes, we recommend the Threema Private app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desea utilizar Threema con fines privados, le recomendamos la aplicación Threema Private."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous souhaitez utiliser Threema à des fins privées, nous vous recommandons l’application Threema Private."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Threema privat bruuche wennd, empfehled mir d’Threema Private-App."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desideri utilizzare Threema per scopi privati, ti consigliamo l'app Threema Private."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threemaを個人で使用する場合は、Threema Private アプリをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 용도로 Threema를 사용하고자 한다면, Threema Private 앱을 권장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u Threema voor privédoeleinden wilt gebruiken, raden wij u de Threema Private-app aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz używać Threema do celów prywatnych, zalecamy korzystanie z aplikacji Threema Private."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja usar o Threema para fins privados? Recomendamos o aplicativo Threema Private."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete používať Threemu na súkromné účely, odporúčame aplikáciu Threema Private."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema'yı özel amaçlarınız için kullanmak istiyorsanız Threema Private uygulamasını öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви хочете використовувати Threema з метою особистого спілкування, ми радимо застосунок Threema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
