          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez réessayer. Peut-être en utilisant une autre image."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versueched Sie’s nomal. Vilicht miteme andere Bild."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova, possibilmente con un’altra immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。別の画像もお試しください。"
