    "database_migration_error_hints" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, уверете се, че имате достатъчно място за съхранение на устройството. Рестартирайте устройството и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, zda máte na zařízení k dispozici dostatek volného místa. Poté restartujte zařízení a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte stellen Sie sicher, dass Sie genügend freien Speicherplatz auf Ihrem Gerät haben. Starten Sie Ihr Gerät neu, und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please make sure you have enough storage space available on your device. Restart your device, and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que su dispositivo tenga suficiente espacio de almacenamiento disponible, reinícielo e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez vous assurer d’avoir assez d’espace de stockage libre sur votre appareil. Redémarrez votre appareil et réessayez."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte stelled Sie sicher, dass Sie gnueg freie Speicherplatz uf Ihrem Grät händ. Started Sie Ihres Grät neu und versueched Sie’s dänn nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati di disporre di memoria a sufficienza sul dispositivo, riavvialo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの端末に十分な空き容量があることを確認し、端末を再起動してから再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에 충분한 여유 저장 공간이 있는지 확인하고 기기를 다시 시작한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat er genoeg vrije opslagruimte op uw apparaat is. Herstart uw apparaat en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że masz wystarczającą ilość wolnego miejsca w urządzeniu. Zrestartuj urządzenie, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, verifique se você tem espaço de armazenamento suficiente disponível em seu aparelho. Reinicie o aparelho e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что у вас достаточно свободной памяти на устройстве. Перезагрузите устройство и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uistite sa, že máte v zariadení k dispozícii dostatok voľného miesta. Reštartujte zariadenie a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen cihazınızda yeterli depolama alanı olduğundan emin olun. Cihazınızı yeniden başlatın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що на вашому пристрої достатньо місця. Перезавантажте пристрій і повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确保设备上有足够的可用存储空间，重启设备后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確保裝置上有足夠的可用儲存空間，重新啟動裝置後再試一次。"
          }
        }
      }
    },
    "database_migration_storage_warning_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновлението на базата данни временно изисква поне %.1f ГБ свободно пространство. Вашето устройство има само %.1f ГБ свободно място в момента. Моля, освободете повече повече място за съхранение, като изтриете елементи от Настройките на ползване и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace databáze dočasně vyžaduje alespoň %.1f GB volného místa na úložišti. Na vašem zařízení je k dispozici jen %.1f GB. Uvolněte prosím místo odstraněním položek v nabídce Nastavení využití a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenbank-Aktualisierung benötigt vorübergehend mindestens %.1f GB freien Speicherplatz. Ihr Gerät hat derzeit nur %.1f GB freien Speicherplatz. Stellen Sie Speicherplatz frei, indem Sie in den Benutzungseinstellungen Objekte löschen, und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database update temporarily requires at least %.1f GB of available storage. Your device currently has only %.1f GB available. Please make more storage available by deleting items in Usage Settings, and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización de la base de datos necesita de forma temporal %.1f GB de espacio disponible. Su dispositivo sólo tiene disponibles %.1f GB en este momento. Por favor, libere espacio de almacenamiento borrando elementos en Ajustes de uso e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données nécessite actuellement au moins %.1f Go de stockage disponible. Votre appareil ne comporte actuellement que %.1f Go disponibles. Veuillez libérer de l’espace en supprimant des éléments dans les Réglages d’Utilisation, puis réessayez."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Datebank-Aktualisierig benötigt vorübergehend mindestens %.1f GB freie Speicherplatz. Ihres Grät hät im Moment aber nume %.1f GB freie Speicherplatz. Stelled Sie Speicherplatz frei, indem Sie ide Benutzigsiistellige Objekt lösched, und versueched Sie’s dänn nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’update del database richiede temporaneamente almeno %.1f GB di memoria disponibile. Al momento il tuo dispositivo può contare soltanto su %.1f GB. Rendi disponibile un po’ più di spazio eliminando file nelle Impostazioni d’uso, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースの更新には，少なくとも %.1f GB の利用可能なストレージが一時的に必要です。お使いのデバイスには、現在 %.1f GB の空き容量しかありません。使用状況の設定でアイテムを削除するなどしてストレージの空き容量を増やしてから、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 업데이트는 임시로 최소 %.1f GB의 여유 저장 공간이 필요합니다. 현재 기기에는 %.1f GB만 사용 가능합니다. 사용량 설정 에서 항목을 삭제하여 더 많은 저장 공간을 확보하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bijwerken van de database kost tijdelijk ten minste %.1f GB aan beschikbare opslagruimte. Je apparaat heeft momenteel slechts %.1f GB beschikbaar. Maak meer opslagruimte vrij door zaken te verwijderen via Gebruiksinstellingen en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja bazy danych wymaga tymczasowo co najmniej %.1f GB dostępnej pamięci. Obecnie urządzenie ma tylko dostępne %.1f GB. Proszę udostępnić więcej pamięci poprzez usunięcie elementów w Ustawieniach użytkowania, a następnie spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização do banco de dados temporariamente necessita de %.1f GB de memória disponível. Seu aparelho atualmente tem somente %.1f GB disponíveis. Libere mais espaço excluindo itens nas Configurações de Uso e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обновления базы данных требуется не менее %.1f ГБ места в памяти. В вашем устройстве свободно только %.1f ГБ. Освободите место, удалив некоторые элементы в \"Настройках пользования\", и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualiácia databázy dočasne vyžaduje aspoň %.1f GB voľného miesta. Vaše zariadenie má iba %.1f GB voľného miesta. Zabezpečte prosím dostatok voľného miesta v \"Nastavenia > Všeobecné > Úložisko\" a skúste to znovu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veritabanı güncellemesi geçici olarak en az %.1f GB kullanılabilir depolama alanı gerektirir. Cihazınızda şu anda yalnızca %.1f GB kullanılabilir. Lütfen Kullanım Ayarları’ndaki öğeleri silerek daha fazla depolama alanı sağlayın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для оновлення бази даних тимчасово потрібно принаймні %.1f ГБ вільного місця. Зараз на вашому пристрої доступно лише %.1f ГБ. Звільніть більше місця, видаливши елементи в налаштуваннях використаного місця, та повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库更新暂时需要至少 %.1f GB 的可用存储空间。您的设备目前只有 %.1f GB 的可用存储空间。请在 “储存空间” 中删除项目以获得更多可用的存储空间，然后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫更新暫時需要至少 %.1f GB 的可用儲存空間。您的裝置目前只有 %.1f GB 的可用儲存空間。請在「儲存空間」中刪除專案以取得更多可用的儲存空間，然後再試一次。"
          }
        }
      }
    },
