    "chat_export_ready_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортирайте всички Ваши чатове като JSON в ZIP  файл. В зависимост от броя на съобщенията и медийните файлове, това може да отнеме известно време."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte všechny své konverzace ve formátu JSON do souboru ZIP.\n\nV závislosti na množství zpráv a médií ve vašich konverzacích to může chvíli trvat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie alle Ihre Chats als JSON in eine ZIP-Datei. Je nach Anzahl Nachrichten und Medien kann dies eine Weile dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export all your chats as JSON to a ZIP file.\n\nDepending on the amount of messages and media in your chats this may take a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte todos sus chats como JSON a un archivo ZIP.\n\nDependiendo de la cantidad de mensajes y archivos multimedia en sus chats, esto puede tardar algún tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez toutes vos discussions au format JSON dans un fichier ZIP.\n\nSelon le nombre de messages et de médias dans vos discussions, cela peut prendre un certain temps."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiered Sie all Ihri Chats als JSON ine ZIP-Datei. Je nach Azahl Nachrichte und Medie cha das es Wiili duure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta tutte le tue chat in formato JSON in un file ZIP.\n\nA seconda della quantità di messaggi e file multimediali presenti nelle chat, l'operazione potrebbe richiedere del tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのトークをJSON形式でZIPファイルにエクスポートします。\n\nトークのメッセージやメディアの量によっては、時間がかかることがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj wszystkie swoje czaty w formacie JSON zapisanym w pliku ZIP.\n\nCzas realizacji tego zadania zależy od liczby wiadomości i multimediów w czatach."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte všetky svoje konverzácie ako JSON do ZIP súboru.\n\nV závislosti od množstva správ a médií vo vašich konverzáciách to môže chvíľu trvať."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm sohbetlerinizi JSON formatında bir ZIP dosyasına dışa aktarın.\n\nSohbetlerinizdeki mesaj ve medya miktarına bağlı olarak bu işlem biraz zaman alabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортуйте всі ваші листування у форматі JSON у файл ZIP.\n\nЗалежно від кількості повідомлень та медіа у ваших чатах, це може зайняти деякий час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有聊天记录以 JSON 格式导出到 ZIP 文件。\n\n导出文件时间根据聊天记录中的消息和媒体文件的数量而定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有對話記錄以 JSON 格式匯出至 ZIP 檔案。\n\n匯出檔案時間根據對話記錄中的訊息與媒體檔案數量而定。"
          }
        }
      }
    },
