    "group_member_creator_left" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Тази група е без собственик*\nСъздателят напусна групата и тя вече не може да бъде поддържана. Един от останалите членове може да я клонира (от детайлите на групата), за да стане новият администратор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Tato skupina je osiřelá*\nTvůrce skupiny ji opustil a již ji nelze spravovat. Jeden ze zbývajících členů by měl skupinu naklonovat (prostřednictvím podrobností o skupině) a stát se novým správcem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Diese Gruppe ist verwaist*\nDer Gruppen-Ersteller hat die Gruppe verlassen, und sie ist nun nicht mehr administrierbar. Ein verbleibendes Gruppenmitglied soll die Gruppe (via Gruppendetails) klonen, um neuer Administrator zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*This group is orphaned*\nThe group creator has left the group, and it can no longer be maintained. One of the remaining members should clone the group (via group details) to become the new admin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Este grupo está huérfano*\nEl creador del grupo ha abandonado el grupo y no se puede mantener. Uno de los miembros restantes debe clonar el grupo (a través de los detalles del grupo) para convertirse en el nuevo administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ce groupe est orphelin*\nLe créateur de ce groupe a quitté celui-ci, le groupe ne pourra donc plus être maintenu. L'un des membres restants devrait cloner le groupe (à partir des détails du groupe) pour en devenir le nouvel administrateur."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Die Gruppe isch verwaist*\nDe Gruppe-Ersteller hät d’Gruppe verlaa, und sie isch ez nüme administrierbar. Es verbliibends Gruppemitglied söll d’Gruppe (via Gruppedetails) chlone, zum de neu Administrator z’werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Il gruppo è senza amministratore*\nIl creatore del gruppo ha lasciato il gruppo, il quale ora non è più amministrabile. Si prega un membro del gruppo di clonare il gruppo (mediante dettagli gruppo) per diventare il nuovo amministratore.\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*このグループは孤立しています*。\nグループ作成者がグループから退会し、グループの維持ができなくなりました。残ったメンバーの誰かが、グループを複製し（グループの詳細から）、新しい管理者になる必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*이 그룹은 고아입니다*\n그룹 생성자가 그룹을 나갔으며 더 이상 유지되지 않습니다. 남은 회원 중 한 명이 그룹을 복제하여(그룹 상세정보를 통해) 새로운 관리자가 되어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Deze groep heeft geen eigenaar*\nDe groep kan niet meer worden beheerd omdat degene die de groep heeft aangemaakt de groep heeft verlaten. Een van de resterende leden kan de groep klonen om de rol van beheerder over te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ta grupa jest porzucona*\nTwórca grupy opuścił ją i nie można nią zarządzać. Jeden z pozostałych członków powinien sklonować grupę (ze szczegółów grupy), aby zostać nowym administratorem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Este grupo está órfão*\nO criador do grupo saiu do grupo, e ele não pode mais ser mantido. Um dos membros restantes deve clonar o grupo (através dos detalhes do grupo) para se tornar o novo administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Эта группа потеряна*\nСоздатель группы вышел из нее, и ее поддержка теперь невозможна. Один из оставшихся пользователей должен клонировать группу (из сведений о группе) и стать новым администратором."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Táto skupina je osirelá*\nTvorca skupiny opustil skupinu a už ju nemožno udržiavať. Jeden zo zostávajúcich členov by mal naklonovať skupinu (prostredníctvom podrobností o skupine), aby sa stal novým správcom."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Bu grup yöneticisiz kaldı*\nGrubu kuran kişi gruptan ayrıldı ve artık grup sürdürülemez. Kalan üyelerden biri, yeni yönetici olmak için grubu kopyalamalıdır (grup ayrıntıları üzerinden)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ця група осиротіла*\nОрганізатор групи покинув її, тому її більше не можна підтримувати. Один із учасників, які залишилися, має клонувати групу (через меню групи), щоб стати новим адміністратором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*此群组成为孤立群组*\n由于群组创建者已离开群组，管理员职位现在为空缺。其余成员应该克隆该群组（点击群组详细信息）以成为新的管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*此群組變成為孤立群組*\n由於群組建立者已離開群組，管理員職位現在為空缺。其餘成員應該克隆該群組（按一下群組詳細資料）以成為新的管理員。"
          }
        }
      }
    },
