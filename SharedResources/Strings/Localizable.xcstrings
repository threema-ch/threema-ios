    "contact_list_group_unavailable_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не сте член на нито една група. Помолете някой да Ви добави или създайте нова група."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozatím nejste členem skupiny. Požádejte někoho, aby vás přidal do skupiny, nebo vytvořte novou skupinu vy sami."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind noch nicht Mitglied einer Gruppe. Lassen Sie sich zu einer hinzufügen oder erstellen Sie selbst eine neue Gruppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are not yet a member of a group. Ask someone to add you or create a new group yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usted todavía no es miembro de ningún grupo. Pida a alguien que le añada o cree usted mismo un nuevo grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne faites pas encore partie d’un groupe. Demander à être ajouté(e) ou en créer un vous-même."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind no vo keinere Gruppe es Mitglied. Lönd Sie sich zu einere dezuetue, oder erstelled Sie sälber e neui Gruppe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non sei in nessun gruppo. Chiedi a qualcuno di aggiungerti oppure crea tu un gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはまだグループのメンバーではありません。誰かに追加を依頼するか、自分で新しいグループを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 그룹에 가입되어 있지 않습니다. 다른 사람에게 추가를 요청하거나 직접 새 그룹을 생성하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent nog geen lid van een groep. Vraag iemand om je toe te voegen of maak zelf een nieuwe groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie nie jesteś członkiem grupy. Poproś kogoś o dodanie Cię do grupy lub samodzielnie utwórz nową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não é membro de um grupo. Peça a alguém para adicionar você ou crie um novo grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не участник группы. Попросите кого-нибудь добавить вас или создайте новую группу сами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ešte nie ste členom žiadnej skupiny. Poproste niekoho, aby vás pridal, alebo si vytvorte novú skupinu sami."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz bir grubun üyesi değilsiniz. Birinden sizi eklemesini isteyin veya kendiniz yeni bir grup oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
