          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe urządzenie będzie przechowywać niezależną kopię Twojego profilu %@, a wiadomości będą wysyłane i otrzymywane w Twoim imieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo dispositivo armazenará uma cópia independente do seu perfil do %@, e as mensagens serão enviadas e recebidas em seu nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На новом устройстве будет храниться независимая копия вашего профиля %@, и сообщения будут отправляться и приходить от вашего имени."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové zariadenie uloží nezávislú kópiu vášho profilu %@ a správy sa budú odosielať a prijímať vo vašom mene."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni cihaz %@ profilinizin bağımsız bir kopyasını saklayacak ve sizin adınıza mesajlar gönderip alacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий пристрій зберігатиме незалежну копію вашого профілю %@, і повідомлення надсилатимуться та отримуватимуться від вашого імені."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新设备将存储您的 %@ 个人资料的独立副本，该设备将可以发送和接收消息。"
