    "call_me_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако продължите, ще се опитаме да Ви се обадим веднага. Вашият код за потвърждение ще Ви бъде прочетен два пъти. Имайте предвид, че ще направим само един опит, така че се подсигурете, че сте готови преди да продължите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budete-li pokračovat, pokusíme se vám neprodleně zavolat. Ověřovací kód vám dvakrát přečteme. Mějte na paměti, že tato akce proběhne jen jednou, takže než budete pokračovat, ujistěte se, že jste náležitě připraveni."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie fortfahren, werden wir unverzüglich versuchen, Sie anzurufen. Ihr Überprüfungscode wird Ihnen dann zweimal vorgelesen. Achtung: es gibt nur einen Versuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you proceed, we will attempt to call you immediately. Your verification code will be read to you twice. Note that we will only make one attempt, so please be sure that you are ready before you continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si continúa, intentaremos llamarle inmediatamente. A continuación, se leerá su código de validación dos veces en voz alta. Atención: solo dispondrá de un intento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous poursuivez, nous essaierons de vous appeler immédiatement. Votre code de vérification vous sera lu deux fois. Notez que nous ne ferons qu’une seule tentative, vérifiez donc que vous êtes prêt avant de poursuivre."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie wiitermached, werded mir grad versueche, Sie azlüte. Ihre Überprüefigscode wird Ihne dänn zweimal vorgläse. Achtung: Es git nur ein Versuech."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prosegui con l’operazione, ti contatteremo immediatamente. Dopodiché il tuo codice di verifica verrà ripetuto due volte. Attenzione: hai solo un tentativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けると、すぐに電話がかかってきます。その後、あなたの認証コードが2回読み上げられます。注意: 試行回数は1回のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 진행하면 즉시 전화를 연결합니다. 인증 코드를 두 번 불러드립니다. 시도 횟수는 한 번이므로 준비가 된 후 진행하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je doorgaat, zullen we je onmiddellijk proberen te bellen. Je verificatiecode wordt twee keer voor je opgelezen. Let op: we maken deze oproep maar één keer, dus zorg ervoor dat je gereed bent om hem te ontvangen voordat je doorgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli będziesz kontynuować, postaramy się natychmiast zadzwonić do Ciebie. Twój kod weryfikacyjny zostanie  przeczytany dwukrotnie. Pamiętaj, że podejmiemy tylko jedną próbę, więc upewnij się, że jesteś gotowy, zanim przejdziesz dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se continuar, tentaremos ligar para você imediatamente. Seu código de confirmação será lido para você duas vezes. Note que só vamos fazer uma tentativa, por isso certifique-se de que está pronto antes de continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы продолжите, мы попытаемся сразу же позвонить вам. Ваш проверочный код будет продиктован вам дважды. Обращаем ваше внимание, что мы делаем только одну попытку. Прежде чем продолжить, удостоверьтесь, что вы готовы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak budete pokračovať, pokúsíme sa Vám okamžite zavolať. Váš overovací kód vám bude nadiktovaný dvakrát. Budete mať len jeden pokus, preto sa prosím uistite, že ste pripravený."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederseniz, sizi hemen aramayı deneyeceğiz. Doğrulama kodunuz size iki kez okunacaktır. Sadece bir deneme yapacağımızı unutmayın, bu yüzden devam etmeden önce lütfen hazır olduğunuzdan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви продовжите, ми спробуємо негайно зателефонувати вам. Код підтвердження буде прочитано вголос двічі. Зауважте, що ми зробимо лише одну спробу, тому, будь ласка, переконайтеся, що ви готові, перш ніж продовжити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您选择继续，我们将尝试立即致电给您。您的验证码将被朗读两次。请注意，您只有一次致电的机会，因此在继续之前，请确定您已准备就绪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您選擇繼續，我們將嘗試立即致電給您。您的驗證碼將被朗讀兩次。請注意，您只有一次致電的機會，因此在繼續之前，請確定您已準備就緒。"
          }
        }
      }
    },
