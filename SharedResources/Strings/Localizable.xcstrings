    "onboarding_ID_creation_error_message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte prosím své připojení k internetu a zkuste to znovu. Pokud problém přetrvává, kontaktujte prosím náš tým podpory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut. Sollte das Problem weiterhin bestehen, wenden Sie sich bitte an unseren Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Please check your Internet connection and try again. If the problem persists, please contact our support team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compruebe su conexión a Internet e inténtelo de nuevo. Si el problema persiste, póngase en contacto con nuestro equipo de asistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion internet, puis réessayez. Si le problème persiste, contactez notre équipe d’assistance."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte prüefed Sie Ihri Internetverbindig und versueched Sie’s nomal. Wenn s’Problem wiiterhin bestaht, wändet Sie sich bitte a üsere Support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la connessione a Internet e riprova. Se il problema persiste, contatta il nostro team di assistenza."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen İnternet bağlantınızı kontrol edin ve tekrar deneyin. Sorun devam ederse, lütfen destek ekibimizle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, перевірте зʼєднання з Інтернетом і спробуйте ще раз. Якщо проблема залишається, будь ласка, звʼяжіться з нашою службою підтримки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查您的网络连接并重试。如果问题仍然存在，请联系我们的客服。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查您的網路連線並再試一次。如果問題仍然存在，請聯絡我們的支援團隊。"
          }
        }
      }
    },
