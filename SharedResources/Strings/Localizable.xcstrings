    "chat_view_spam_reporting_banner_confirmation_text" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID a přezdívka tohoto uživatele budou nahlášeny společnosti Threema společně s vaším ID. Obsah zpráv nebo osobní informace sdíleny nebudou, a tento uživatel nebude nijak informován."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ID und der Nickname dieses Nutzers werden zusammen mit Ihrer ID an Threema übermittelt. Es werden weder Nachrichteninhalte noch personenbezogene Daten weitergegeben, und dieser Nutzer wird nicht benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This user’s ID and nickname will be reported to Threema along with your ID. No message content or personal information will be shared, and this user will not be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID y el apodo de este usuario se notificarán a Threema junto con su ID. No se compartirá ningún contenido de los mensajes ni información personal, y no se notificará a este usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ID et le pseudo de cet utilisateur seront signalés à Threema avec votre ID. Aucun contenu de message ou information personnelle ne sera partagé, et cet utilisateur n'en sera pas informé."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’ID und de Nickname vo dem Nutzer werded zäme mit Ihrere ID a Threema übermittled. Es werded weder Nachrichteinhält no personebezogeni Date wiitergeh, und de Nutzer wird nöd benachrichtigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ID e il nickname di questo utente verranno segnalati a Threema insieme al tuo ID. Nessun contenuto dei messaggi o informazione personale verrà condiviso e questo utente non verrà notificato."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kullanıcının kimliği ve takma adı, sizin kimliğinizle birlikte Threema'ya bildirilecektir. Hiçbir mesaj içeriği veya kişisel bilgi paylaşılmayacak ve bu kullanıcı bilgilendirilmeyecektir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此用户的ID和昵称，将与您的ID一起上报给Threema。这不会分享任何消息内容或个人信息，且该用户不会收到任何通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此使用者的ID和暱稱，將連同您的 ID 一併通報給 Threema。這不會分享任何訊息內容或個人資料，且此使用者也不會收到通知。"
          }
        }
      }
    },
