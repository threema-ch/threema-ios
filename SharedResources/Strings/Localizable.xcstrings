    "root_coordinator_protected_data_unavailable_message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chráněná data nejsou dostupná. Odemkněte prosím své zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geschützten Daten sind gegenwärtig nicht verfügbar. Bitte entsperren Sie Ihr Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Protected data is not available. Please unlock your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos protegidos no están disponibles. Por favor, desbloquee su dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données protégées ne sont pas disponibles. Veuillez déverrouiller votre appareil."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di gschützte Date sind grad nöd verfüegbar. Bitte entsperred Sie Ihres Grät."
          }
        },
        "it" : {
          "stringUnit" : {
