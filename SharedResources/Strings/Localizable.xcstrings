    "settings_advanced_contacts_cleanup_unused_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i дублиращи се контакти бяха премахнати.\n\nМоля, излезте от приложението, рестартирайте го и свържете някое устройство. Ако не проработи: "
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proběhlo odstranění %i duplicitních kontaktů.\n\nUkončete aplikaci, restartujte ji a propojte zařízení. Nebude-li to fungovat: "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i duplizierte Kontakte wurden entfernt.\n\nBitte verlassen sie die App, starten Sie die App neu, und versuchen Sie, ein Gerät zu verknüpfen. Falls dies nicht funktioniert: "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i duplicate contacts were removed.\n\nPlease exit the app, restart it, and link a device. If it does not work: "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han eliminado %i contactos duplicados.\n\nSalga de la app, reiníciela y vincule un dispositivo. Si no funciona: "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i contacts en double ont été retirés.\n\nVeuillez quitter l'application, la redémarrer et associer un appareil. Si cela ne fonctionne pas : "
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i duplizierti Kontäkt sind entfernt worde.\n\nBitte verlönd Sie d’App, started Sie d’App neu, und versueched Sie, es Grät z’verchnüpfe. Falls das nöd funktioniert:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i contatti completati sono stati rimossi.\n\nChiudi l'app, riavviala e collega un dispositivo. Se non funziona: "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複する連絡先%i件を削除しました。\n\nアプリを終了、再起動し、端末を紐付けしてください。うまくいかない場合： "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i개의 중복 연락처가 제거되었습니다.\n\n앱을 종료한 후 다시 시작하고, 장치를 연결해주세요. 만약 작동하지 않는다면: "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn %i dubbele contacten verwijderd.\n\nSluit de app, herstart deze en koppel vervolgens een apparaat. Indien dit niet werkt: "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto %i zduplikowanych kontaktów.\n\nWyjdź z aplikacji, uruchom ją ponownie i połącz urządzenie. Jeśli to nie działa: "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i contatos duplicados foram removidos.\n\nPor favor, saia do app, abra-o novamente e vincule um dispositivo. Se isso não funcionar: "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i дублирующихся контакта(ов) удалены.\n\nВыйдите из приложения, перезапустите его и привяжите устройство. Если это не поможет: "
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i duplicitné kontakty boli odstránené.\n\n\nUkončite prosím aplikáciu, reštartujte ju a prepojte zariadenie. Ak to nefunguje: "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%i yinelenen kişi kaldırıldı.\n\nLütfen uygulamadan çıkın, yeniden başlatın ve bir cihaz bağlayın. Eğer çalışmazsa:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалено дублікати контактів: %i.\n\nВийдіть із програми, перезапустіть її та прив'яжіть пристрій. Якщо це не спрацює, виконайте такі дії: "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除 %i 个重复的联系人。\n\n请先退出此应用程序，再重启，然后链接设备。如果还不行： "
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除 %i 個重複的聯絡人。\n\n請先退出此應用程式，再重新啟動，然後連結裝置。 如果還不行： "
          }
        }
      }
    },
    "settings_advanced_contacts_multi_device_enabled_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройствата са понастоящем свързани. Моля, премахнете всички свързани устройства преди да го почистите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení jsou momentálně propojená. Před promazáním odeberte všechna propojená zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind aktuell Geräte verknüpft. Bitte entfernen Sie alle verknüpfte Geräte, bevor sie die Kontaktbereinigung starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devices are currently linked. Please remove all linked devices before cleaning up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos están vinculados actualmente. Elimine todos los dispositivos vinculados antes de comenzar la limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils sont actuellement liés. Veuillez retirer tous les appareils liés avant de nettoyer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind aktuell Grät verchnüpft. Bitte entferned Sie all verchnüpfte Grät, bevor Sie d’Kontaktbereinigung started."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sono dispositivi collegati. Rimuovi tutti i dispositivi collegati prima di avviare la pulizia dei contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスは現在リンクされています。整理する前にリンクされたデバイスをすべて削除してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 장치가 연결되어 있습니다. 정리하기 전에 모든 연결된 장치를 제거해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten zijn momenteel gekoppeld. Verwijder alle gekoppelde apparaten voordat je opschoont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istnieją powiązane urządzenia. Usun wszystkie powiązane urządzenia przed czyszczeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda há dispositivos vinculados. Por favor, remova todos os dispositivos vinculados antes de efetuar a limpeza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства в настоящее время связаны. Удалите все связанные устройства перед тем, как выполнять очистку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zariadenia sú v súčasnosti prepojené. Pred čistením odstráňte všetky prepojené zariadenia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazlar şu anda bağlı. Lütfen temizlemeden önce tüm bağlı cihazları kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз пристрої прив’язано. Будь ласка, видалить усі прив’язані пристрої перед видаленням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备当前已链接。清理会话前请移除所有已链接的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置目前已連結。清理對話前請移除所有已連結的設備。"
          }
        }
      }
    },
