    "multi_device_join_new_device_not_found_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това може да се случи, когато QR кодът вече е бил сканиран. Моля, рестартирайте приложението на новото устройство и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto může nastat, pokud už byl QR kód naskenován. Restartujte aplikaci na novém zařízení a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann passieren, wenn der QR-Code bereits gescannt wurde. Bitte starten Sie die App auf dem neuen Gerät neu, und versuchen Sie es nochmals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This may happen when the QR code was already scanned. Please restart the app on the new device and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto podría ocurrir si ya se ha escaneado el código QR. Reinicie la app en el nuevo dispositivo e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut se produire si le code QR a déjà été scanné. Veuillez redémarrer l'application sur le nouvel appareil et réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das cha passiere, wenn de QR-Code scho gscannt worde isch. Bitted started Sie d’App ufem neue Grät neu, und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe succedere quando il codice QR è già stato scansionato. Riavvia l'app sul nuovo dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはQRコードがすでにスキャンされている場合に発生します。新しい端末でアプリを再起動し、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드가 이미 스캔된 경우 발생할 수 있습니다. 새로운 디바이스에서 앱을 다시 시작하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan gebeuren wanneer de QR-code eerder al is gescand. Herstart de app op het nieuwe apparaat en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może się tak zdarzyć, gdy kod QR został już zeskanowany. Uruchom ponownie aplikację na nowym urządzeniu i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode acontecer quando o código QR já foi lido. Reinicie o app no novo dispositivo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это может случиться, если QR-код уже сканирован. Перезапустите приложение на новом устройстве и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto sa môže stať, keď už bol QR kód naskenovaný. Reštartujte prosím na novom zariadení aplikáciu a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu durum QR kodu zaten taranmışsa meydana gelebilir. Lütfen uygulamayı yeni cihazda yeniden başlatın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це може трапитися, якщо QR-код уже проскановано. Перезапустіть застосунок на новому пристрої та повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您扫描了之前的二维码，则可能会发生错误。请在新设备上重启应用程序，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您掃描了之前的QR碼，則可能會發生錯誤。請在新裝置上重新啟動應用程式，然後再試一次。"
          }
        }
      }
    },
