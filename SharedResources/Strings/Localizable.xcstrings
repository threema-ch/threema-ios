    "notification_no_access_microphone_body" : {
      "comment" : "Text displayed in a notification when the app does not have microphone access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропуснахте обаждане, защото %@ няма достъп до микрофона Ви. Натиснете тук и позволете достъпа, за да получавате обаждания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeškali jste hovor, protože aplikace %@ nemá přístup k mikrofonu. Klepnutím zde udělíte nezbytná oprávnění pro přijímání hovorů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben einen Anruf verpasst, da %@ keine Zugriffsberechtigung auf Ihr Mikrofon hat. Tippen Sie hier und erteilen Sie die erforderlichen Berechtigungen, um Anrufe zu empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You missed a call because %@ does not have access to your microphone. Tap here and grant the necessary permissions to receive calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha perdido una llamada porque %@ no tiene acceso a su micrófono. Pulse aquí y otorgue los permisos necesarios para recibir llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez manqué un appel car %@ n’a pas accès à votre microphone. Appuyez ici et accordez les autorisations nécessaires pour recevoir des appels."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie händ en Aruef verpasst, wil %@ kei Zuegriffsberächtigung uf Ihres Mikrofon hät. Tipped Sie da druf und erteiled Sie di nötige Berächtigunge, zum Arüef z’empfange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai perso una chiamata perché %@ non ha accesso al tuo microfono. Tocca qui e concedi le autorizzazioni necessarie per ricevere le chiamate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への電話するために、マイクへのアクセス権限が必要です。ここをタップして、アクセス許可をし、通話可能にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 마이크 접근 권한이 없어 전화를 받지 못했습니다. 여기를 탭한 후 필요한 권한을 허용하여 전화를 받을 수 있게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U hebt een oproep gemist omdat %@ geen toegang heeft tot uw microfoon. Tik hier en geef de benodigde machtigingen om oproepen te kunnen ontvangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie odebrano połączenia, ponieważ %@ nie ma dostępu do Twojego mikrofonu. Dotknij tutaj i przyznaj niezbędne uprawnienia, żeby odbierać połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você perdeu uma chamada porque %@ não tem acesso ao seu microfone. Toque aqui e conceda as permissões necessárias para receber chamadas."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeškali ste hovor, pretože %@ nemá prístup k vášmu mikrofónu. Klepnite sem a udeľte potrebné povolenia na prijímanie hovorov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'ın mikrofonunuza erişimi olmadığı için bir aramayı kaçırdınız. Aramaları alabilmek için buraya dokunun ve gerekli izinleri verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не змогли відповісти на виклик через відсутність у %@ доступу до мікрофона. Торкніться тут та надайте необхідні доступи для отримання викликів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您错过了一个来电，因为 %@ 没有访问您麦克风的权限。点击这里并授予必要的权限以接听来电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您錯過了一個來電，因為 %@ 沒有存取麥克風的權限。按一下這裡並授予必要的權限以接聽來電。"
          }
        }
      }
    },
