        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit herstelt alle achtergronden die specifiek voor een chat zijn ingesteld naar de hierboven geselecteerde optie. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetuje wszystkie tapety, które były ustawione dla czatu w opcji powyżej. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefine todos os papéis de parede que foram definidos especificadamente para uma conversa com a opção selecionada acima. Não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сброс всех обоев, специально установленных в чате, до выбранного выше варианта. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetujte všetky tapety, ktoré boli nastavené špecificky pre konverzáciu na možnosť vybranú vyššie. Tento krok nemožno odvolať."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel bir sohbet için ayarlanmış tüm duvar kağıtlarını yukarıda seçilen seçeneğe sıfırlar. Geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скидає всі шпалери, які було встановлено для діалогу, до вищезазначеного параметра. Цю дію скасувати не можна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将特定会话所设置的壁纸全部重置为上面选择的选项，一经选择后将无法撤消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將特定對話所設定的背景圖片全部重設為上面選擇的選項，一經選擇後將無法復原。"
          }
        }
      }
    },
