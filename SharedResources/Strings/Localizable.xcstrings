        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Има %@ файлове (%@) в кошчето. Ако не липсват (мултимедийни) файлове в %@, изпразнете кошчето, за окончателното изтриване на ненужните файлове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V koši je %@ souborů (%@). Pokud vám v %@ nechybí žádné (mediální) soubory, vyprázdněte koš, abyste trvale odstranili osiřelé soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es befinden sich %@ Dateien (%@) im Papierkorb. Sofern keine Medien und/oder Dateien in %@ fehlen, leeren Sie den Papierkorb, um die verwaisten Dateien endgültig zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %@ files (%@) in the trash bin. If there are no (media) files missing in %@, empty the trash bin to permanently delete the orphaned files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay %@ archivos (%@) en la papelera de reciclaje. Si no faltan archivos (multimedia) en %@, vacíe la papelera de reciclaje para eliminar permanentemente los archivos huérfanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a des fichiers %@ (%@) dans la corbeille. S’il ne manque aucun fichier (média) dans %@, videz la corbeille pour supprimer définitivement les fichiers orphelins."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es befindet sich %@ Dateie (%@) im Papierchorb. Wenn kei Medie und/oder Dateie in %@ fehled, leered Sie de Papierchorb, zum die verwaiste Dateie endgültig z’lösche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel cestino sono presenti %@ file (%@). Se non mancano media e/o file in %@, svuota il cestino per cancellare definitivamente tutti i file abbandonati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱の中に%@個のファイル (%@) があります。 %@で不足している（メディア）ファイルがない場合は、ゴミ箱を空にして、孤立したファイルを永久に削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통에는 %@ 개의 파일 (%@)이 있습니다. %@에서 누락된 (미디어) 파일이 없다면 휴지통을 비우어 고아 파일을 영구적으로 삭제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De prullenbak bevat %@ bestanden (%@). Als er geen (media)bestanden in %@ ontbreken, maak de prullenbak dan leeg om de zwevende bestanden permanent te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W koszu jest %@ plików (%@). Jeśli w %@ nie brakuje żadnych plików (multimedialnych), opróżnij kosz, aby trwale usunąć osierocone pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há %@ arquivos (%@) na lixeira. Caso não haja nenhum arquivo (de mídia) faltando no %@, esvazie a lixeira para excluir os arquivos órfãos de forma permanente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В корзине %@ файлов (%@). Если в %@ нет недостающих мультимедийных файлов, очистите корзину, чтобы окончательно удалить потерянные файлы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V koši je %@ súborov (%@). Pokiaľ vám v %@ nechýbajú žiadne (mediálne) súbory, vyprázdnite kôš, aby ste natrvalo odstránili tieto osamotené súbory."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp kutusunda %@ dosya (%@) var. %@ içinde eksik (medya) dosyası yoksa, artık dosyaları kalıcı olarak silmek için çöp kutusunu boşaltın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У смітнику %@ файлів (%@). Якщо у %@ не залишилось загублених (медіа) файлів, очистить смітник для остаточного видалення загублених файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垃圾桶中有%@个文件（%@）。 如果 %@ 中没有缺少（媒体）文件，请清空垃圾桶以永久删除孤立文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垃圾桶中有%@個檔案（%@）。 如果 %@ 中沒有缺少（媒體）檔案，請清空垃圾桶以永久刪除孤兒檔案。"
          }
        }
      }
    },
