    "testflight_feedback_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомете ни, ако се сблъскате с бъгове или нередности. Натиснете тук, за да отворите бета-чата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejte nám vědět, pokud narazíte na jakékoliv chyby nebo nesrovnalosti. Klepnutím sem otevřete beta konverzaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie uns wissen, wenn Sie auf Bugs oder Unregelmässigkeiten stossen. Tippen Sie hier, um den Beta-Chat zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let us know if you encounter any bugs or irregularities. Tap here to open the beta chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avísenos si encuentra algún error o irregularidad. Toque aquí para abrir el chat de la versión beta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez nous informer si vous rencontrez des bugs ou des anomalies. Touchez ici pour ouvrir la discussion liée à la bêta."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mälded Sie’s üs, wenn Sie Bugs oder Unregelmässigkeite finded. Tipped Sie da druf, zum de Beta-Chat z’öffne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facci sapere se riscontri bug o irregolarità. Tocca qui per aprire la chat beta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグや不具合が発生したら、お知らせください。こちらをタップしてベータ版トークを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버그나 비정상적인 사항이 발견되면 알려주세요. 베타 채팅을 열려면 여기를 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het ons weten als u bugs of afwijkingen tegenkomt. Tik hier om de bèta-chat te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj nam znać, jeżeli napotkasz jakieś błędy lub nieprawidłowości. Stuknij tutaj, aby otworzyć czat wersji beta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise a gente se encontrar erros ou irregularidades. Toque aqui para abrir o chat do beta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте нам знать, если обнаружите какие-то ошибки или аномалии. Нажмите здесь, чтобы открыть чат бета-версии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajte nám vedieť, ak narazíte na nejaké chyby alebo nezrovnalosti. Ťuknutím sem otvorte konverzáciu s beta verziou."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir hata veya düzensizlikle karşılaşırsanız bize bildirin. Beta sohbetini açmak için buraya dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомте нас, якщо трапляться помилки або щось нетипове. Торкніться для відкриття діалогу з підтримкою бета-версії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您遇到任何错误或异常情况，请向我们反馈。点击这里打开测试版聊天窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您遇到任何錯誤或異常情況，請向我們提供意見回饋。 按一下這裡開啟測試版對話方塊。"
          }
        }
      }
    },
