    "rs_view_locked_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът Ви до това приложение е блокиран от Вашия администратор. Моля, свържете се с администратора за повече информация."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k této aplikaci byl zablokován vaším správcem. Pro více informací prosím kontaktujte svého správce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die App wurde von Ihrem Administrator gesperrt. Bitte wenden Sie sich an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to this app has been blocked by your administrator. Please contact your administrator for more information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su administrador ha bloqueado el acceso a esta aplicación. Póngase en contacto con su administrador para obtener más información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à cette application a été bloqué par votre administrateur. Contactez-le pour plus d'informations."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Zuegriff uf die App isch vo Ihrem Administrator gsperrt worde. Bitte wändet Sie sich a Ihre Administrator für meh Informatione."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso a questa app è stato bloccato dal tuo amministratore. Per ulteriori informazioni, contatta il tuo amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリへのアクセスは管理者によってブロックされています。詳しくは管理者に連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱에 대한 접근이 관리자에 의해 차단되었습니다. 자세한 내용은 관리자에게 문의하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegang tot deze app is geblokkeerd door uw beheerder. Neem contact op met uw beheerder voor meer informatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator zablokował dostęp do tej aplikacji. Aby uzyskać więcej informacji, skontaktuj się z tą osobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acessso ao aplicativo bloqueado pelo administrador. Entre em contato com o administrador para mais informações."
          }
        },
        "sk" : {
          "stringUnit" : {
