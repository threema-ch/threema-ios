        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It seems that there are issues with connecting to the device. Please restart the app on the new device and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que hay problemas con la conexión al dispositivo. Reinicie la app en el nuevo dispositivo e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble qu'il y ait des difficultés de connexion à l'appareil. Veuillez redémarrer l'application sur le nouvel appareil et réessayer."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Verbindig zum neue Grät schiint nöd korrekt z’funktioniere. Bitte started Sie d’App ufem neue Grät neu, und versueched Sie’s nomal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che si sia verificato un problema di connessione con il dispositivo. Riavvia l'app sul nuovo dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末への接続に問題があるようです。新しい端末でアプリを再起動して再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치에 연결하는 데 문제가 있는 것 같습니다. 새로운 장치에서 앱을 다시 시작하고 다시 시도해보십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo te zien is er een probleem met het koppelen van het apparaat. Herstart de app op het nieuwe apparaat en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że wystąpiły problemy przy łączeniu z urządzeniem. Uruchom ponownie aplikację na nowym urządzeniu i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece haver problemas na conexão com o dispositivo. Reinicie o app no novo dispositivo e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, при подключении к устройству возникли проблемы. Перезапустите приложение на новом устройстве и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzerá to, že sú problémy s pripojením k zariadeniu. Reštartujte prosím na novom zariadení aplikáciu a skúste to znova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünüşe göre cihaza bağlanmayla ilgili sorunlar var. Lütfen uygulamayı yeni cihazda yeniden başlatın ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схоже, виникли проблеми з пристроєм, який під’єднується. Перезапустіть застосунок на новому пристрої та повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接设备时似乎存在问题。请在新设备上重新启动此应用程序，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連結裝置時似乎存在問題。請在新裝置上重新啟動此應用程式，然後再試一次。"
          }
        }
      }
    },
