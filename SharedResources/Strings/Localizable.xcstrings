    "multi_device_linked_devices_removed_devices_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще премахне всичките свързани устройства и ще деактивира опцията за множество устройства"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto odeberete všechna připojená zařízení a zakážete více zařízení"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle verbundenen Geräte entfernt, und Multi-Device wird deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all the connected devices and disable multi-device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los dispositivos conectados y se desactivará multidispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera tous les appareils connectés et désactivera l’aperçu multi-appareils."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demit werded all verbundene Grät entfernt, und Multi-Device wird deaktiviert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questo modo eliminerai tutti i dispositivi connessi e disattiverai il multi-dispositivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、接続されているすべての端末が削除され、複数端末が無効となります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이로 인해 모든 연결된 기기가 제거되고 다중 기기가 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zorgt ervoor dat alle gekoppelde apparaten worden verwijderd en multi-device wordt uitgeschakeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunie to wszystkie połączone urządzenia i wyłączy opcję połączonych urządzeń"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opção removerá todos os dispositivos conectados e desativará a opção de multidispositivos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все подключенные устройства, а также отключен режим нескольких устройств"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa odstránia všetky pripojené zariadenia a deaktivuje sa možnosť viacerých zariadení"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem bağlı tüm cihazları kaldırır ve çoklu cihazı devre dışı bırakır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить всі приєднані пристрої та вимкне режим кількох пристроїв"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
