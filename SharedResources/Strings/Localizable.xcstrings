    "webrtc_diagnostics.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стартирайте този инструмент за дебъг на проблемите чрез настройването на обаждане. Натиснете „старт“ бутона за да започнете теста."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spusťte tento nástroj pro odhalení problémů s nastavením hlasového volání.\nStiskem tlačítka „Spustit“ zahájíte test."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie dieses Tool, um Probleme mit dem Anruf-Verbindungsaufbau zu diagnostizieren.\nDrücken Sie den «Start» Button um den Test zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start this tool to debug problems with setting up a voice call connection.\nPress the Start button to start the test."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie esta herramienta para depurar problemas al establecer una conexión de llamada de voz.\nPulse el botón Iniciar para comenzar la prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez cet outil pour débugger les problèmes en configurant une connexion vocale.\nAppuyer sur le bouton « Commencer » pour commencer le test."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Started Sie das Tool, zum Problem mit em Aruef-Verbindigsufbau z’diagnostiziere.\nDrucked Sie de «Start»-Chnopf, zum de Test z’starte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia questo strumento per diagnosticare problemi nella configurazione di una chiamata vocale.\nPremi il pulsante Avvia per iniziare il test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このツールを実行して、通話接続の問題を診断します。\n\"開始\"ボタンを押すと、テストを開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 도구를 실행하여 음성 통화 연결 문제를 진단합니다.\n테스트를 시작하려면 \"시작\" 버튼을 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start deze tool om problemen op te sporen met het opzetten van een spraakverbinding.\nDruk op de knop “Start” om de test te starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom narzędzie, aby debugować problemy z konfiguracją połączenia głosowego.\nNaciśnij przycisk Uruchom, aby rozpocząć test."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie esta ferramenta para depurar problemas de ajuste de chamadas de voz.\nPressione o botão \"Iniciar\" para começar o teste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите это средство устранения неполадок с соединением для голосовой связи.\nЧтобы начать проверку, нажмите кнопку «Старт»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustením tohoto nástroja vám umožní hľadať zdroj problémov s nastavením spojenia hlasového hovoru.\nStlačením tlačidla “Štart” zahájite test."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli arama yapmakla ilgili sorunları ayıklamak için bu aracı başlatın.\nTesti başlatmak için \"Başlat\" düğmesine basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустіть цей засіб, щоб усунути проблеми зі з’єднанням для голосового зв’язку.\nЩоб почати перевірку, натисність кнопку “Почати”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动此工具以调试与设置语音通话连接有关的问题。\n按 “开始” 按钮开始测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用此工具以偵錯與設定語音通話連接有關的問題。\n按「開始」按鈕開始測試。"
          }
        }
      }
    },
    "webrtc_diagnostics.done" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово. Ако имате проблем със започването на разговора, изпратете този резултат към екипа по поддръжка на %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotovo. Vyskytnou-li se problémy s navázáním hovoru, pošlete tento výstup podpoře %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig. Wenn Sie von Problemen mit dem Anruf-Verbindungsaufbau betroffen sind, senden Sie bitte diesen Output an den %@-Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
