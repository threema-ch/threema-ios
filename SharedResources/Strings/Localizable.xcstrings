        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede usar el servidor de %@ o especificar un servidor de copias de seguridad externo en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
