    "settings_privacy_poi_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако е активна тази функция, точките на интерес около Вас ще се показват, когато споделяте Вашето местоположение. За тази цел, Вашето местоположение ще се изпраща към сървъра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je možnost povolena, a budete sdílet polohu, budou zobrazeny body zájmu ve vašem okolí. Pro tento účel bude vaše poloha odeslána na server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden beim Teilen des Standorts öffentliche Orte («Points of Interest») in Ihrer Nähe angezeigt. Dazu wird Ihr Standort an den Server übermittelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If turned on, points of interest near you are displayed when you share your location. For this purpose, your location is sent to the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los puntos de interés cercanos a usted se mostrarán cuando comparta su ubicación. Para este propósito, su ubicación se envía al servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activée, les points d'intérêt à proximité seront affichés lorsque vous partagez votre position. À cet effet, votre position est envoyée au serveur."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werded bim Teile vom Standort öffentlichi Ort («Points of Interest») i Ihrere Nöchi aazeigt. Für das wird Ihre Standort an Server übermittled."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivata, quando condividi la tua posizione vengono visualizzati luoghi pubblici (\"punti di interesse\") nelle vicinanze. A tal fine, la tua posizione viene trasmessa al server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、位置情報を共有するときに近くの興味のあるポイントが表示されます。このため、位置情報がサーバーに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있을 경우, 위치를 공유할 때 근처의 관심 지점들이 표시됩니다. 이를 위해 귀하의 위치 정보가 서버로 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als deze functie ingeschakeld is, worden nuttige plaatsen in uw omgeving weergegeven wanneer u uw locatie deelt. Voor dit doel wordt uw locatie naar de server verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli włączone, punkty zainteresowania w pobliżu są wyświetlane, gdy udostępniasz swoją lokalizację. W tym celu Twoja lokalizacja jest wysyłana na serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, pontos de interesse próximos a você serão exibidos quando você compartilhar sua localização. Para esse fim, sua localização é enviada ao servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, когда вы делитесь своим местоположением, рядом с вами отображаются точки интереса. Для этой цели ваше местоположение отправляется на сервер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, pri zdieľaní polohy sa zobrazia body záujmu vo vašej blízkosti. Na tento účel sa vaša poloha odošle na server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıksa, konumunuzu paylaştığınızda yakınınızdaki ilgi çekici noktalar görüntülenir. Bu amaçla konumunuz sunucuya gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, то за умови поширення місцеперебування можна побачити цікаві точки біля вас. З цією метою дані про місцеперебування надсилаються до серверу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果打开此功能，在分享位置时会显示附近的POI。您的位置会被发送到我们的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果開啟此功能，在分享位置時會顯示附近的POI。您的位置會被傳送至我們的伺服器。"
          }
        }
      }
    },
