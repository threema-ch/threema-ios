    "automatic_delete_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте автоматичното изтриване на съобщения и мултимедия, за да освободите хранилището. Отворените анкети, съобщенията със звезда и съдържанието на бележките в групата няма да бъдат изтрити автоматично."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolňujte si místo na disku pomocí automatického odstraňování zpráv a médií. Otevřené ankety, zprávy s hvězdičkou a obsah skupin pro poznámky jsou z automatického odstraňování vyloučeny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie fest, nach welchem Zeitraum Nachrichten und Medien gelöscht werden sollen, um Speicherplatz freizugeben. Offene Umfragen, mit Stern markierte Nachrichten und Inhalte von Notizgruppen sind von dieser Option ausgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the automatic deletion of messages and media to free up disk space. Open polls, starred messages, and the content of note groups are excluded from automatic deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza la eliminación automática de mensajes y medios para liberar espacio en disco. Las encuestas abiertas, los mensajes destacados y el contenido de los grupos de notas quedan excluidos de la eliminación automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la suppression automatique des messages et des médias pour libérer de l'espace disque. Les sondages ouverts, les messages étoilés et le contenu des groupes de notes sont exclus de la suppression automatique."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legged Sie fest, nach welem Ziitruum Nachrichte und Medie glöscht werde sölled, zum Speicherplatz freizgeh. Offeni Umfrage, Stärndli-Nachrichte und Inhalt vo Notizgruppe sind vo dere Option usgnoh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per liberare la memoria stabilisci dopo quale periodo di tempo i messaggi e i media devono essere cancellati. I sondaggi aperti, i messaggi contrassegnati con asterisco e i contenuti di gruppi di note sono esclusi da questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージとメディアの自動削除を使用してディスクスペースを解放してください。開かれている投票、スター付きメッセージ、およびノートグループの内容は自動削除の対象外です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 및 미디어의 자동 삭제 기능을 사용하여 디스크 공간을 확보하세요. 자동 삭제에서 제외되는 항목은 투표, 별표 메시지, 노트 그룹의 내용입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de automatische verwijdering van berichten en media om ruimte vrij te maken op de schijf. Lopende opiniepeilingen, gemarkeerde berichten en de inhoud van notitiegroepen zijn uitgesloten van automatische verwijdering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj automatycznego usuwania wiadomości i multimediów, aby zwolnić miejsce na dysku. Otwarte ankiety, oznaczone gwiazdką wiadomości oraz zawartość grup notatek są wyłączone z automatycznego usuwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a exclusão automática de mensagens e mídia para liberar espaço em disco. Enquetes abertas, mensagens com estrela e o conteúdo de grupos de anotações não fazem parte da exclusão automática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте автоматическое удаление сообщений и мультимедиа для освобождения места на диске. Открытые опросы, избранные сообщения и содержимое групп заметок исключаются из автоматического удаления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na uvoľnenie miesta na disku použite automatické odstraňovanie správ a médií. Z automatického vymazávania sú vylúčené správy o otvorenom hlasovaní, správy s hviezdičkou a obsah skupinových poznámok."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk alanını boşaltmak için mesajların ve medyanın otomatik olarak silinmesini kullan. Açık anketler, yıldızlı mesajlar ve not gruplarının içeriği otomatik silme işleminin dışında tutulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте автоматичне видалення повідомлень та медіафайлів, щоб звільнити місце на диску. Відкриті опитування, позначені повідомлення та вміст груп нотаток не підлягають автоматичному видаленню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自动删除信息和媒体功能可以释放磁盘空间。公开投票、已加星标的消息和私人收藏在备忘录 “一人群组” 内的消息不会被自动删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自動刪除訊息和多媒體功能可以釋放磁碟空間。公開投票、已加星號的訊息和私人收藏在備忘錄「一人群組」內的訊息不會自動刪除。"
          }
        }
      }
    },
