    "work_referral_view_section_info_referral_text" : {
      "comment" : "Description of how to refer a friend.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поканете приятел или неговата компания да се присъедини към Threema Work. Важно е Вашият Threema идентификатор да бъде посочен при регистрацията или при закупуването на лицензи, за да бъде отчетена препоръката Ви."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzvěte přítele nebo jeho společnost, aby začal používat Threema Work. Je důležité, aby bylo vaše Threema ID poskytnuto během registrace, nebo při nákupu licencí, aby vaše doporučení mohlo být uplatněno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie einen Freund bzw. dessen Unternehmen zu Threema Work ein. Wichtig ist, dass Ihre Threema-ID bei der Registrierung oder beim Kauf von Lizenzen angegeben wird, damit Ihre Empfehlung berücksichtigt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a friend or their company to join Threema Work. It is important that your Threema ID is provided during registration or when purchasing licenses so that your referral can be taken into account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a un amigo o a su empresa a unirse a Threema Work. Es importante que facilite su ID de Threema durante el registro o al comprar licencias para que se tenga en cuenta su recomendación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez un ami ou son entreprise à rejoindre Threema Work. Il est important que votre ami indique votre identifiant Threema lors de son inscription ou lors de l'achat de licences pour votre parrainage soit pris en compte."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laded Sie en Fründ bzw. dem sini Firma zu Threema Work ii. Wichtig isch, dass Ihri Threema-ID bi de Registrierig oder bim Chauf vo Lizänze aageh wird, damit Ihri Empfehlig cha berücksichtigt werde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita un amico o la sua azienda a registrarsi su Threema Work. È importante fornire il tuo ID Threema durante la registrazione o l'acquisto delle licenze affinché il soggetto presentato possa essere preso in considerazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구 또는 친구의 회사가 Threema Work에 참여하도록 초대하세요. 추천이 인정되려면 등록 시 또는 라이선스 구매 시 추천인의 Threema ID를 반드시 제공해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig een vriend of zijn/haar bedrijf uit om zich aan te sluiten bij Threema Work. Het is belangrijk dat uw Threema ID wordt verstrekt tijdens het registreren of kopen van licenties zodat er rekening met uw doorverwijzing kan worden gehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachęć znajomego lub jego firmę do dołączenia do Threema Work. Ważne jest podanie Twojego identyfikatora Threema podczas rejestracji lub w trakcie kupowania licencji — pozwoli nam to uwzględnić Twoje polecenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide um amigo ou sua empresa para se juntar ao Threema Work. É importante informar o seu ID do Threema ao se cadastrar ou ao adquirir licenças para que sua indicação seja considerada."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvite priateľa alebo jeho spoločnosť, aby sa pripojili k Threema Work. Je dôležité, aby pri registrácii alebo pri nákupe licencií bolo uvedené vaše Threema ID, aby sa mohlo zohľadniť vaše odporúčanie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arkadaşınızı veya şirketini Threema Work'e katılmaya davet edin. Referansınızın dikkate alınabilmesi için kayıt sırasında veya lisans satın alırken Threema kimliğinizi belirtmeniz önemlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порекомендуйте друзям або їхній компанії приєднатися до Threema Work. Щоб рекомендацію було зараховано, обов'язково попросіть їх указати ваш ID Threema під час реєстрації або придбання ліцензій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请好友或其公司加入 Threema Work。请注意：在注册或购买许可证时必须提供您的 Threema ID，以便我们计算您的推荐奖励。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀請好友或其公司加入 Threema Work。請注意：在註冊或購買授權時必須提供您的 Threema ID，以便我們計算您的推薦獎勵。"
          }
        }
      }
    },
