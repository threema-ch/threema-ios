    "voteCancelMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако напуснете преди да подадете Вашия глас, то той ще бъде отхвърлен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud před odesláním hlasu odejdete, bude zahozen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Stimme wird verworfen und nicht versendet. Wählen Sie «Abstimmen», um Ihre Stimme abzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you leave before casting your vote, it will be discarded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales antes de emitir tu voto, se descartará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous partez avant de voter, votre vote sera ignoré."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihri Stimm wird verworfe und nöd abgschickt. Wähled Sie «Abstimme», zum Ihri Stimm abzgeh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo voto sarà eliminato e non verrà inoltrato. Scegli «vota» per dare il tuo voto. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票前に退出された場合は放棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투표하기 전에 나가면 투표가 폐기됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u vertrekt voordat u hebt gestemd, gaat uw stem verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wyjdziesz przed oddaniem głosu, zostanie on odrzucony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você sair antes de dar o seu voto, ele será descartado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выйти до подачи голоса, голос не будет учтен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokiaľ odídete pred odoslaním hlasu, bude zahodený."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunuzu kullanmadan önce ayrılırsanız, geçersiz sayılacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви покинете опитування не проголосувавши, вашу відповідь не буде зараховано."
          }
        },
        "zh-Hans" : {
