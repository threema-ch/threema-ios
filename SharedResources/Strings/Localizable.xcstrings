    "flavorinfo_businessappviewmodel_onprem_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem е самостоятелно приложение за комуникация, което е предназначено за фирми, държавни институции и военни организации. Предназначено е за пълна автономност на данните, криптирано изпращане на данни и да покрива изискванията за сигурност при боравене с чувствителни данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem je self-hosted řešení komunikace pro podniky, vládní agentury a vojenské organizace. Nabízí kompletní datovou suverenitu, přenos dat v zašifrované podobě a splňuje vysoké požadavky na bezpečnostně citlivá prostředí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem ist die selbstgehostete Kommunikationslösung für Unternehmen, Behörden und militärische Einrichtungen – für vollständige Datensouveränität, verschlüsselte Datenübertragung und die hohen Anforderungen sicherheitsrelevanter Bereiche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem is the self-hosted communication solution for enterprises, government agencies, and military organizations – for full data sovereignty, encrypted data transmission, and the high requirements of security-sensitive environments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem es la solución de comunicación autohospedada para empresas, organismos gubernamentales y organizaciones militares, que ofrece soberanía total de los datos, transmisión de datos cifrada y satisface los estrictos requisitos de los entornos sensibles a la seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem est la solution de communication auto-hébergée pour les entreprises, les agences gouvernementales et les organisations militaires, qui offre un contrôle total sur les données, une transmission chiffrée des informations et une conformité aux exigences les plus stricts en matière de sécurisation des données sensibles."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem isch di sälberghostet Kommunikationslösig für Undernehme, Behörde und militärischi Irichtige – für vollständigi Datesouveränität, verschlüssleti Dateüberträgig und di höche Aaforderige vo sicherheitsrelevante Bereich."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem è la soluzione di comunicazione self-hosted per aziende, enti pubblici e organizzazioni militari, per garantire piena sovranità dei dati, trasmissione cifrata e soddisfare gli elevati requisiti degli ambienti sensibili alla sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem は、完全なデータ主権、暗号化されたデータ転送、セキュリティが重視される環境の高い要件を満たす、企業、政府機関、軍事組織向けのセルフホスト型通信ソリューションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem은 기업, 정부 기관, 군 조직을 위한 자체 호스팅 커뮤니케이션 솔루션입니다. 완벽한 데이터 주권, 암호화된 데이터 전송, 보안이 중요한 환경을 위한 최고 수준의 요구사항을 충족합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem is de zelf-gehoste communicatieoplossing voor bedrijven, overheidsinstanties en militaire organisaties – voor volledige gegevenssoevereiniteit, versleutelde gegevensoverdracht en de hoge eisen van beveiligingsgevoelige omgevingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem to rozwiązanie komunikacyjne dla agencji rządowych, organizacji wojskowych i przedsiębiorstw, w przypadku którego zastosowano samodzielny hosting – zapewnia pełną suwerenność danych oraz szyfrowany przesył informacji, a także spełnia wysokie wymogi środowisk wrażliwych pod względem bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem é a solução de comunicação auto-hospedada para empresas, órgãos governamentais e organizações militares, para a total soberania de dados, transmissão de dados criptografados e os altos requisitos de ambientes sensíveis à segurança."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem je komunikačné riešenie s vlastným hosťovaním pre podniky, vládne agentúry a vojenské organizácie – pre úplnú suverenitu údajov, šifrovaný prenos údajov a vysoké požiadavky na prostredia citlivé na bezpečnosť."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem, işletmeler, devlet kurumları ve askeri organizasyonlar için tam veri egemenliği, şifreli veri iletimi ve güvenliğe duyarlı ortamların yüksek gereksinimleri için kendi kendine barındırılan iletişim çözümüdür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem — це рішення для самостійного хостингу комунікацій, призначене для підприємств, урядових установ і військових організацій. Воно забезпечує повний суверенітет даних, зашифровану передачу даних та відповідає високим вимогам безпеконебезпечних середовищ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem 是专为企业、政府机构及军事组织设计的自托管通信解决方案 — 可完全保护数据主权、加密数据传输，并满足安全敏感环境的高要求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threema OnPrem 是專為企業、政府機關及軍事組織所設計的自託管通訊解決方案 — 可完全保護資料主權、加密資料傳輸，並滿足安全敏感環境的高要求。"
          }
        }
      }
    },
