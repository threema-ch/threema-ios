    "emoji_reaction_tipkit_description" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натиснете и задръжте на реакции, за да видите кой ги е изпратил."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li se podívat, kdo poslal reakce, dlouze na ně klepněte."
