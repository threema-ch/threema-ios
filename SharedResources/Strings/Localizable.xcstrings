          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahoj, napadlo ma, že by sa ti to mohlo hodiť: Threema Work je skvelá voľba pre bezpečnú firemnú komunikáciu. Tu je tvoj testovací odkaz:"
