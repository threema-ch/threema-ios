    "send_as_file_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изпратете файл без промени от оригиналния файл. Файловете ще си запазят всички метаданни, като местоположение на снимките и т.н."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odeslat soubory beze změn. Soubory si zachovají všechna metadata, např. údaje o poloze fotografií i čas pořízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird ohne Änderungen versendet. Dateien können Metadaten enthalten, z.B. den Aufnahme-Standort bei Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send file without any changes to the original file. Files will retain all metadata, e.g., location data of photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía el archivo sin cambios en el original. Los archivos conservarán todos los metadatos, por ejemplo, los datos de ubicación de las fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un fichier sans apporter des modifications au fichier d’origine. Les fichiers conserveront toutes les métadonnées, telles que les données de localisation des photos."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’Datei wird ohni Änderige verschickt. Dateie chönd Metadate enthalte, z.B. de Ufnahme-Standort bi Fotis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file media possono essere inviati sia come file media sia come file. Nella chat i file media vengono visualizzati più grandi. I file invece vengono visualizzati più piccoli e contengono tutti i metadati, come ad esempio la posizione durante la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルに変更を加えずに、ファイルを送信します。ファイルは、写真の位置情報などのメタデータをすべて保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 파일에 어떠한 변경도 가하지 않고 파일을 보내십시오. 파일은 모든 메타데이터, 예를 들어 사진의 위치 데이터를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuur bestanden zonder de bronbestanden te wijzigen. Bestanden behouden alle metagegevens zoals bijvoorbeeld locatiegegevens van foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyślij plik bez żadnych zmian w oryginalnym pliku. Pliki zachowają wszystkie metadane, np. dane lokalizacyjne, zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie o arquivo sem alterações ao arquivo original. Os arquivos manterão todos os metadados, como dados de localização em fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте файлы без изменений в оригинале. Файлы сохранят все метаданные, такие как данные о месте съемки фото."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odoslať súbory bez zmien. Súbory si zachovajú všetky metadata, ako napr. údaje o polohe fotografie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosyada herhangi bir değişiklik yapmadan dosyayı gönder. Dosyalar, tüm meta verileri, örneğin fotoğrafların konum verilerini koruyacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслати файл без змін. Файли міститимуть усі метадані, як-от дані геолокації фотографії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送文件时，不对原始文件进行任何更改。文件将保留所有元数据，例如照片的位置数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送檔案時，不對原始檔案進行任何變更。檔案將保留所有元資料，例如照片的位置資料。"
          }
        }
      }
    },
