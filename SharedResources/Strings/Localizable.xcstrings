    "ballot_alert_delete_own_open_poll_title" : {
      "comment" : "Title of an alert that appears when the user tries to delete their own open ballot.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анкетата трябва да се затвори преди да може да се изтрие."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anketa musí být před odstraněním uzavřena."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Umfrage muss geschlossen werden bevor diese gelöscht werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The poll must be closed before it can be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La encuesta debe cerrarse antes de poder eliminarla."
          }
        },
        "fr" : {
