    "show_stale_contacts_on" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивните %@ идентификатори (тези, които не използвани от поне три месеца) и невалидните са скрити."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivní %@ ID (tj. ID, která nebyla použita alespoň tři měsíce) a zrušená ID jsou skrytá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive %@-IDs (d.h. solche, die während mehr als drei Monaten nicht in Gebrauch waren) und widerrufene IDs werden ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive %@ IDs (i.e., IDs that have not been in use for at least three months) and revoked IDs are hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ID de %@ inactivos (los que no han sido utilizados durante al menos tres meses) y los revovados están ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ID %@ inactifs (par exemple ceux qui n’ont pas été utilisés pendant au moins trois mois) et les ID révoqués sont cachés."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktivi %@-IDs (d.h. sonigi, wo während meh als drü Mönet nüme bruucht worde sind) und widerruefeni IDs werded usbländet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I %@ ID inattivi (cioè ID che non sono stati utilizzati per almeno tre mesi) e gli ID revocati sono nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非アクティブな%@ ID（3ヶ月以上使用されていないID）や失効したIDは非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비활성 %@ ID(즉, 적어도 세 달 동안 사용되지 않은 ID) 및 철회된 ID는 숨겨져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactieve %@ ID’s (d.w.z. ID’s die al meer dan 3 maanden niet zijn gebruikt) en ingetrokken ID’s worden verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieaktywne %@ IDs (tj. Identyfikatory, które nie były używane przez co najmniej trzy miesiące) i unieważnione są ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As IDs inativas do %@ (por exemplo, IDs que não foram usadas por, pelo menos, 3 meses) e as IDs revogadas estão ocultas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недействительные %@ ID и ID, которые были неактивны больше 3 месяцев в данный момент скрыты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktívne %@ ID (t.j. ID, ktoré neboli používané aspoň tri mesiace) a zrušené ID sú skryté."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin olmayan %@ kimlikleri (örneğin, en az üç aydır kullanılmayan kimlikler) ve iptal edilen kimlikler gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивні %@ ID (тобто такі, що не використовувались протягом щонайменше трьох місяців) та видалені ID приховано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不活跃的 %@ ID（即至少三个月没有使用的ID）和被撤销的ID都会被隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非活躍的 %@ ID（即至少三個月沒有使用的ID）和被撤銷的ID都會被隱藏。"
          }
        }
      }
    },
