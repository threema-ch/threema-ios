    "multi_device_join_linked_successfully_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ приложението вече може да бъде използвано на току-що свързаното устройство (дори когато това iOS устройство е изключено или не е свързано с интернет)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nyní můžete používat na právě propojeném zařízení (a to i v případě, není-li toto iOS zařízení zapnuté nebo připojené k internetu)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nun auf dem soeben verknüpften Gerät verwendet werden (auch wenn Ihr iOS-Gerät ausgeschaltet ist oder keine Internetverbindung hat)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can now be used on the device you just linked (even when this iOS device is turned off or isn’t connected to the Internet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya puede utilizarse en el dispositivo que acaba de vincular (incluso cuando este dispositivo iOS está apagado o no está conectado a Internet)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut maintenant être utilisé sur l'appareil que vous venez d'associer (même lorsque cet appareil iOS est éteint ou qu'il n'est pas connecté à Internet)."
          }
        },
        "gsw-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cha jetzt ufem neu verchnüpfte Grät bruucht werde (au wenn Ihres iOS-Grät usgschalte isch oder kei Internetverbindig hät)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora %@ può essere usato sul dispositivo che hai collegato (anche quando questo dispositivo iOS è disattivato oppure non è connesso a Internet)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が紐付けした端末で使用できるようになりました。（iOSデバイスの電源がオフになっていたり、インターネットに接続されていない場合でも）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 방금 연결한 장치에서 %@을(를) 사용할 수 있습니다. (이 iOS 장치가 꺼져 있거나 인터넷에 연결되어 있지 않을 때도 가능합니다)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan nu op het zojuist gekoppelde apparaat worden gebruikt (zelfs wanneer dit iOS-apparaat is uitgeschakeld of het niet met het internet verbonden is)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz teraz używać %@ na właśnie połączonym urządzeniu (nawet gdy to urządzenie iOS zostało wyłączone lub nie jest połączone z Internetem)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você pode usar %@ no dispositivo que acabou de vincular (mesmo quando este dispositivo iOS estiver desligado ou não estiver conectado à internet.)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь вы можете использовать приложение %@ на устройстве, которое вы сейчас привязали (даже если устройство iOS выключено или не подключено к Интернету)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa môže teraz použiť na zariadení, ktoré ste práve prepojili (aj keď je toto iOS zariadenie vypnuté alebo nie je pripojené k internetu)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ artık az önce bağladığınız cihazda kullanılabilir (bu iOS cihazı kapalı veya İnternete bağlı olmasa bile)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепер можна використовувати %@ на пристрої, який ви щойно прив’язали (навіть якщо цей пристрій iOS вимкнено або не під’єднано до Інтернету)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在，您可以在你刚刚链接的设备上使用 %@（即使此 iOS 设备已关机或无互联网连接）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在，您可以在你剛剛連結的裝置上使用 %@（即使此 iOS 裝置已關機或沒有網路連線）。"
          }
        }
      }
    },
