    "edit_avatar_no_image_found_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моля, опитайте отново. Може би с друго изображение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste to prosím znovu. Možná s jiným obrázkem."
